@* Use in layouts: POST logout with anti-forgery token. Prevents GET-based logout and ensures session/auth are cleared server-side. *@
@* Optional: set ViewBag.LogoutButtonCss to override button class (e.g. "dropdown-logout text-decoration-none text-dark border-0 bg-transparent w-100 text-start p-0" for inventory layouts). *@
@{
    var logoutBtnClass = ViewBag.LogoutButtonCss ?? "dropdown-item text-danger border-0 bg-transparent w-100 text-start";
}
@using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", role = "form" }))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="@logoutBtnClass" style="cursor:pointer;">Logout</button>
}
