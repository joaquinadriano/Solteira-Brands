@{
    Layout = User.IsInRole("ADMIN") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_OperationsLayout.cshtml";
}
<div class="main-content">
    <div class="container-fluid orders-container px-1">
        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Inventory</p>
            </div>
            <div class="col d-flex justify-content-end align-items-center gap-2">
                @if (User.IsInRole("ADMIN"))
                {
                    <div class="btn-group me-2 b" role="group">
                        <button type="button"
                                class="btn btn-sm btn-showactive btn-outline-success"
                                id="btn-showactive"
                                ng-class="{'active': !showArchivedInventory}"
                                ng-click="showArchivedInventory = false; loadInventoryProducts();">
                            Show Active
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-showarchive btn-outline-secondary"
                                id="btn-showarchive"
                                ng-class="{'active': showArchivedInventory}"
                                ng-click="showArchivedInventory = true; loadInventoryProducts();">
                            Show Archived
                        </button>
                    </div>
                }
                <button type="button"
                        class="btn btn-add-order px-2 py-1"
                        data-bs-toggle="modal"
                        data-bs-target="#inventoryAddItemModal">
                    <i class="bi bi-plus plus-icon"></i> Add Item
                </button>

                @*Modal - Add Item (styled consistent with Delivery Shipments modal)*@
                <div class="modal fade" id="inventoryAddItemModal" tabindex="-1" aria-labelledby="inventoryAddItemLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content delivery-form-box shadow-lg">

                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body p-5 pt-0">
                                <h2 class="delivery-header-text mb-5" id="inventoryAddItemLabel">New Inventory Item</h2>

                                <form>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product ID: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field"
                                                   ng-value="nextProductDisplayId"
                                                   placeholder="P-001" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product Name: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="Many Shape Tennis" ng-model="newProduct.name">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Category: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <select class="form-select delivery-input-field"
                                                    ng-model="newProduct.category"
                                                    ng-options="c for c in productCategories">
                                                <option value="" disabled selected>Select category</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Selling Price: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="number" step="0.01" min="0" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="55990.00" ng-model="newProduct.price">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Stock Left: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="number" min="0" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="3" ng-model="newProduct.stockQuantity">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Stones: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="e.g., 5 Total Carat Diamond" ng-model="newProduct.stones">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Material: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="e.g., 18K White Gold" ng-model="newProduct.material">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Weight: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="e.g., 9.6 grams" ng-model="newProduct.weight">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Length: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="e.g., 18cm" ng-model="newProduct.length">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Show in Featured Products:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="addFeatured" ng-model="newProduct.isFeatured" />
                                                <label class="form-check-label" for="addFeatured">Display on homepage Featured carousel</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-4 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Photo: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="file" class="form-control delivery-input-field" accept=".jpg,.jpeg,.png" ng-class="{'is-invalid': inventoryFileValidationMessage}"
                                                   onchange="angular.element(this).scope().onInventoryFileSelected(this.files)" />
                                            <small class="text-muted">PNG or JPG, less than 5MB.</small>
                                            <p class="text-danger small mt-1 mb-0" ng-if="inventoryFileValidationMessage">{{inventoryFileValidationMessage}}</p>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end pt-2">
                                        <button type="button" class="btn delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn delivery-btn-add" ng-click="createInventoryProduct()">Add Item</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                @*Modal - Add Item end*@
            </div>
        </div>

        @* Inventory table (Angular-only; no DataTables to avoid list disappearing on archive/toggle) *@
        <div class="row px-4 pt-1 ">
            <div class="col">
                <div class="d-flex justify-content-end mb-2" ng-if="inventoryProducts.length > 0">
                    <input type="text" class="form-control form-control-sm" style="max-width: 220px;" placeholder="Search " ng-model="inventorySearchText" />
                </div>
                <div class="table-container">
                    <table class="table table-responsive" id="inventoryTable">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Category</th>
                                <th>Product Name</th>
                                <th>Product Description</th>
                                <th>Selling Price</th>
                                <th>Stock Left</th>
                                <th>Sold</th>
                                <th>Date Added</th>
                                <th>Date Updated</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr class="text-start" ng-repeat="item in inventoryProducts | filter:inventorySearchText">
                                <td id="product-id">{{item.id}}</td>
                                <td>{{item.category}}</td>
                                <td>{{item.name}}</td>
                                <td class="product-description-cell">
                                    <span class="d-block">{{item.stones || '—'}}</span>
                                    <span class="d-block">{{item.material || '—'}}</span>
                                    <span class="d-block">{{item.weight || '—'}}, {{item.length || '—'}}</span>
                                </td>
                                <td>&#8369; {{item.price | number:2}}</td>
                                <td>{{item.stockQuantity}}</td>
                                <td>{{item.sold != null ? item.sold : 0}}</td>
                                <td>{{item.createdAtString}}</td>
                                <td>{{item.updatedAtString}}</td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <div>
                                            <a class="order-action-icon" ng-click="openViewPhotoModal(item)">
                                                <img src="@Url.Content("~/Content/img/icons/view.svg")" alt="Edit" />
                                            </a>
                                            @*<button type="button" class="btn btn-sm btn-outline-secondary" id="btn-inventory-view" >View</button>*@
                                        </div>
                                        <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Item">
                                            <a class="order-action-icon" ng-click="openEditProduct(item)">
                                                <img src="@Url.Content("~/Content/img/icons/edit.svg")" alt="Edit" />
                                            </a>
                                        </div>
                                        @if (User.IsInRole("ADMIN"))
                                        {
                                            <a class="order-action-icon"
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="bottom"
                                               data-bs-title="{{showArchivedInventory ? 'Restore Item' : 'Archive Item'}}"
                                               ng-click="inventoryArchiveAlert(item)">
                                                <img src="@Url.Content("~/Content/img/icons/archive-status.svg")" alt="Archive" />
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            <tr ng-if="inventoryProducts.length === 0">
                                <td colspan="11" class="text-muted py-4 text-center">No {{ showArchivedInventory ? 'archived' : 'active' }} inventory items.</td>
                            </tr>
                            <tr ng-if="inventoryProducts.length > 0 && (inventoryProducts | filter:inventorySearchText).length === 0">
                                <td colspan="11" class="text-muted py-4 text-center">No matches for your search.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

@* View Product Modal: clean 2-column layout + Product Description (no duplicate fields, multi-line safe) *@
    <div class="modal fade product-view-modal" id="inventoryViewPhotoModal" tabindex="-1" aria-labelledby="inventoryViewPhotoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content view-prod shadow-lg" ng-if="viewPhotoItem" style="border-radius: 25px; border: none; padding: 15px;">

                <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-start">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="product-view-modal-title mb-0" id="inventoryViewPhotoLabel" style="font-weight: 800;">{{viewPhotoItem.name}}</h2>
                        @*<span class="badge rounded-pill bg-light text-muted px-3 py-2 border">{{viewPhotoItem.category}}</span>*@
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" ng-click="closeViewPhotoAndEdit()"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="product-view-grid">

                        <div class="product-image-section text-center">
                            <div class="position-relative overflow-hidden" style="border-radius: 18px;">
                                <img ng-if="viewPhotoItem.imageUrl"
                                     ng-src="{{viewPhotoItem.imageUrl}}"
                                     alt="{{viewPhotoItem.name}}"
                                     class="product-view-img product-view-img-enlarge"
                                     ng-click="viewPhotoItem.imageUrl && openImagePreview(viewPhotoItem.imageUrl); $event.stopPropagation()"
                                     role="button"
                                     title="Click to enlarge" />

                                <img ng-if="!viewPhotoItem.imageUrl"
                                     src="@Url.Content("~/Content/img/shared/default-product.svg")"
                                     alt="No image"
                                     class="product-view-img" />

                               
                            </div>

                            <div ng-if="!viewPhotoItem.imageUrl" class="mt-2">
                                <a href="javascript:void(0)" class="text-primary" ng-click="closeViewPhotoAndEdit(viewPhotoItem)">Add Photo</a>
                            </div>
                        </div>

                        <div class="product-details-section">
                            <h1 class="mb-0" style="font-weight: 800; font-size: 2.5rem; ">{{formatProductPrice(viewPhotoItem.price)}}</h1>

                            <div class="row gx-2 mb-3">
                                <div class="col-6">
                                    <div class="p-3 rounded-4 d-flex justify-content-between align-items-center" style="background-color: #FFFDF1;">
                                        <small class="fw-bold text-muted" style="letter-spacing: 0.5px; font-size: 0.7rem;">STOCK LEFT</small>
                                        <span class="h5 mb-0 fw-bold">{{viewPhotoItem.stockQuantity}}</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 rounded-4 d-flex justify-content-between align-items-center" style="background-color: #FFFDF1;">
                                        <small class="fw-bold text-muted" style="letter-spacing: 0.5px; font-size: 0.7rem;">TOTAL SOLD</small>
                                        <span class="h5 mb-0 fw-bold text-success">{{viewPhotoItem.sold != null ? viewPhotoItem.sold : 0}}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="p-4 border rounded-4">
                                <div class="small text-dark">
                                    <p class="mb-1 "><strong>Product ID: </strong>#{{viewPhotoItem.id}}</p>
                                    <p class="mb-1"><strong>Category:</strong> {{viewPhotoItem.category}}</p>
                                    <p class="mb-1 fw-bold text-success btn-outline-success" ng-if="viewPhotoItem.isFeatured" style="text-shadow: 0 1px 2px rgba(0,0,0,0.1);  ">
                                        Featured
                                    </p>
                                    <p class="mb-1 text-secondary" ng-if="!viewPhotoItem.isFeatured">
                                        Not Featured
                                    </p>
                                    <p class="mb-1"><strong>Date Added:</strong> {{viewPhotoItem.createdAtString}}</p>
                                    <p class="mb-0 "><strong>Date Updated:</strong> {{viewPhotoItem.updatedAtString}}</p>
                                </div>
                               

                                <hr class="my-3 opacity-10">

                                <div class="small">
                                    <p class="fw-bold mb-1" style="font-size: 0.9rem;">Product Specifications</p>

                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted">Material</span>
                                        <span class="fw-bold text-uppercase">{{viewPhotoItem.material || '—'}}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted">Stones</span>
                                        <span class="fw-bold text-uppercase">{{viewPhotoItem.stones || '—'}}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span class="text-muted">Weight</span>
                                        <span class="fw-bold text-uppercase">{{viewPhotoItem.weight || '—'}}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-0 small">
                                        <span class="text-muted">Length</span>
                                        <span class="fw-bold text-uppercase">{{viewPhotoItem.length || '—'}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
        @* Angular-driven Edit Item Modal *@
        <div class="modal fade" id="inventoryEditItemModal" tabindex="-1" aria-labelledby="inventoryEditItemLabel" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content delivery-form-box shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-5 pt-0" ng-if="editProduct">
                        <h2 class="delivery-header-text mb-5" id="inventoryEditItemLabel">Edit Inventory Item</h2>

                        <form>
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Product ID (read-only):</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text"
                                           class="form-control delivery-input-field"
                                           ng-value="'P-' + ('000' + editProduct.id).slice(-3)"
                                           readonly />
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Product Name: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" ng-model="editProduct.name">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Category: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <select class="form-select delivery-input-field"
                                            ng-model="editProduct.category"
                                            ng-options="c for c in productCategories">
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Selling Price: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="number" step="0.01" class="form-control delivery-input-field" ng-model="editProduct.price">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Stock Left: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="number" class="form-control delivery-input-field" ng-model="editProduct.stockQuantity">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Stones: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" ng-model="editProduct.stones">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Material: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" ng-model="editProduct.material">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Weight: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" ng-model="editProduct.weight">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Length: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" ng-model="editProduct.length">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Show in Featured Products:</label>
                                </div>
                                <div class="col-sm-7">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="editFeatured" ng-model="editProduct.isFeatured" />
                                        <label class="form-check-label" for="editFeatured">Display on homepage Featured carousel</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Photo:</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="file" class="form-control delivery-input-field" accept=".jpg,.jpeg,.png" ng-class="{'is-invalid': inventoryEditFileValidationMessage}"
                                           onchange="angular.element(this).scope().onInventoryEditFileSelected(this.files)" />
                                    <small class="text-muted">PNG or JPG, less than 5MB. Leave empty to keep current.</small>
                                    <p class="text-danger small mt-1 mb-0" ng-if="inventoryEditFileValidationMessage">{{inventoryEditFileValidationMessage}}</p>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end pt-2">
                                <button type="button" class="btn delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn delivery-btn-add" ng-click="updateInventoryProduct()">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
