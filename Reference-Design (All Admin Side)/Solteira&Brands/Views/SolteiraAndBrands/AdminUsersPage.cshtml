@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="main-content">
    <div class="container-fluid  orders-container px-1">

        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0 mb-0 pb-0">Users</p>
            </div>
        </div>


        <div class="row px-4 pt-0">
            <div class="col">
                <div class="table-container-users">
                    <table class="table um-custom-table align-middle" id="usersTable" style="width:100%">

                        <thead>
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th>Verified</th>
                                <th>Joined Date</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>   
                        </thead>

                        <tbody>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="ms-3">
                                            <div class="um-full-name">Admin Test</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="um-email-sub">admin@test.local</td>
                                <td><span class="um-role-badge badge-admin">ADMIN</span></td>
                                <td>
                                    <span class="um-status-dot dot-active"></span>
                                    <span class="um-status-text">Active</span>
                                </td>
                                <td>
                                    <span class="um-verify-check">
                                        <i class="bi bi-patch-check-fill"></i> Yes
                                    </span>
                                </td>
                                <td><span class="um-date-display">Feb 16, 2026</span></td>
                                <td class="text-end pe-4">
                                    <a class="um-action-eye" href="#" data-bs-toggle="modal" data-bs-target="#viewUserModal">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="ms-3">
                                            <div class="um-full-name">Manager User</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="um-email-sub">manager@test.local</td>
                                <td><span class="um-role-badge badge-manager">MANAGER</span></td>
                                <td>
                                    <span class="um-status-dot dot-active"></span>
                                    <span class="um-status-text">Active</span>
                                </td>
                                <td>
                                    <span class="um-verify-check">
                                        <i class="bi bi-patch-check-fill"></i> Yes
                                    </span>
                                </td>
                                <td><span class="um-date-display">Feb 16, 2026</span></td>
                                <td class="text-end pe-4">
                                    <a class="um-action-eye" href="#" data-bs-toggle="modal" data-bs-target="#viewUserModal">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>


                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="ms-3">
                                            <div class="um-full-name">Staff User</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="um-email-sub">staff@test.local</td>
                                <td>
                                    <span class="um-role-badge" style="background:#e0f2fe; color:#075985;">STAFF</span>
                                </td>
                                <td>
                                    <span class="um-status-dot" style="background:#e53e3e;"></span>
                                    <span class="um-status-text">Inactive</span>
                                </td>
                                <td>
                                    <span class="um-verify-check">No</span>
                                </td>
                                <td><span class="um-date-display">Feb 15, 2026</span></td>
                                <td class="text-end pe-4">
                                    <a class="um-action-eye" href="#" data-bs-toggle="modal" data-bs-target="#viewUserModal">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="ms-3">
                                            <div class="um-full-name">Buyer User</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="um-email-sub">buyer@test.local</td>
                                <td>
                                    <span class="um-role-badge" style="background:#e2e8f0; color:#2d3748;">BUYER</span>
                                </td>
                                <td>
                                    <span class="um-status-dot dot-active"></span>
                                    <span class="um-status-text">Active</span>
                                </td>
                                <td>
                                    <span class="um-verify-check">
                                        <i class="bi bi-patch-check-fill"></i> Yes
                                    </span>
                                </td>
                                <td><span class="um-date-display">Feb 14, 2026</span></td>
                                <td class="text-end pe-4">
                                    <a class="um-action-eye" href="#" data-bs-toggle="modal" data-bs-target="#viewUserModal">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @*MODAL*@
        <div class="modal fade" id="viewUserModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">User Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-0">View details will be implemented here.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>