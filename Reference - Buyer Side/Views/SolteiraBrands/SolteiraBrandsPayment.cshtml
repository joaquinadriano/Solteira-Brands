@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/SolteiraBrandsStyle/PaymentStyle.css"/>

<div class="payment-page-container" ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">
    <div class="payment-card">
        <h2 class="payment-title">PAYMENT</h2>

        <div class="customer-info-box">
            <div class="info-details">
                <p class="cust-name">Name: {{customerName}}</p>
                <p class="cust-phoneNum">Phone Number: {{contactNumber}}</p>
                <p class="cust-address">Address: {{deliveryAddress}}</p>
            </div>
            <div class="price-display">
                <div ng-if="paymentMethod !== 'Layaway'">
                    <span>Price:</span>
                    <span class="amount">₱ {{getCheckoutSubtotal() | number:2}}</span>
                </div>
                <div ng-if="paymentMethod === 'Layaway'" class="layaway-price-grid">
                    <p><strong>Total Price:</strong> <span>₱ {{getCheckoutSubtotal() | number:2}}</span></p>
                    <p><strong>30% Down Payment:</strong> <span>₱ {{ (getCheckoutSubtotal() * 0.3) | number:2 }}</span></p>

                    <div class="separator-line"></div>

                    <p><strong>To Pay:</strong> <span class="amount-to-pay">₱ {{ (getCheckoutSubtotal() * 0.3) | number:2 }}</span></p>
                    <p><strong>Remaining Balance:</strong> <span>₱ {{ (getCheckoutSubtotal() * 0.7) | number:2 }}</span></p>
                </div>
            </div>
        </div>

        <div class="payment-methods-box">
            <label class="section-label">Payment Method <span class="text-danger">*</span></label>

            <div class="sub-payment-options" ng-show="paymentMethod === 'Full Payment'">
                <div class="sub-radio-row">
                    <label class="radio-item">
                        <input type="radio" ng-model="subPayment" value="GCash" ng-click="toggleSubPayment('GCash')"> GCash
                    </label>
                    <label class="radio-item">
                        <input type="radio" ng-model="subPayment" value="Bank Transfer" ng-click="toggleSubPayment('Bank Transfer')"> Bank Transfer
                    </label>
                </div>

                <div class="qr-container" ng-show="subPayment === 'GCash' || subPayment === 'Bank Transfer'">
                    <img ng-if="subPayment === 'GCash'" src="/Content/SolteiraBrandsImages/SBPaymentImages/qr[1].png" class="qr-code" />
                    <img ng-if="subPayment === 'Bank Transfer'" src="/Content/SolteiraBrandsImages/SBPaymentImages/qr[2].png" class="qr-code" />
                </div>

                <label class="radio-item">
                    <input type="radio" ng-model="subPayment" value="Cash through meetup"> Cash through meetup
                </label>

                <div class="meetup-details" ng-show="subPayment === 'Cash through meetup'">
                    <p>Location: <span class="text-success">LBC Angeles</span></p>
                    <small>I-V G/F JMS Bldg., Mc Arthur Highway, Salapungan, Angeles City, Pampanga</small>

                    <div class="calendar-mock">
                        <div class="calendar-container">
                            <div class="calendar-header">
                                <div class="month-nav">
                                    <button type="button" class="nav-btn" ng-click="changeMonth(-1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                    <strong>{{months[currentDate.getMonth()]}} {{currentDate.getFullYear()}}</strong>
                                    <button type="button" class="nav-btn" ng-click="changeMonth(1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>
                                <span class="required text-danger">*</span>
                            </div>
                            <div class="calendar-grid">
                                <div class="day-labels">
                                    <span>m</span><span>t</span><span>w</span><span>t</span><span>f</span><span>s</span><span>s</span>
                                </div>
                                <div class="days">
                                    <span ng-repeat="day in calendarDays"
                                          ng-class="{'muted': day.isMuted, 'selected-day': selectedDay == day.val && !day.isMuted}"
                                          ng-click="selectDay(day)">
                                        {{day.val}}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="time-picker-container">
                            <label class="section-label">Time <span class="required text-danger">*</span></label>
                            <select ng-model="meetupTime" class="form-control time-select">
                                <option value="" disabled selected>Select Time</option>
                                <option ng-repeat="t in timeOptions" value="{{t}}">{{t}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="terms-mini">
                        <label class="section-label">Terms & Conditions</label>
                        <ul>
                            <li>30% Down Payment is required immediately. <strong>Please check your email for the specific link and method to submit your down payment.</strong></li>
                            <li>Missing a payment or the final deadline automatically cancels your order.</li>
                            <li>All money paid will be kept by Solteira & Brands.</li>
                            <li>The item will be put back up for sale.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="sub-payment-options" ng-show="paymentMethod === 'Layaway'">
                <div class="sub-radio-row">
                    <label class="radio-item">
                        <input type="radio" ng-model="subPayment" value="GCash"> GCash
                    </label>
                    <label class="radio-item">
                        <input type="radio" ng-model="subPayment" value="Bank Transfer"> Bank Transfer
                    </label>
                </div>

                <div class="qr-container" ng-show="subPayment === 'GCash' || subPayment === 'Bank Transfer'">
                    <img ng-if="subPayment === 'GCash'" src="/Content/SolteiraBrandsImages/SBPaymentImages/qr[1].png" class="qr-code" />
                    <img ng-if="subPayment === 'Bank Transfer'" src="/Content/SolteiraBrandsImages/SBPaymentImages/qr[2].png" class="qr-code" />
                </div>
            </div>

            <div class="input-fields" ng-hide="subPayment === 'Cash through meetup'">
                <div class="form-group">
                    <label class="section-label">Reference Number: <span class="text-danger">*</span></label>
                    <input type="text" ng-model="referenceNumber" />
                </div>
                <div class="form-group">
                    <label class="section-label">Proof of Payment: <span class="text-danger">*</span></label>
                    <div class="upload-wrapper">
                        <input type="file" id="proofUpload" hidden />

                        <label for="proofUpload" class="custom-upload-btn">
                            <i class="bi bi-upload"></i>
                            <span>Upload Proof</span>

                        </label>
                        <small class="file-name-display">No file chosen</small>
                    </div>  
                    <small class="text-muted photo-limit">
                        Please upload a clear copy of your payment. (Maximum Size: 5MB)                       
                    </small>
                </div>
            </div>
        </div>

        <div class="pay-btn-container">
            <button class="pay-now-btn" ng-click="submitPayment()">
                {{ subPayment === 'Cash through meetup' ? 'SCHEDULE' : 'PAY' }}
            </button>
        </div>
    </div>
</div>