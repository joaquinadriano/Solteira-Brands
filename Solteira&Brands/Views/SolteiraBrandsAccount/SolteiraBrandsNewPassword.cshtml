@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>New Password | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/css/ordering-system/NewPassword.css" />
</head>

<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="d-flex align-items-center justify-content-center">

        <div class="new-pw-container">
            <div class="new-pw-logo">
                <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" alt="Logo" />
                </a>
            </div>

            <div class="new-pw-desc">
                <h2>Enter your new password.</h2>
                <p>Choose a strong password with at least 8 characters.</p>
            </div>

            <div class="new-pw-content w-100">
                <form name="resetPasswordForm" class="w-100 d-flex flex-column align-items-center" ng-submit="submitResetPassword($event)">
                    @Html.AntiForgeryToken()
                    <div class="error-text mb-2 w-100" ng-show="resetPasswordError">{{resetPasswordError}}</div>
                    <div class="form-group text-start mb-4 w-100">
                        <label for="password" class="form-label">
                            Password <span class="text-danger">*</span>
                        </label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   id="password" name="Password"
                                   ng-model="registerData.password"
                                   placeholder="Enter password"
                                   minlength="8"
                                   maxlength="16"
                                   ng-attr-title="{{resetPasswordError || undefined}}"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Min 8, max 16 characters: upper, lower, number, special.</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="verifyPassword" class="form-label">
                            Verify Password <span class="text-danger">*</span>
                        </label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   id="verifyPassword" name="ConfirmPassword"
                                   ng-model="registerData.verifyPassword"
                                   placeholder="Enter password again"
                                   minlength="8"
                                   maxlength="16"
                                   ng-attr-title="{{resetPasswordError || undefined}}"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Must match password.</small>
                    </div>

                    <button type="submit" class="submit-btn w-25" id="submitBtn" ng-disabled="resetPasswordSubmitting">
                        <span ng-show="!resetPasswordSubmitting">SUBMIT</span>
                        <span ng-show="resetPasswordSubmitting">UPDATING...</span>
                    </button>

                </form>
            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
    <script src="~/Scripts/SBScripts/PasswordToggle.js"></script>
</body>

</html>
