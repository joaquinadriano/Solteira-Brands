@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>New Password | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/css/ordering-system/NewPassword.css" />
</head>

<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="d-flex align-items-center justify-content-center">

        <div class="new-pw-container">
            <div class="new-pw-logo">
                <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" alt="Logo" />
                </a>
            </div>

            <div class="new-pw-desc">
                <h2>Enter your new password.</h2>
                <p>Choose a strong password with at least 8 characters.</p>
            </div>

            <div class="new-pw-content w-100">
                <form id="resetForm" class="w-100 d-flex flex-column align-items-center" action="@Url.Action("SolteiraBrandsOTP", "SolteiraAndBrands")" method="post">

                    <div class="text-start mb-4 w-100">
                        <label for="password" class="form-label">
                            Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group custom-input-group w-100">
                            <input type="{{showPassword ? 'text' : 'password'}}"
                                   class="form-control custom-input border-end-0"
                                   ng-model="registerData.password"
                                   placeholder="Minimum of 8 characters" required />
                            <span class="input-group-text bg-transparent border-start-0"
                                  ng-click="togglePassword()" style="cursor: pointer;">
                                <i class="bi" ng-class="{'bi-eye': showPassword, 'bi-eye-slash-fill': !showPassword}"></i>
                            </span>
                        </div>
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label for="verifyPassword" class="form-label">
                            Verify Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group custom-input-group w-100">
                            <input type="{{showVerifyPassword ? 'text' : 'password'}}"
                                   class="form-control custom-input border-end-0"
                                   ng-model="registerData.verifyPassword"
                                   placeholder="Re-type your password" required />
                            <span class="input-group-text bg-transparent border-start-0"
                                  ng-click="toggleVerifyPassword()" style="cursor: pointer;">
                                <i class="bi" ng-class="{'bi-eye': showVerifyPassword, 'bi-eye-slash-fill': !showVerifyPassword}"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn w-25" id="submitBtn">
                        <span id="btnText">SUBMIT</span>
                    </button>

                </form>
            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
</body>

</html>
