@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Reset Password | Solteira & Brands</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/ordering-system/ForgotPasswordStyle.css"/>
</head>

<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="d-flex align-items-center justify-content-center">

        <div class="reset-container">
            <div class="reset-logo">
                <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" alt="Logo" />
                </a>
            </div>

            <div class="reset-desc">
                <h2>Enter email to reset password.</h2>
                <p>You will receive a One-Time Passcode (OTP) at this email address.</p>
            </div>

            <div class="reset-content w-100">

                <form name="forgotForm" class="w-100" ng-submit="submitForgotPassword($event)">
                    @Html.AntiForgeryToken()
                    <div class="input-wrapper text-start">
                        <label for="email" class="form-label">
                            Email <span class="text-danger">*</span>
                        </label>
                        <input type="email" class="form-control custom-input w-100"
                               ng-class="{'is-invalid': forgotPasswordError}"
                               id="email" name="email"
                               placeholder="name@example.com"
                               ng-model="userEmail"
                               ng-change="onForgotEmailInput()"
                               ng-attr-title="{{forgotPasswordError || undefined}}"
                               required />
                        <small class="helper-text" ng-class="{'d-none': forgotPasswordError}">
                            Enter a valid email address.
                        </small>
                        <div class="error-text" ng-show="forgotPasswordError">{{forgotPasswordError}}</div>
                    </div>

                    <div class="text-center mt-3">
                        <button type="submit" class="submit-btn" id="submitBtn" ng-disabled="forgotPasswordSubmitting">
                        <span ng-show="!forgotPasswordSubmitting">SEND</span>
                        <span ng-show="forgotPasswordSubmitting">Sending...</span>
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
</body>

</html>