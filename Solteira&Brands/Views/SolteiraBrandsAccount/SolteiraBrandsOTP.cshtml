@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>OTP | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/SolteiraBrandsStyle/OTPStyle.css"/>
</head>
<body ng-app="SolteiraAndBrands" ng-controller="SolteiraAndBrandsController">

    <div class="otp-container d-flex align-items-center justify-content-center">
        <div class="otp-logo">
            <a href="@Url.Action("SolteiraBrandsLogin","SolteiraBrandsAccount")">
                <img src="~/Content/SolteiraBrandsImages/SBSharedImages/Solteira&BrandsMainLogo.png" alt="Logo" />
            </a>
        </div>

        <div class="otp-content">
            <h2>Enter OTP</h2>
            <p>Please enter OTP sent via email.</p>

            <form id="otpForm">
                <div class="input-wrapper">
                    <input type="text" class="custom-input" id="otpInput" required maxlength="6">
                    <span id="timerText" ng-show="timerVisible">{{timeLeft}}s</span>
                </div>
                <div class="resend-container">
                    <a href="javascript:void(0)"
                       id="resendLink"
                       ng-click="timerVisible ? null : resendOtp()"
                       ng-class="{'disabled-link': timerVisible}">
                        Resend OTP
                    </a>
                </div>
                <button type="submit" class="submit-btn" id="submitBtn">
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none"></span>
                    <span id="btnText">SUBMIT</span>
                </button>
            </form>
        </div>
    </div>

    <script>

        document.addEventListener("DOMContentLoaded", function () {
            // --- Timer Logic ---
            let timeLeft = 30;
            const timerSpan = document.getElementById("timerText");
            const resendLink = document.getElementById("resendLink");

            resendLink.classList.add("disabled-link");
            resendLink.style.pointerEvents = "none";

            const countdown = setInterval(function () {
                timeLeft--;
                timerSpan.textContent = timeLeft + "s";

                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    timerSpan.style.display = "none";
                    resendLink.classList.remove("disabled-link");
                    resendLink.style.pointerEvents = "auto";
                }
            }, 1000);

            // --- SweetAlert Logic ---
            const otpForm = document.getElementById("otpForm");

            otpForm.addEventListener("submit", function (e) {
                e.preventDefault();

                // Use querySelector to safely find elements even if IDs are tricky
                const submitBtn = document.getElementById("submitBtn");
                const btnText = document.getElementById("btnText");
                const btnSpinner = document.getElementById("btnSpinner");
                const enteredOtp = document.getElementById("otpInput").value;

                // Start loading state
                if (submitBtn) submitBtn.disabled = true;
                if (btnText) btnText.textContent = "VERIFYING...";

                // Ensure you have a spinner element in HTML: <span id="btnSpinner" class="d-none"></span>
                if (btnSpinner) btnSpinner.classList.remove("d-none");

                setTimeout(() => {
                    if (enteredOtp === "123456") {
                        Swal.fire({
                            title: 'Verification Complete!',
                            icon: 'success',
                            confirmButtonColor: '#87AE73',
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // This calls your handleOTPSuccess function in the Angular Controller
                                const scope = angular.element(document.querySelector('[ng-controller="SolteiraAndBrandsController"]')).scope();
                                scope.$apply(() => { scope.handleOTPSuccess(); });
                            }
                        });
                    } else {
                        // Reset UI
                        if (submitBtn) submitBtn.disabled = false;
                        if (btnText) btnText.textContent = "SUBMIT";
                        if (btnSpinner) btnSpinner.classList.add("d-none");

                        Swal.fire({ title: 'Error', text: 'Incorrect OTP', icon: 'error' });
                    }
                }, 1500);
            });
    });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>

</body>
</html>
