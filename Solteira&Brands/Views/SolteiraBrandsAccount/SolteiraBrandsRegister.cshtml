@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Create Account | Solteira & Brands</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/css/ordering-system/CreateAccountStyle.css"/>
</head>

<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="register-container">

        <div class="register-logo">
            <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">
                <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
            </a>
        </div>

        <div class="register-details d-flex align-items-center justify-content-center">

            <div class="register-form position-relative">

                <p class="register-text">Step into the Solteira & Brands world defined by elegance.</p>

                <form name="registerForm" class="d-flex flex-column align-items-center" ng-submit="register(registerForm)">
                    @Html.AntiForgeryToken()
                    <fieldset class="register-form-fieldset w-100 border-0 p-0 m-0 d-flex flex-column align-items-center" ng-disabled="registerSubmitting">
                    <div class="text-start mb-4 w-100">
                        <label for="email" class="form-label">
                            Email <span class="text-danger">*</span>
                        </label>
                        <input type="email"
                               class="form-control custom-input"
                               ng-class="{'is-invalid': registerErrors.email}"
                               id="email" name="email"
                               ng-model="registerData.email"
                               ng-change="onEmailInput()"
                               ng-blur="onEmailBlur(registerForm)"
                               placeholder="name@example.com"
                               ng-attr-title="{{registerErrors.email || undefined}}"
                               required />
                        <small class="helper-text" ng-class="{'d-none': registerErrors.email}">
                            Enter a valid email address.
                        </small>
                        <div class="error-text" ng-if="registerErrors.email">{{registerErrors.email}}</div>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="registerUsername" class="form-label">
                            Username <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               maxlength="14" pattern="^[^\s]{1,14}$"
                               class="form-control custom-input"
                               ng-class="{'is-invalid': registerErrors.username}"
                               id="registerUsername" name="username"
                               ng-model="registerData.username"
                               ng-change="onUsernameInput()"
                               ng-blur="onUsernameBlur(registerForm)"
                               placeholder="Enter username"
                               ng-attr-title="{{registerErrors.username || undefined}}"
                               required />
                        <small class="helper-text" ng-class="{'d-none': registerErrors.username}">
                            Max 14 characters. No spaces. Must be unique.
                        </small>
                        <small class="error-text username-error-text" id="registerUsernameError" style="display:none;"></small>
                        <small class="error-text" ng-if="registerErrors.username">{{registerErrors.username}}</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="firstName" class="form-label">
                            First Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               maxlength="50"
                               class="form-control custom-input"
                               ng-class="{'is-invalid': registerErrors.firstName}"
                               id="firstName" name="firstName"
                               ng-model="registerData.firstName"
                               ng-change="onFirstNameInput()"
                               ng-blur="onFirstNameBlur()"
                               placeholder="Enter first name"
                               required />
                        <small class="error-text" ng-if="registerErrors.firstName">{{registerErrors.firstName}}</small>
                        <small class="helper-text" ng-if="!registerErrors.firstName">Letters only. Max 50 characters.</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="lastName" class="form-label">
                            Last Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               maxlength="50"
                               class="form-control custom-input"
                               ng-class="{'is-invalid': registerErrors.lastName}"
                               id="lastName" name="lastName"
                               ng-model="registerData.lastName"
                               ng-change="onLastNameInput()"
                               ng-blur="onLastNameBlur()"
                               placeholder="Enter last name"
                               required />
                        <small class="error-text" ng-if="registerErrors.lastName">{{registerErrors.lastName}}</small>
                        <small class="helper-text" ng-if="!registerErrors.lastName">Letters only. Max 50 characters.</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="password" class="form-label">
                            Password <span class="text-danger">*</span>
                        </label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   ng-class="{'is-invalid': registerErrors.password}"
                                   id="password" name="password"
                                   ng-model="registerData.password"
                                   ng-change="onPasswordInput()"
                                   placeholder="Enter password"
                                   minlength="8"
                                   maxlength="16"
                                   ng-attr-title="{{registerErrors.password || undefined}}"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text" ng-class="{'d-none': registerErrors.password}">
                            8-16 characters: uppercase, lowercase, numbers, and symbols.
                        </small>
                        <small class="error-text" ng-if="registerErrors.password">{{registerErrors.password}}</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="verifyPassword" class="form-label">
                            Verify Password <span class="text-danger">*</span>
                        </label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   ng-class="{'is-invalid': registerErrors.verifyPassword}"
                                   name="ConfirmPassword"
                                   id="verifyPassword"
                                   ng-model="registerData.verifyPassword"
                                   ng-change="onVerifyPasswordInput()"
                                   placeholder="Enter password again"
                                   minlength="8"
                                   maxlength="16"
                                   ng-attr-title="{{registerErrors.verifyPassword || undefined}}"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text" ng-class="{'d-none': registerErrors.verifyPassword}">
                            Must match password.
                        </small>
                        <small class="error-text" ng-if="registerErrors.verifyPassword">{{registerErrors.verifyPassword}}</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <div class="form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="acceptedTermsCheckbox"
                                   name="acceptedTerms"
                                   ng-model="registerData.acceptedTerms"
                                   ng-change="onAcceptedTermsChange()"
                                   required />

                            <label class="form-check-label" for="acceptedTermsCheckbox">
                                I agree to the
                                <a href="#"
                                   class="sb-policy-link"
                                   id="termsPolicyLink">Terms &amp; Conditions</a>
                                and
                                <a href="#"
                                   class="sb-policy-link"
                                   id="privacyPolicyLink">Privacy Policy</a>
                            </label>
                        </div>

                        <small class="error-text" ng-if="registerErrors.acceptedTerms">
                            {{registerErrors.acceptedTerms}}
                        </small>
                    </div>

                    <button type="submit"
                            class="create-btn w-35"
                            ng-class="{'create-btn-loading': registerSubmitting}"
                            ng-disabled="registerSubmitting || registerErrors.email || registerErrors.username || registerErrors.firstName || registerErrors.lastName || registerErrors.password || registerErrors.verifyPassword || registerErrors.acceptedTerms || !registerData.acceptedTerms || !registerData.firstName || !registerData.lastName">
                        <span ng-hide="registerSubmitting">CREATE</span>
                        <span ng-show="registerSubmitting">CREATING...</span>
                    </button>
                    </fieldset>

                </form>

                <div class="register-busy-overlay" ng-show="registerSubmitting" ng-attr-aria-busy="{{ registerSubmitting ? 'true' : 'false' }}" aria-live="polite">
                    <div class="register-busy-inner">
                        <div class="register-busy-spinner" role="status"></div>
                        <p class="register-busy-caption">Creating your account...</p>
                    </div>
                </div>

                <!-- Terms & Conditions Modal -->
                <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content sb-policy-modal">
                            <div class="modal-header">
                                <h5 class="modal-title" id="termsModalLabel">Terms &amp; Conditions</h5>
                            </div>
                            <div class="modal-body">
                                <div class="sb-policy-scroll" id="termsPolicyScroll">
                                    <div style="white-space: pre-line;" ng-bind="publicPolicies.termsAndConditions"></div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-success" id="termsAgreeBtn" disabled>Agree</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Privacy Policy Modal -->
                <div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content sb-policy-modal">
                            <div class="modal-header">
                                <h5 class="modal-title" id="privacyModalLabel">Privacy Policy</h5>
                            </div>
                            <div class="modal-body">
                                <div class="sb-policy-scroll" id="privacyPolicyScroll">
                                    <div style="white-space: pre-line;" ng-bind="publicPolicies.privacyPolicy"></div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-success" id="privacyAgreeBtn" disabled>Agree</button>
                            </div>
                        </div>
                    </div>
                </div>

                <p class="login-desc d-flex">
                    Already have an account?
                    <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")" class="login-link">Login</a>
                </p>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
    <script>
        (function () {
            var usernameInput = document.getElementById("registerUsername");
            var errorEl = document.getElementById("registerUsernameError");
            if (usernameInput && errorEl) {
                usernameInput.addEventListener("input", function () {
                    var value = this.value || "";
                    if (value.length > 14) {
                        errorEl.textContent = "Username cannot exceed 14 characters.";
                        errorEl.style.display = "block";
                    } else if (/\s/.test(value)) {
                        errorEl.textContent = "Username cannot contain spaces.";
                        errorEl.style.display = "block";
                    } else {
                        errorEl.style.display = "none";
                    }
                });
            }
        })();
    </script>
    <script src="~/Scripts/SBScripts/PasswordToggle.js"></script>

    <script>
        (function () {
            var checkbox = document.getElementById('acceptedTermsCheckbox');
            if (!checkbox) return;

            var termsLink = document.getElementById('termsPolicyLink');
            var privacyLink = document.getElementById('privacyPolicyLink');

            function setCheckboxChecked() {
                checkbox.checked = true;
                // Trigger Angular ng-change/ng-model updates.
                checkbox.dispatchEvent(new Event('input', { bubbles: true }));
                checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }

            function wirePolicyModal(modalId, scrollId, agreeBtnId) {
                var modalEl = document.getElementById(modalId);
                var scrollEl = document.getElementById(scrollId);
                var agreeBtn = document.getElementById(agreeBtnId);
                if (!modalEl || !scrollEl || !agreeBtn) return;

                function resetAgree() {
                    agreeBtn.disabled = true;
                    // Reset scroll so Agree must be earned each time.
                    scrollEl.scrollTop = 0;
                }

                scrollEl.addEventListener('scroll', function () {
                    var remaining = scrollEl.scrollHeight - scrollEl.scrollTop - scrollEl.clientHeight;
                    // Threshold to account for sub-pixel scrolling.
                    if (remaining <= 2) {
                        agreeBtn.disabled = false;
                    } else {
                        agreeBtn.disabled = true;
                    }
                });

                modalEl.addEventListener('shown.bs.modal', function () {
                    resetAgree();
                    scrollEl.focus && scrollEl.focus();
                });

                agreeBtn.addEventListener('click', function () {
                    setCheckboxChecked();
                    var m = window.bootstrap ? bootstrap.Modal.getInstance(modalEl) : null;
                    if (m) m.hide();
                    else modalEl.classList.remove('show');
                });
            }

            wirePolicyModal('termsModal', 'termsPolicyScroll', 'termsAgreeBtn');
            wirePolicyModal('privacyModal', 'privacyPolicyScroll', 'privacyAgreeBtn');

            function openModal(modalId) {
                var modalEl = document.getElementById(modalId);
                if (!modalEl || !window.bootstrap) return;
                var m = bootstrap.Modal.getOrCreateInstance(modalEl);
                m.show();
            }

            if (termsLink) {
                termsLink.addEventListener('click', function (e) {
                    e.preventDefault();
                    openModal('termsModal');
                });
            }

            if (privacyLink) {
                privacyLink.addEventListener('click', function (e) {
                    e.preventDefault();
                    openModal('privacyModal');
                });
            }
        })();
    </script>
</body>

</html>