@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Account | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/css/ordering-system/CreateAccountStyle.css"/>
</head>

<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="register-container">

        <div class="register-logo">
            <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">
                <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
            </a>
        </div>

        <div class="register-details d-flex align-items-center justify-content-center">

            <div class="register-form">

                <p class="register-text">Step into the Solteira & Brands world defined by elegance.</p>

                <form name="registerForm" class="d-flex flex-column align-items-center" ng-submit="register(registerForm)">
                    @Html.AntiForgeryToken()
                    <div class="text-start mb-4 w-100">
                        <label for="email" class="form-label">
                            Email <span class="text-danger">*</span>
                        </label>
                        <input type="email"
                               class="form-control custom-input"
                               ng-class="{'is-invalid': registerErrors.email}"
                               id="email" name="email"
                               ng-model="registerData.email"
                               ng-blur="onEmailBlur(registerForm)"
                               placeholder="name@example.com" required />
                        <div class="error-text" ng-if="registerErrors.email">{{registerErrors.email}}</div>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="registerUsername" class="form-label">
                            Username <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               maxlength="14" pattern="^[^\s]{1,14}$"
                               class="form-control custom-input"
                               ng-class="{'is-invalid': registerErrors.username}"
                               id="registerUsername" name="username"
                               ng-model="registerData.username"
                               ng-blur="onUsernameBlur(registerForm)"
                               placeholder="Enter username" required />
                        <small class="helper-text">Max 14 characters. No spaces.</small>
                        <small class="error-text username-error-text" id="registerUsernameError" style="display:none;"></small>
                        <small class="error-text" ng-if="registerErrors.username">{{registerErrors.username}}</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="password" class="form-label">
                            Password <span class="text-danger">*</span>
                        </label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   ng-class="{'is-invalid': registerErrors.password}"
                                   id="password" name="password"
                                   ng-model="registerData.password"
                                   ng-change="onPasswordInput()"
                                   placeholder="Enter password" required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Min 8 characters: upper, lower, number, special.</small>
                        <small class="error-text" ng-if="registerErrors.password">{{registerErrors.password}}</small>
                    </div>

                    <div class="form-group text-start mb-4 w-100">
                        <label for="verifyPassword" class="form-label">
                            Verify Password <span class="text-danger">*</span>
                        </label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   ng-class="{'is-invalid': registerErrors.verifyPassword}"
                                   name="ConfirmPassword"
                                   id="verifyPassword"
                                   ng-model="registerData.verifyPassword"
                                   ng-change="onVerifyPasswordInput()"
                                   placeholder="Enter password again" required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Must match password.</small>
                        <small class="error-text" ng-if="registerErrors.verifyPassword">{{registerErrors.verifyPassword}}</small>
                    </div>

                    <button type="submit"
                            class="create-btn w-25"
                            ng-disabled="registerErrors.email || registerErrors.username || registerErrors.password || registerErrors.verifyPassword">
                        CREATE
                    </button>

                </form>

                <p class="login-desc d-flex">
                    Already have an account?
                    <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")" class="login-link">Login</a>
                </p>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
    <script>
        (function () {
            var usernameInput = document.getElementById("registerUsername");
            var errorEl = document.getElementById("registerUsernameError");
            if (usernameInput && errorEl) {
                usernameInput.addEventListener("input", function () {
                    var value = this.value || "";
                    if (value.length > 14) {
                        errorEl.textContent = "Username cannot exceed 14 characters.";
                        errorEl.style.display = "block";
                    } else if (/\s/.test(value)) {
                        errorEl.textContent = "Username cannot contain spaces.";
                        errorEl.style.display = "block";
                    } else {
                        errorEl.style.display = "none";
                    }
                });
            }
        })();
    </script>
    <script src="~/Scripts/SBScripts/PasswordToggle.js"></script>
</body>

</html>