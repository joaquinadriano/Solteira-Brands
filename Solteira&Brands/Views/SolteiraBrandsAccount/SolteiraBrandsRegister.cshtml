@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Account | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/SolteiraBrandsStyle/CreateAccountStyle.css"/>
</head>

<body ng-app="SolteiraAndBrands" ng-controller="SolteiraAndBrandsController">

    <div class="register-container">

        <div class="register-logo">
            <a href="@Url.Action("SolteiraBrandsLogin","SolteiraBrandsAccount")">
                <img src="~/Content/SolteiraBrandsImages/SBSharedImages/Solteira&BrandsMainLogo.png" />
            </a>
        </div>

        <div class="register-details d-flex align-items-center justify-content-center">

            <div class="register-form">

                <p class="register-text">Step into the Solteira & Brands world defined by elegance.</p>

                <form name="registerForm" class="d-flex flex-column align-items-center">

                    <div class="text-start mb-4 w-100">
                        <label for="email" class="form-label">
                            Email <span class="text-danger">*</span>
                        </label>
                        <input type="email" class="form-control custom-input" id="email"
                               placeholder="name@example.com" required />
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label for="username" class="form-label">
                            Username <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control custom-input" id="username"
                               placeholder="Choose a unique username." required />
                    </div>

                    <div class="text-start mb-4 w-100 position-relative">
                        <label for="password" class="form-label">
                            Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group custom-input-group">
                            <input type="{{showPassword ? 'text' : 'password'}}"
                                   class="form-control custom-input border-end-0"
                                   ng-model="registerData.password"
                                   placeholder="Minimum of 8 characters" required />
                            <span class="input-group-text bg-transparent border-start-0"
                                  ng-click="showPassword = !showPassword" style="cursor: pointer;">
                                <i class="bi" ng-class="showPassword ? 'bi-eye' : 'bi-eye-slash-fill'"></i>
                            </span>
                        </div>
                    </div>

                    <div class="text-start mb-4 w-100 position-relative">
                        <label for="verifyPassword" class="form-label">
                            Verify Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group custom-input-group">
                            <input type="{{showVerifyPassword ? 'text' : 'password'}}"
                                   class="form-control custom-input border-end-0"
                                   ng-model="registerData.verifyPassword"
                                   placeholder="Re-type your password" required />
                            <span class="input-group-text bg-transparent border-start-0"
                                  ng-click="showVerifyPassword = !showVerifyPassword" style="cursor: pointer;">
                                <i class="bi" ng-class="showVerifyPassword ? 'bi-eye' : 'bi-eye-slash-fill'"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" class="create-btn w-25">CREATE</button>

                </form>

                <p class="login-desc d-flex">
                    Already have an account?
                    <a href="@Url.Action("SolteiraBrandsLogin","SolteiraBrandsAccount")" class="login-link">Login</a>
                </p>

                <button class="signin-google">
                    <i class="bi bi-google"></i>Sign In with Google
                </button>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>

</body>

</html>