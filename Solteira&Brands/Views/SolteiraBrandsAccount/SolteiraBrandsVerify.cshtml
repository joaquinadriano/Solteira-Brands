@{
    Layout = null;
    var email = (ViewBag.Email as string) ?? string.Empty;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Verify Email | Solteira & Brands</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/ordering-system/OTPStyle.css" />
</head>
<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">
    <div class="otp-container d-flex align-items-center justify-content-center">
        <div class="otp-logo">
            <a href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">
                <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" alt="Logo" />
            </a>
        </div>

        <div class="otp-content">
            <h2>Verify your email</h2>
            <p>Please verify your email to continue</p>
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <p class="text-muted small">Code sent to: <strong>@email</strong></p>
            }

            <form id="otpForm" ng-submit="submitOtp($event)">
                @Html.AntiForgeryToken()

                <div class="input-wrapper">
                    <input type="text"
                           class="custom-input"
                           id="otpInput"
                           ng-model="otpValue"
                           required
                           maxlength="6"
                           placeholder="000000"
                           ng-disabled="otpVerifying"
                           ng-change="onOtpInputChange()" />
                    <span id="timerText" ng-show="timerVisible">{{timeLeft}}s</span>
                </div>

                <div class="error-text" ng-show="otpError">{{otpError}}</div>

                <div class="resend-container">
                    <a href="javascript:void(0)"
                       id="resendLink"
                       ng-click="timerVisible ? null : resendOtp()"
                       ng-class="{'disabled-link': timerVisible}">
                        Resend OTP
                    </a>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="submit-btn" id="submitBtn" ng-disabled="otpVerifying">
                        <span ng-show="!otpVerifying">VERIFY</span>
                        <span ng-show="otpVerifying">VERIFYING...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
</body>
</html>

