@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Change Password | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/ordering-system/NewPassword.css" />
</head>
<body>

    <div class="d-flex align-items-center justify-content-center">
        <div class="new-pw-container">
            <div class="new-pw-logo">
                <a href="@Url.Action("SolteiraBrandsHome","SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" alt="Logo" />
                </a>
            </div>

            <div class="new-pw-desc">
                <h2>Change Password</h2>
                <p>Update your password. This will not require OTP since you are already logged in.</p>
            </div>

            <div class="new-pw-content w-100">
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "changePasswordForm", @class = "w-100 d-flex flex-column align-items-center" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3 w-100 text-start">
                        <label for="CurrentPassword" class="form-label">Current Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="currentPassword" id="CurrentPassword" class="form-control custom-input password-input" placeholder="Enter password" required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Enter your current password.</small>
                        <div id="CurrentPasswordError" class="error-text" style="display:none;"></div>
                    </div>

                    <div class="form-group mb-3 w-100 text-start">
                        <label for="NewPassword" class="form-label">New Password</label>
                        <div class="password-wrapper">
                            <input type="password"
                                   name="newPassword"
                                   id="NewPassword"
                                   class="form-control custom-input password-input"
                                   placeholder="Enter password"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Min 8 characters: upper, lower, number, special.</small>
                        <div class="error-text" id="NewPasswordError" style="display:none;"></div>
                    </div>

                    <div class="form-group mb-4 w-100 text-start">
                        <label for="VerifyPassword" class="form-label">Confirm New Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="verifyPassword" id="VerifyPassword" class="form-control custom-input password-input" placeholder="Enter password again" required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text">Must match new password.</small>
                        <div class="error-text" id="VerifyPasswordError" style="display:none;"></div>
                    </div>

                    <button type="submit" class="submit-btn">SAVE NEW PASSWORD</button>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/PasswordToggle.js"></script>
    <script>
        (function () {
            function clearErrors() {
                ['CurrentPassword', 'NewPassword', 'VerifyPassword'].forEach(function (id) {
                    var input = document.getElementById(id);
                    var err = document.getElementById(id + 'Error');
                    if (input) input.classList.remove('is-invalid');
                    if (err) { err.style.display = 'none'; err.textContent = ''; }
                });
            }

            function setFieldError(id, message) {
                var input = document.getElementById(id);
                var err = document.getElementById(id + 'Error');
                if (input) input.classList.add('is-invalid');
                if (err) { err.textContent = message; err.style.display = 'block'; }
            }

            function validateClient() {
                clearErrors();
                var cur = document.getElementById('CurrentPassword').value || '';
                var npw = document.getElementById('NewPassword').value || '';
                var vpw = document.getElementById('VerifyPassword').value || '';
                var hasError = false;

                if (!cur) {
                    setFieldError('CurrentPassword', 'Current password is required.');
                    hasError = true;
                }
                if (!npw) {
                    setFieldError('NewPassword', 'New password is required.');
                    hasError = true;
                }
                if (!vpw) {
                    setFieldError('VerifyPassword', 'Please confirm your new password.');
                    hasError = true;
                }

                if (npw) {
                    var pwMsg = 'Minimum 8 characters. Must include uppercase, lowercase, number, and special character.';
                    if (npw.length < 8 || npw.length > 64 ||
                        !/[A-Z]/.test(npw) ||
                        !/[a-z]/.test(npw) ||
                        !/[0-9]/.test(npw) ||
                        !/[^A-Za-z0-9]/.test(npw)) {
                        setFieldError('NewPassword', pwMsg);
                        hasError = true;
                    }
                }

                if (npw && vpw && npw !== vpw) {
                    setFieldError('VerifyPassword', 'New password and confirmation do not match.');
                    hasError = true;
                }

                return !hasError;
            }

            var form = document.getElementById('changePasswordForm');
            if (!form) return;

            // Clear error as user types if field becomes valid
            ['CurrentPassword', 'NewPassword', 'VerifyPassword'].forEach(function (id) {
                var input = document.getElementById(id);
                if (!input) return;
                input.addEventListener('input', function () {
                    // run minimal validation for this field only
                    var val = input.value || '';
                    var msg = '';
                    if (id === 'CurrentPassword') {
                        if (!val) msg = 'Current password is required.';
                    } else if (id === 'NewPassword') {
                        var pwMsg = 'Minimum 8 characters. Must include uppercase, lowercase, number, and special character.';
                        if (!val ||
                            val.length < 8 || val.length > 64 ||
                            !/[A-Z]/.test(val) ||
                            !/[a-z]/.test(val) ||
                            !/[0-9]/.test(val) ||
                            !/[^A-Za-z0-9]/.test(val)) {
                            msg = pwMsg;
                        }
                    } else if (id === 'VerifyPassword') {
                        var npw = (document.getElementById('NewPassword').value || '');
                        if (!val) msg = 'Please confirm your new password.';
                        else if (npw && val !== npw) msg = 'New password and confirmation do not match.';
                    }

                    var err = document.getElementById(id + 'Error');
                    if (msg) {
                        input.classList.add('is-invalid');
                        if (err) { err.style.display = 'block'; err.textContent = msg; }
                    } else {
                        input.classList.remove('is-invalid');
                        if (err) { err.style.display = 'none'; err.textContent = ''; }
                    }
                });
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!validateClient()) {
                    return;
                }
                var formData = new FormData(form);
                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                }).then(function (r) { return r.json(); })
                  .then(function (data) {
                      if (data && data.success) {
                          Swal.fire({
                              icon: 'success',
                              title: 'Password changed',
                              text: 'Your password has been updated.',
                              confirmButtonText: 'OK'
                          }).then(function () {
                              window.location.href = '@Url.Action("Settings","Account")';
                          });
                      } else {
                          clearErrors();
                          if (data && data.field) {
                              setFieldError(
                                  data.field === 'currentPassword' ? 'CurrentPassword' :
                                  data.field === 'newPassword' ? 'NewPassword' :
                                  data.field === 'verifyPassword' ? 'VerifyPassword' : '',
                                  data.message || 'Please try again.'
                              );
                          }
                          Swal.fire({
                              icon: 'error',
                              title: 'Unable to change password',
                              text: (data && data.message) || 'Please try again.'
                          });
                      }
                  }).catch(function () {
                      Swal.fire({
                          icon: 'error',
                          title: 'Unexpected error',
                          text: 'Please try again.'
                      });
                  });
            });
        })();
    </script>
</body>
</html>

