@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Change Password | Solteira & Brands</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/ordering-system/NewPassword.css" />
</head>
<body>

    <div class="d-flex align-items-center justify-content-center">
        <div class="new-pw-container">
            <div class="new-pw-logo">
                <a href="javascript:void(0);" aria-label="Solteira and Brands">
                    <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" alt="Logo" />
                </a>
            </div>

            <div class="new-pw-desc">
                <h2>Change Password</h2>
                @if (ViewBag.IsForcedPasswordChange == true)
                {
                    <p>Your account uses a temporary password. You must change it before using the system.</p>
                }
                else
                {
                    <p>Update your password. This will not require OTP since you are already logged in.</p>
                }
            </div>

            <div class="new-pw-content w-100">
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "changePasswordForm", @class = "w-100 d-flex flex-column align-items-center", onsubmit = "return false;" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3 w-100 text-start">
                        <label for="CurrentPassword" class="form-label">Current Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="currentPassword" id="CurrentPassword" class="form-control custom-input password-input" placeholder="Enter password" minlength="8" maxlength="16" required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text" id="CurrentPasswordHint">Enter your current password.</small>
                        <div id="CurrentPasswordError" class="error-text" style="display:none;"></div>
                    </div>

                    <div class="form-group mb-3 w-100 text-start">
                        <label for="NewPassword" class="form-label">New Password</label>
                        <div class="password-wrapper">
                            <input type="password"
                                   name="newPassword"
                                   id="NewPassword"
                                   class="form-control custom-input password-input"
                                   placeholder="Enter password"
                                   minlength="8"
                                   maxlength="16"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text" id="NewPasswordHint">8-16 characters: uppercase, lowercase, numbers, and symbols.</small>
                        <div class="error-text" id="NewPasswordError" style="display:none;"></div>
                    </div>

                    <div class="form-group mb-4 w-100 text-start">
                        <label for="VerifyPassword" class="form-label">Confirm New Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="verifyPassword" id="VerifyPassword" class="form-control custom-input password-input" placeholder="Enter password again" minlength="8" maxlength="16" required />
                            <button type="button" class="toggle-password" aria-label="Toggle password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="helper-text" id="VerifyPasswordHint">Must match new password.</small>
                        <div class="error-text" id="VerifyPasswordError" style="display:none;"></div>
                    </div>

                    <button type="button" class="submit-btn" id="changePasswordSubmitBtn">SAVE NEW PASSWORD</button>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/PasswordToggle.js"></script>
    <script>
        (function () {
            function clearErrors() {
                ['CurrentPassword', 'NewPassword', 'VerifyPassword'].forEach(function (id) {
                    var input = document.getElementById(id);
                    var err = document.getElementById(id + 'Error');
                    var hint = document.getElementById(id + 'Hint');
                    if (input) input.classList.remove('is-invalid');
                    if (err) { err.style.display = 'none'; err.textContent = ''; }
                    if (hint) { hint.style.display = ''; }
                });
            }

            function setFieldError(id, message) {
                var input = document.getElementById(id);
                var err = document.getElementById(id + 'Error');
                var hint = document.getElementById(id + 'Hint');
                if (input) input.classList.add('is-invalid');
                if (err) { err.textContent = message; err.style.display = 'block'; }
                if (hint) { hint.style.display = 'none'; }
            }

            function validateClient() {
                clearErrors();
                var cur = (document.getElementById('CurrentPassword').value || '').trim();
                var npw = (document.getElementById('NewPassword').value || '').trim();
                var vpw = (document.getElementById('VerifyPassword').value || '').trim();
                var hasError = false;
                var samePasswordMsg = 'You must not enter the same password you used before. Please choose a different new password.';

                if (!cur) {
                    setFieldError('CurrentPassword', 'Current password is required.');
                    hasError = true;
                }
                if (!npw) {
                    setFieldError('NewPassword', 'New password is required.');
                    hasError = true;
                }
                if (!vpw) {
                    setFieldError('VerifyPassword', 'Please confirm your new password.');
                    hasError = true;
                }

                if (npw) {
                    var pwMsg = '8-16 characters: uppercase, lowercase, numbers, and symbols.';
                    if (npw.length < 8 || npw.length > 16 ||
                        !/[A-Z]/.test(npw) ||
                        !/[a-z]/.test(npw) ||
                        !/[0-9]/.test(npw) ||
                        !/[^A-Za-z0-9]/.test(npw)) {
                        setFieldError('NewPassword', pwMsg);
                        hasError = true;
                    }
                    if (cur && npw === cur) {
                        setFieldError('NewPassword', samePasswordMsg);
                        hasError = true;
                    }
                }

                if (npw && vpw && npw !== vpw) {
                    setFieldError('VerifyPassword', 'New password and confirmation do not match.');
                    hasError = true;
                }

                return !hasError;
            }

            var form = document.getElementById('changePasswordForm');
            if (!form) return;

            // Clear error as user types if field becomes valid
            ['CurrentPassword', 'NewPassword', 'VerifyPassword'].forEach(function (id) {
                var input = document.getElementById(id);
                if (!input) return;
                input.addEventListener('input', function () {
                    // run minimal validation for this field only
                    var val = input.value || '';
                    var msg = '';
                    if (id === 'CurrentPassword') {
                        if (!val) msg = 'Current password is required.';
                    } else if (id === 'NewPassword') {
                        var pwMsg = '8-16 characters: uppercase, lowercase, numbers, and symbols.';
                        if (!val ||
                            val.length < 8 || val.length > 16 ||
                            !/[A-Z]/.test(val) ||
                            !/[a-z]/.test(val) ||
                            !/[0-9]/.test(val) ||
                            !/[^A-Za-z0-9]/.test(val)) {
                            msg = pwMsg;
                        }
                        var cur = (document.getElementById('CurrentPassword').value || '').trim();
                        if (val && cur && val.trim() === cur) {
                            msg = 'You must not enter the same password you used before. Choose a different new password.';
                        }
                    } else if (id === 'VerifyPassword') {
                        var npw = (document.getElementById('NewPassword').value || '');
                        if (!val) msg = 'Please confirm your new password.';
                        else if (npw && val !== npw) msg = 'New password and confirmation do not match.';
                    }

                    var err = document.getElementById(id + 'Error');
                    var hint = document.getElementById(id + 'Hint');
                    if (msg) {
                        input.classList.add('is-invalid');
                        if (err) { err.style.display = 'block'; err.textContent = msg; }
                        if (hint) { hint.style.display = 'none'; }
                    } else {
                        input.classList.remove('is-invalid');
                        if (err) { err.style.display = 'none'; err.textContent = ''; }
                        if (hint) { hint.style.display = ''; }
                    }
                });
            });

            function doSubmit() {
                if (!validateClient()) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Please correct the form',
                        text: 'Check the fields marked in red. New password must be different from your current password and meet all requirements. Please re-enter.',
                        confirmButtonText: 'OK'
                    });
                    return;
                }
                var formData = new FormData(form);
                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                }).then(function (r) { return r.json(); })
                  .then(function (data) {
                      if (data && data.success) {
                          Swal.fire({
                              icon: 'success',
                              title: 'Success',
                              text: 'Your password has been updated successfully.',
                              confirmButtonText: 'OK',
                              confirmButtonColor: '#28a745'
                          }).then(function () {
                              var nextUrl = (data && data.redirectUrl) ? data.redirectUrl : '@Url.Action("Settings","Account")';
                              window.location.href = nextUrl;
                          });
                      } else {
                          clearErrors();
                          var fieldId = (data && data.field) ? (data.field === 'currentPassword' ? 'CurrentPassword' : data.field === 'newPassword' ? 'NewPassword' : data.field === 'verifyPassword' ? 'VerifyPassword' : '') : '';
                          if (fieldId) {
                              setFieldError(fieldId, data.message || 'Please try again.');
                          }
                          Swal.fire({
                              icon: 'error',
                              title: 'Unable to change password',
                              text: (data && data.message) || 'Please try again.'
                          });
                      }
                  }).catch(function () {
                      Swal.fire({
                          icon: 'error',
                          title: 'Unexpected error',
                          text: 'Please try again.'
                      });
                  });
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                doSubmit();
            });
            var submitBtn = document.getElementById('changePasswordSubmitBtn');
            if (submitBtn) {
                submitBtn.addEventListener('click', function () {
                    doSubmit();
                });
            }
        })();
    </script>
</body>
</html>

