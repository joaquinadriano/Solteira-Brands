
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login | Solteira & Brands</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/SolteiraBrandsStyle/LoginStyle.css" />
</head>
<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="login-container">

        <div class="login-image">

            <a href="@Url.Action("SolteiraBrandsHome","SolteiraAndBrands")">
                <img src="~/Content/SolteiraBrandsImages/SBAccountImages/login-img.jpg" />
            </a>

        </div>

        <div class="login-details d-flex align-items-center justify-content-center">

            <div class="login-form">

                <p class="login-text">Welcome back to Solteira & Brands. <br /> Elegance awaits you!</p>

                <form name="loginForm" ng-submit="login()" class="d-flex flex-column align-items-center">

                    <div class="text-start mb-4 w-100">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" class="form-control custom-input" id="username" ng-model="loginData.username"
                               placeholder="Username" required />
                    </div>

                    <div class="text-start mb-4 w-100 position-relative">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group custom-input-group">
                            <input type="{{showPassword ? 'text' : 'password'}}" class="form-control custom-input border-end-0" id="password" ng-model="loginData.password"
                                   placeholder="********" required />
                            <span class="input-group-text bg-transparent border-start-0"
                                  style="cursor : pointer;"
                                  ng-click="showPassword = !showPassword">
                                <i class="bi" ng-class="showPassword ? 'bi-eye' : 'bi-eye-slash-fill'"></i>
                            </span>
                        </div>
                    </div>

                    <div class="text-end w-100 mb-4">
                        <a href="@Url.Action("SolteiraBrandsForgotPassword","SolteiraBrandsAccount")" class="forgot-password-text">
                            Forgot Password?
                        </a>
                    </div>

                    <button type="submit" class="login-btn w-25">LOGIN</button>

                    <p class="login-or">or</p>

                    <button class="login-google"><i class="bi bi-google"></i>Login with Google</button>

                </form>

            </div>

            <p class="reg-desc d-flex">
                Don't have an account?
                <a href="@Url.Action("SolteiraBrandsRegister","SolteiraBrandsAccount")" class="register-link">Create Now</a>
            </p>

            <a href="@Url.Action("SolteiraBrandsOTP","SolteiraBrandsAccount")">
                <p>OTP</p>
            </a>

            <a href="@Url.Action("SolteiraBrandsNewPassword","SolteiraBrandsAccount")">
                <p>New Password</p>
            </a>

        </div>

    </div>
   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>

</body>
</html>

