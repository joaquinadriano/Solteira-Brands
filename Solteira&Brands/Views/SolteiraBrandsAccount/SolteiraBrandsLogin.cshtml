
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login | Solteira & Brands</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/ordering-system/LoginStyle.css" />
</head>
<body ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="login-container">

        <div class="login-image">

            <img src="@Url.Content("~/Content/img/account/login-img.jpg")" alt="Solteira & Brands luxury branding artwork" />

        </div>

        <div class="login-details d-flex align-items-center justify-content-center">

            <div class="login-form">
                <a href="@Url.Action("SolteiraBrandsHome","SolteiraAndBrands")" class="back-to-home-link">&larr; Back to Home</a>

                <p class="login-text">Welcome back to Solteira & Brands. <br /> Elegance awaits you!</p>

                <form name="loginForm" ng-submit="login()" class="d-flex flex-column align-items-center">

                    <div class="text-start mb-4 w-100">
                        <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
                        <input type="text" class="form-control custom-input"
                               maxlength="14" pattern="^[^\s]{1,14}$"
                               ng-class="{'is-invalid': loginErrors.username}"
                               id="username" ng-model="loginData.username"
                               ng-attr-title="{{loginErrors.username || undefined}}"
                               ng-change="onLoginFieldChange('username')"
                               placeholder="Enter username" required />
                        <small class="error-text" ng-if="loginErrors.username">{{loginErrors.username}}</small>
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
                        <div class="password-wrapper">
                            <input type="password"
                                   class="form-control custom-input password-input"
                                   ng-class="{'is-invalid': loginErrors.password}"
                                   id="password" name="Password"
                                   ng-model="loginData.password"
                                   ng-change="onLoginFieldChange('password')"
                                   ng-attr-title="{{loginErrors.password || undefined}}"
                                   placeholder="Enter password"
                                   minlength="8"
                                   maxlength="16"
                                   required />
                            <button type="button" class="toggle-password" aria-label="Toggle password visibility">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                        <small class="error-text" ng-if="loginErrors.password">{{loginErrors.password}}</small>
                    </div>

                    <div class="text-end w-100 mb-4">
                        <a href="@Url.Action("SolteiraBrandsForgotPassword","SolteiraAndBrands")" class="forgot-password-text">
                            Forgot Password?
                        </a>
                    </div>

                    <button type="submit" class="login-btn w-25">LOGIN</button>

                </form>

            </div>

            <p class="reg-desc d-flex">
                Don't have an account?
                <a href="@Url.Action("SolteiraBrandsRegister","SolteiraAndBrands")" class="register-link">Create Now</a>
            </p>

        </div>

    </div>
   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
    <script src="~/Scripts/SBScripts/PasswordToggle.js"></script>

</body>
</html>

