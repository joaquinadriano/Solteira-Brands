@{
    Layout = "~/Views/Shared/_SABInventoryLoginLayout.cshtml";
}
<div class="container container-login d-flex align-items-center justify-content-center">
    <div class="row login-row shadow">
        <div class="col-md-6 login-left d-flex align-items-center justify-content-center py-5">
            <img src="~/Content/img/solteira-logo.png"
                 class="img-fluid login-logo-img" />
        </div>

        <div class="col-md-6 login-right d-flex align-items-center justify-content-center">
            <div>
                <p class="login-title text-center mb-0">SOLTEIRA & BRANDS</p>
                <p class="login-title text-center mb-0">INVENTORY SYSTEM</p>
                <p class="login-subtitle text-center mt-2">
                    Please enter your details to proceed:
                </p>

                <form class="px-4 pt-2">
                    <div class="mb-3">
                        <label class="form-label-adminLogin">Username</label>
                        <input type="text" class="form-control border-input" placeholder="Username">
                    </div>

                    <div class="mb-4">
                        <label class="form-label-adminLogin">Password</label>
                        <input type="password" class="form-control border-input" placeholder="*********">
                    </div>

                    <div class="d-flex justify-content-center">
                        <button class="btn admin-login-button rounded-0">
                            LOGIN
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
