        @*Ito itsura if yung revised*@
        <div class="row  px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="ordersTable">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Order Date</th>
                            <th>No. of Items</th>
                            <th>Address</th>
                            <th>Total Price</th>
                            <th>Order Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        @*Temporary js for the changing of status for ui purpose only. Please modify once database is implemented*@
                        <tr class="text-start" ng-init="orderStatus=''">
                            <td>ORD-001</td>
                            <td>12/25/2025</td>
                            <td>2 items</td>
                            <td>Dapitan St, Sampaloc, Manila</td>
                            <td>P 90, 468.00</td>
                            @*status dropdown*@
                            <td>
                                <div class="dropdown">
                                    <a class="btn dropdown-toggle order-dropdown-status text-muted" href="#" role="button" data-bs-toggle="dropdown">
                                        <span ng-bind="orderStatus || 'Status'">Status</span>
                                    </a>

                                    <ul class="dropdown-menu order-dropdown-menu py-0">
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="orderStatus='Pending';statusChange()">Pending</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="orderStatus='Approved'; statusChange()">Approved</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="orderStatus='Rejected'; statusChange()">Rejected</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="orderStatus='Fully Paid'; statusChange()">Fully Paid</a></li>
                                    </ul>
                                </div>
                            </td>
                            @*view and archive button*@
                            <td class="">
                                <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View Order Details">
                                    <a class="order-action-icon" data-bs-toggle="modal" data-bs-target="#viewOrderDetailsModal">
                                        <img src="@Url.Content("~/Content/img/icons/view.svg")" />
                                    </a>
                                </div>
                                <a class="order-action-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Archive Order" ng-click="archiveOrder()">
                                    <img src="@Url.Content("~/Content/img/icons/archive-status.svg")" />
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*----------Table end----------*@

        @*----------modal view for view button----------*@
        <div class="modal fade" id="viewOrderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content orderDetails-modal-custom" style="background-color: #f8f9fa ">

                    <div class="modal-header border-0 px-4 pt-4 pb-0">
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <h2 class="fw-bold mb-0" id="orderDetailsModalLabel">Order Details</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>

                    <div class="modal-body p-4">
                        <div class="row g-4">

                            @* Left Column *@
                            <div class="col-lg-4">
                                @* Order ID *@
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="fw-bold mb-0">Order ID #001</h4>
                                            <span class="orderDetails-badgeNew">Fully Paid</span>
                                        </div>
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-calendar me-1"></i>
                                            Placed on 17 Nov 2024 · 08:37 PM
                                        </p>
                                    </div>
                                </div>

                                @* Customer Information *@
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3">
                                            <i class="bi bi-person-circle me-2 orderDetails-icon"></i>
                                            Customer Information
                                        </h5>
                                        <div class="mb-3">
                                            <label class="orderDetails-infoLabel">Name</label>
                                            <p class="orderDetails-infoValue">Kim Namjuan</p>
                                        </div>
                                        <div class="mb-3">
                                            <label class="orderDetails-infoLabel">Email</label>
                                            <p class="orderDetails-infoValue">kimnamjuan@gmail.com</p>
                                        </div>
                                        <div>
                                            <label class="orderDetails-infoLabel">Contact No</label>
                                            <p class="orderDetails-infoValue">0912 345 6789</p>
                                        </div>
                                    </div>
                                </div>

                                @* Delivery Information *@
                                <div class="card border-0 shadow-sm rounded-4 mb-2">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2">
                                            <i class="bi bi-geo-alt me-2 orderDetails-icon"></i>
                                            Delivery Address
                                        </h5>
                                        <p class="fw-bold mb-1">Kim Namjuan</p>
                                        <p class="mb-1">1C Brgy Santol, Espana, Manila</p>
                                        <p class="mb-0 text-muted small">Contact: 0912 345 6789</p>
                                    </div>
                                </div>
                            </div>

                            @* Right Column *@
                            <div class="col-lg-8">
                                @* Order Items *@
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3">
                                            <i class="bi bi-bag-check me-2 orderDetails-icon"></i>
                                            Order Items
                                        </h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead class="border-bottom">
                                                    <tr class="text-muted small text-uppercase">
                                                        <th>Item</th>
                                                        <th class="text-center">Quantity</th>
                                                        <th class="text-end">Price</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr class="border-bottom">
                                                        <td class="fw-bold py-3">Many Shape Tennis Bracelet</td>
                                                        <td class="text-center">1</td>
                                                        <td class="text-end">P 55,790.00</td>
                                                    </tr>
                                                    <tr class="border-bottom">
                                                        <td class="fw-bold py-3">Tiara Ring - White Gold</td>
                                                        <td class="text-center">1</td>
                                                        <td class="text-end">P 34,478.00</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                @* Payment Summary *@
                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3">
                                            <i class="bi bi-credit-card me-2 orderDetails-icon"></i>
                                            Payment Summary
                                        </h5>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Payment Method</span>
                                            <span>Full Payment</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Sub Total</span>
                                            <span>P6.00</span>
                                        </div>
                                        <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3 mt-2">
                                            <span>Total</span>
                                            <span class="orderDetails-total">P6.39</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 p-4">
                        <button class="orderDetails-button px-4 py-2" data-bs-dismiss="modal">
                            <span>CLOSE</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        @*----------modal view end----------*@
    </div>
</div>

