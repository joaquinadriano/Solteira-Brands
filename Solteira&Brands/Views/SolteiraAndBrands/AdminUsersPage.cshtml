@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content" ng-init="loadUsersForAdmin()">
    <div class="container-fluid orders-container px-1">

        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Users</p>
            </div>
        </div>

        <div class="row px-4 pt-3">
            <div class="col">
                <div class="card border-0 shadow-sm p-3 rounded-4">

                    <table class="table table-hover table-striped text-center align-middle" id="usersTable" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start ps-3">Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th>Email Verified</th>
                                <th>Joined Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody class="table-group-divider">
                            <tr ng-repeat="u in usersList track by u.id">
                                <td class="text-start ps-3 fw-bold text-secondary">{{u.username}}</td>
                                <td class="text-muted">{{u.email}}</td>
                                <td>
                                    <span class="badge"
                                          ng-class="{
                                            'bg-danger': u.roleName === 'ADMIN',
                                            'bg-warning text-dark': u.roleName === 'MANAGER',
                                            'bg-info text-dark': u.roleName === 'STAFF',
                                            'bg-secondary': u.roleName === 'BUYER' || (!u.roleName || u.roleName === 'UNKNOWN')
                                          }">
                                        {{u.roleName}}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge" ng-class="u.isActive ? 'bg-success' : 'bg-danger'">
                                        {{u.isActive ? 'Active' : 'Inactive'}}
                                    </span>
                                </td>
                                <td class="text-muted">{{u.isVerified ? 'Yes' : 'No'}}</td>
                                <td class="text-muted">{{u.joinedAtString || '-'}}</td>
                                <td>
                                    <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View user details">
                                        <a class="order-action-icon" href="javascript:void(0)" ng-click="openViewUserModal(u)">
                                            <img src="@Url.Content("~/Content/img/icons/view.svg")" alt="View" />
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            <tr ng-if="usersList.length === 0">
                                <td class="text-muted py-4 text-center" colspan="1">No registered users found.</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="modal fade" id="viewUserModal" tabindex="-1" aria-labelledby="viewUserModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" ng-if="selectedUserForView">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="viewUserModalLabel">User Details</h5>
                        <button type="button" class="btn-close" aria-label="Close" ng-click="closeViewUserModal()"></button>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="row g-3">
                            <div class="col-5 text-muted small">User ID</div>
                            <div class="col-7 fw-medium">{{selectedUserForView.id}}</div>

                            <div class="col-5 text-muted small">Username</div>
                            <div class="col-7 fw-medium">{{selectedUserForView.username}}</div>

                            <div class="col-5 text-muted small">Email</div>
                            <div class="col-7">{{selectedUserForView.email}}</div>

                            <div class="col-5 text-muted small">Role</div>
                            <div class="col-7">
                                <span class="badge"
                                      ng-class="{
                                        'bg-danger': selectedUserForView.roleName === 'ADMIN',
                                        'bg-warning text-dark': selectedUserForView.roleName === 'MANAGER',
                                        'bg-info text-dark': selectedUserForView.roleName === 'STAFF',
                                        'bg-secondary': selectedUserForView.roleName === 'BUYER' || (!selectedUserForView.roleName || selectedUserForView.roleName === 'UNKNOWN')
                                      }">
                                    {{selectedUserForView.roleName}}
                                </span>
                            </div>

                            <div class="col-5 text-muted small">Account Status</div>
                            <div class="col-7">
                                <span class="badge" ng-class="selectedUserForView.isActive ? 'bg-success' : 'bg-danger'">
                                    {{selectedUserForView.isActive ? 'Active' : 'Inactive'}}
                                </span>
                            </div>

                            <div class="col-5 text-muted small">Email Verified</div>
                            <div class="col-7">{{selectedUserForView.isVerified ? 'Yes' : 'No'}}</div>

                            <div class="col-5 text-muted small">Joined Date</div>
                            <div class="col-7">{{selectedUserForView.joinedAtString || '-'}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
