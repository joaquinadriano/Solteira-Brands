@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/PaymentStyle.css" />

<div class="payment-page-container" ng-controller="SolteiraBrandsController" ng-init="initPaymentPage()">
    <input type="file" id="proofUpload" accept=".jpg,.jpeg,.png" style="display:none;" />

    <div class="payment-card" ng-if="paymentOrder">
        <h2 class="payment-title">PAYMENT</h2>

        <div class="payment-grid" ng-class="{'deadline-expired-layout': paymentOrder.paymentDeadlineExpired}">

            <div class="left-column">

                <div class="payment-deadline-box"
                     ng-if="paymentOrder.paymentDeadlineFormatted"
                     ng-class="{'expired': paymentOrder.paymentDeadlineExpired}">
                    <div class="deadline-left">
                        <div class="deadline-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="deadline-text">
                            <span class="deadline-label">Payment Deadline:</span>
                            <span class="deadline-time" ng-class="paymentOrder.paymentDeadlineExpired ? 'text-danger' : 'text-dark'">
                                {{paymentOrder.paymentDeadlineFormatted}}
                            </span>
                        </div>
                    </div>
                    <div class="deadline-right">
                        <div class="deadline-badge" ng-class="paymentOrder.paymentDeadlineExpired ? 'text-danger' : 'text-muted'">
                            {{paymentOrder.paymentDeadlineRemainingText}}
                        </div>
                    </div>
                </div>

                @* Order Rejected: show only this, no payment banners. *@
                <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') === 'REJECTED')" class="alert alert-danger mb-3">
                    <strong>Order Rejected.</strong> This order was rejected by admin.
                </div>
                <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') === 'PENDING APPROVAL')" class="alert alert-warning mb-3">
                    <strong>Order not yet approved.</strong> Your order is pending admin approval. After approval you can pay here.
                    <button type="button" class="btn btn-sm btn-outline-dark ms-2" ng-click="reloadPaymentOrder()">Refresh</button>
                </div>
                @* Payment banners only when order is NOT rejected. *@
                <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') !== 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof) && ((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus === 'REJECTED' || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus === 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit" class="alert alert-success mb-3 text-dark">
                    <strong>Payment was rejected. Please resubmit.</strong>
                    <span ng-if="(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason"> {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}</span>
                </div>
                <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') !== 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof) && ((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus === 'REJECTED' || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus === 'REJECTED') && !(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit" class="alert alert-danger mb-3">
                    <strong>Payment was rejected and cannot be resubmitted.</strong>
                    <span ng-if="(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason"> {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}</span>
                    <span class="d-block">Please contact the administrator for assistance.</span>
                </div>
                <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') !== 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof) && ((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus === 'SUBMITTED' || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus === 'SUBMITTED')" class="alert alert-warning mb-3">
                    <strong>Your payment is under review.</strong>
                    <button type="button" class="btn btn-sm btn-outline-dark ms-2" ng-click="openViewPaymentProofModal()">View Payment Proof</button>
                    <a href="@Url.Action("SolteiraBrandsMyOrders", "SolteiraAndBrands")" class="btn btn-sm btn-outline-dark ms-2">Back to My Orders</a>
                </div>
                <div ng-if="paymentOrder && (paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'AWAITING MEETUP'" class="alert alert-info mb-3">
                    <strong>Meetup scheduled.</strong> Your Cash through Meetup schedule has been saved. Please proceed on your selected date and time.
                    <a href="@Url.Action("SolteiraBrandsMyOrders", "SolteiraAndBrands")" class="btn btn-sm btn-outline-dark ms-2">Back to My Orders</a>
                </div>

                <div class="customer-info-box">
                    <div class="info-details">
                        <p class="cust-name">{{paymentOrder.customerName}}</p>
                        <p class="cust-phoneNum">{{paymentOrder.contactNumber}}</p>
                        <p class="cust-address text-break">{{paymentOrder.deliveryAddress}}</p>
                    </div>
                    <hr class="info-separator" />
                    <div class="payment-order-summary modern-summary-card">
                        <p class="section-label-modern">Order summary</p>
                        <div class="summary-items-container">
                            <div class="payment-order-item-modern" ng-repeat="item in paymentOrder.items">
                                <div class="item-info">
                                    <span class="item-qty">{{item.qty}}x</span>
                                    <span class="item-name">{{item.name}}</span>
                                </div>
                                <span class="item-price">&#8369; {{(item.price * item.qty) | number:2}}</span>
                            </div>
                        </div>
                    </div>
                    <div class="price-display mt-3">
                        <div class="modern-price-grid">
                            <div ng-if="paymentOrder.paymentType === 'FULL'" class="mb-2">
                                <p class="mb-0"><strong>Price:</strong> <span class="amount-to-pay">&#8369; {{paymentOrder.amountDue | number:2}}</span></p>
                            </div>
                            <div ng-if="paymentOrder.paymentType === 'LAYAWAY'" class="layaway-details-card modern-summary-card mt-0">
                                <p class="section-label-modern mb-3">Layaway plan details</p>
                                <div class="layaway-info-grid">
                                    <div class="summary-row">
                                        <span class="text-muted">Total Amount</span>
                                        <span class="fw-bold text-dark">&#8369; {{paymentOrder.totalAmount | number:2}}</span>
                                    </div>
                                    <div class="summary-row">
                                        <span class="text-muted">Downpayment ({{paymentOrder.downpaymentPercentage || 30}}%)</span>
                                        <span>&#8369; {{(paymentOrder.totalAmount * (paymentOrder.downpaymentPercentage || 30) / 100) | number:2}}</span>
                                    </div>
                                    <div class="summary-row" ng-if="paymentOrder.remainingBalance != null">
                                        <span class="text-muted">Remaining Balance</span>
                                        <span class="text-danger fw-bold">&#8369; {{paymentOrder.remainingBalance | number:2}}</span>
                                    </div>
                                    <div class="summary-row" ng-if="paymentOrder.monthsAllowed">
                                        <span class="text-muted">Installment Plan</span>
                                        <span class="badge-installment">{{paymentOrder.monthsAllowed}} months</span>
                                    </div>
                                    <div class="summary-row" ng-if="paymentOrder.monthlyInstallment != null">
                                        <span class="text-muted">Monthly Installment</span>
                                        <span>&#8369; {{paymentOrder.monthlyInstallment | number:2}} per month</span>
                                    </div>
                                    <div class="summary-row" ng-if="paymentOrder.installmentsRemaining != null">
                                        <span class="text-muted">Installments Remaining</span>
                                        <span>{{paymentOrder.installmentsRemaining}}</span>
                                    </div>
                                </div>
                                <div class="meetup-price-summary mt-3">
                                    <div class="summary-row highlight-blue" ng-if="(paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'APPROVED' || (paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'REJECTED'">
                                        <span class="fw-bold">Amount Due (Downpayment)</span>
                                        <span class="amount-to-pay">&#8369; {{paymentOrder.amountDue | number:2}}</span>
                                    </div>
                                    <div class="summary-row highlight-blue" ng-if="(paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'LAYAWAY ACTIVE' && paymentOrder.installmentMonthNumber">
                                        <span class="fw-bold">Amount Due (Month {{paymentOrder.installmentMonthNumber}} of {{paymentOrder.monthsAllowed}})</span>
                                        <span class="amount-to-pay">&#8369; {{paymentOrder.amountDue | number:2}}</span>
                                    </div>
                                </div>
                                <div class="modern-due-badge mt-2" ng-if="(paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'LAYAWAY ACTIVE' && paymentOrder.dueDateThisMonth">
                                    <i class="bi bi-calendar-check-fill me-2 calendar-icon"></i>
                                    <span>Due Date: <strong>{{paymentOrder.dueDateThisMonth}}</strong></span>
                                </div>
                                <div class="layaway-progress-section mt-4" ng-if="paymentOrder.totalAmount && paymentOrder.remainingBalance != null">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="progress-text">Payment Progress</span>
                                        <span class="progress-percent">{{getLayawayPaidPercent() | number:1}}%</span>
                                    </div>
                                    <div class="modern-progress-bg">
                                        <div class="modern-progress-fill" ng-style="{'width': getLayawayPaidPercent() + '%'}"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="right-column">

                @* Notice box consolidating rejection context (top of white container) *@
                <div class="alert alert-success mb-3 text-dark"
                     ng-if="paymentOrder
                            && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                            && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                            && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit">
                    <p class="mb-1 fst-italic">
                        <strong>Rejection reason:</strong>
                        {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}
                    </p>
                    <button type="button"
                            class="btn btn-sm btn-outline-dark"
                            ng-click="openViewPaymentProofModal()">
                        View Rejected Proof
                    </button>
                </div>

                <div class="payment-methods-box" ng-if="canShowPayForm()">
                    @* Resubmit path: static channel (no radios), using last rejected payment's channel *@
                    <div ng-if="paymentOrder
                                && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                                && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                                && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit">
                        <div class="mb-2">
                            <span class="section-label d-block mb-1">Payment Channel</span>
                            <span class="fw-bold">{{paymentFormData.channel}}</span>
                        </div>

                        <div ng-if="paymentFormData.channel === 'GCash' && paymentSettings.gcash" class="payment-channel-detail mb-3 d-flex align-items-center flex-nowrap">
                            <div class="qr-wrapper">
                                <img ng-src="{{paymentSettings.gcash.qrImageUrl}}" alt="GCash QR" class="qr-image" ng-if="paymentSettings.gcash.qrImageUrl" />
                            </div>
                            <div class="details-wrapper ms-3">
                                <p class="mb-1 small" ng-if="paymentSettings.gcash.accountName"><strong>Account:</strong><br>{{paymentSettings.gcash.accountName}}</p>
                                <p class="mb-0 small" ng-if="paymentSettings.gcash.accountNumber"><strong>Number:</strong><br>{{paymentSettings.gcash.accountNumber}}</p>
                            </div>
                        </div>
                        <div ng-if="paymentFormData.channel === 'Bank Transfer' && paymentSettings.bankTransfer" class="payment-channel-detail mb-3 d-flex align-items-center flex-nowrap">
                            <div class="qr-wrapper">
                                <img ng-src="{{paymentSettings.bankTransfer.qrImageUrl}}" alt="Bank QR" class="qr-image" ng-if="paymentSettings.bankTransfer.qrImageUrl" />
                            </div>
                            <div class="details-wrapper ms-3">
                                <p class="mb-1 small" ng-if="paymentSettings.bankTransfer.accountName"><strong>Bank / Account:</strong><br>{{paymentSettings.bankTransfer.accountName}}</p>
                                <p class="mb-0 small" ng-if="paymentSettings.bankTransfer.accountNumber"><strong>Number:</strong><br>{{paymentSettings.bankTransfer.accountNumber}}</p>
                            </div>
                        </div>
                        <div ng-if="paymentFormData.channel === 'Cash through Meetup'" class="mb-3 p-3 rounded meetup-details-card">
                            <p class="small fw-bold text-secondary mb-2">Down payment</p>
                            <div class="meetup-price-summary mb-3">
                                <div class="summary-row">
                                    <span class="text-muted">Total Order Amount</span>
                                    <span class="fw-bold text-dark">&#8369; {{(paymentOrder.totalAmount | number:2)}}</span>
                                </div>
                                <div class="summary-row highlight">
                                    <span class="fw-bold">30% Down Payment Required</span>
                                    <span class="amount-to-pay">&#8369; {{(getMeetupDownpaymentAmount() | number:2)}}</span>
                                </div>
                                <div class="summary-row footer-row">
                                    <span class="small text-muted italic">Balance (to be paid at meetup)</span>
                                    <span class="small text-muted fw-bold">&#8369; {{((paymentOrder.totalAmount - getMeetupDownpaymentAmount()) | number:2)}}</span>
                                </div>
                            </div>
                            <div class="mb-3 meetup-place-block">
                                <p class="small fw-bold text-secondary mb-2">Meet up place</p>
                                <div ng-if="meetupSettings.locationName || meetupSettings.address">
                                    <p class="mb-1 fw-semibold text-dark" ng-if="meetupSettings.locationName">{{meetupSettings.locationName}}</p>
                                    <p class="mb-0 small text-muted payment-meetup-address text-break" ng-if="meetupSettings.address">{{meetupSettings.address}}</p>
                                </div>
                                <p class="mb-0 small text-muted fst-italic" ng-if="!meetupSettings.locationName && !meetupSettings.address">Venue details are not listed yet. Please contact the store or check your order confirmation.</p>
                            </div>
                            <p class="mb-2 small text-muted">Select date and time below.</p>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" ng-model="paymentFormData.meetupDate" min="{{getMinMeetupDate()}}" ng-change="onMeetupDateChange()" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Time <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" ng-model="paymentFormData.meetupTime">
                                    <option value="">-- Select time --</option>
                                    <option ng-repeat="t in meetupTimeOptions" value="{{t}}">{{t}}</option>
                                </select>
                                <p class="small text-warning mb-0 mt-1" ng-if="meetupNoSlotsForToday">No available meetup time for today. Please select another date.</p>
                            </div>
                            <div class="mt-3 pt-3 border-top meetup-downpayment-pay-info" ng-if="paymentSettings.gcash || paymentSettings.bankTransfer">
                                <p class="small fw-bold text-dark mb-2">Send your 30% down payment via GCash or bank transfer, then enter your reference number and upload proof below.</p>
                                <div ng-if="paymentSettings.gcash" class="payment-channel-detail mb-3 d-flex align-items-center flex-nowrap">
                                    <div class="qr-wrapper">
                                        <img ng-src="{{paymentSettings.gcash.qrImageUrl}}" alt="GCash QR" class="qr-image" ng-if="paymentSettings.gcash.qrImageUrl" />
                                    </div>
                                    <div class="details-wrapper ms-3">
                                        <p class="mb-1 small" ng-if="paymentSettings.gcash.accountName"><strong>Account:</strong><br>{{paymentSettings.gcash.accountName}}</p>
                                        <p class="mb-0 small" ng-if="paymentSettings.gcash.accountNumber"><strong>Number:</strong><br>{{paymentSettings.gcash.accountNumber}}</p>
                                    </div>
                                </div>
                                <div ng-if="paymentSettings.bankTransfer" class="payment-channel-detail mb-0 d-flex align-items-center flex-nowrap">
                                    <div class="qr-wrapper">
                                        <img ng-src="{{paymentSettings.bankTransfer.qrImageUrl}}" alt="Bank QR" class="qr-image" ng-if="paymentSettings.bankTransfer.qrImageUrl" />
                                    </div>
                                    <div class="details-wrapper ms-3">
                                        <p class="mb-1 small" ng-if="paymentSettings.bankTransfer.accountName"><strong>Bank / Account:</strong><br>{{paymentSettings.bankTransfer.accountName}}</p>
                                        <p class="mb-0 small" ng-if="paymentSettings.bankTransfer.accountNumber"><strong>Number:</strong><br>{{paymentSettings.bankTransfer.accountNumber}}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Initial payment path: full method + channel selection as before *@
                    <div ng-if="!(paymentOrder
                                && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                                && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                                && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit)">
                        <label class="section-label">Payment Method <span class="text-danger">*</span></label>
                        <div class="radio-group-container">
                            <label class="radio-item" ng-class="{'payment-method-disabled': paymentOrder.paymentType === 'LAYAWAY'}">
                                <input type="radio" name="paymentMode" id="pmFull" value="Full Payment" ng-model="paymentMode" class="custom-radio" />
                                <span class="radio-label">Full Payment</span>
                            </label>
                            <label class="radio-item" ng-class="{'payment-method-disabled': paymentOrder.paymentType === 'FULL'}">
                                <input type="radio" name="paymentMode" id="pmLayaway" value="Layaway" ng-model="paymentMode" class="custom-radio" />
                                <span class="radio-label">Layaway</span>
                            </label>
                        </div>

                        <label class="section-label mt-2">Channel <span class="text-danger">*</span></label>
                        <div class="radio-group-container">
                            <label class="radio-item">
                                <input type="radio" name="paymentChannel" id="chGcash" value="GCash" ng-model="paymentFormData.channel" class="custom-radio" />
                                <span class="radio-label">GCash</span>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="paymentChannel" id="chBank" value="Bank Transfer" ng-model="paymentFormData.channel" class="custom-radio" />
                                <span class="radio-label">Bank Transfer</span>
                            </label>
                            <label class="radio-item" ng-if="paymentOrder.paymentType !== 'LAYAWAY'">
                                <input type="radio" name="paymentChannel" id="chMeetup" value="Cash through Meetup" ng-model="paymentFormData.channel" class="custom-radio" />
                                <span class="radio-label">Cash through Meetup</span>
                            </label>
                        </div>

                        <div ng-if="paymentFormData.channel === 'GCash' && paymentSettings.gcash" class="payment-channel-detail mb-3 d-flex align-items-center flex-nowrap">
                            <div class="qr-wrapper">
                                <img ng-src="{{paymentSettings.gcash.qrImageUrl}}" alt="GCash QR" class="qr-image" ng-if="paymentSettings.gcash.qrImageUrl" />
                            </div>
                            <div class="details-wrapper ms-3">
                                <p class="mb-1 pm-text" ng-if="paymentSettings.gcash.accountName"><strong>Account:</strong><br>{{paymentSettings.gcash.accountName}}</p>
                                <p class="mb-0 pm-text" ng-if="paymentSettings.gcash.accountNumber"><strong>Number:</strong><br>{{paymentSettings.gcash.accountNumber}}</p>
                            </div>
                        </div>
                        <div ng-if="paymentFormData.channel === 'Bank Transfer' && paymentSettings.bankTransfer" class="payment-channel-detail mb-3 d-flex align-items-center flex-nowrap">
                            <div class="qr-wrapper">
                                <img ng-src="{{paymentSettings.bankTransfer.qrImageUrl}}" alt="Bank QR" class="qr-image" ng-if="paymentSettings.bankTransfer.qrImageUrl" />
                            </div>
                            <div class="details-wrapper ms-3">
                                <p class="mb-1 pm-text" ng-if="paymentSettings.bankTransfer.accountName"><strong>Bank / Account:</strong><br>{{paymentSettings.bankTransfer.accountName}}</p>
                                <p class="mb-0 pm-text" ng-if="paymentSettings.bankTransfer.accountNumber"><strong>Number:</strong><br>{{paymentSettings.bankTransfer.accountNumber}}</p>
                            </div>
                        </div>
                        <div ng-if="paymentFormData.channel === 'Cash through Meetup'" class="meetup-details-card mb-3 p-3 rounded">
                            <p class="small fw-bold text-secondary mb-2">Down payment</p>
                            <div class="meetup-price-summary mb-3">
                                <div class="summary-row">
                                    <span class="text-muted">Total Order Amount</span>
                                    <span class="fw-bold text-dark">&#8369; {{(paymentOrder.totalAmount | number:2)}}</span>
                                </div>
                                <div class="summary-row highlight">
                                    <span class="fw-bold">30% Down Payment Required</span>
                                    <span class="amount-to-pay">&#8369; {{(getMeetupDownpaymentAmount() | number:2)}}</span>
                                </div>
                                <div class="summary-row footer-row">
                                    <span class="small text-muted italic">Balance (to be paid at meetup)</span>
                                    <span class="small text-muted fw-bold">&#8369; {{((paymentOrder.totalAmount - getMeetupDownpaymentAmount()) | number:2)}}</span>
                                </div>
                            </div>
                            <div class="mb-3 meetup-place-block">
                                <p class="small fw-bold text-secondary mb-2">Meet up place</p>
                                <div ng-if="meetupSettings.locationName || meetupSettings.address">
                                    <p class="mb-1 fw-semibold text-dark" ng-if="meetupSettings.locationName">{{meetupSettings.locationName}}</p>
                                    <p class="mb-0 small text-muted payment-meetup-address text-break" ng-if="meetupSettings.address">{{meetupSettings.address}}</p>
                                </div>
                                <p class="mb-0 small text-muted fst-italic" ng-if="!meetupSettings.locationName && !meetupSettings.address">Venue details are not listed yet. Please contact the store or check your order confirmation.</p>
                            </div>
                            <p class="mb-2 small text-muted">Select date and time below.</p>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" ng-model="paymentFormData.meetupDate" min="{{getMinMeetupDate()}}" ng-change="onMeetupDateChange()" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Time <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" ng-model="paymentFormData.meetupTime">
                                    <option value="">-- Select time --</option>
                                    <option ng-repeat="t in meetupTimeOptions" value="{{t}}">{{t}}</option>
                                </select>
                                <p class="small text-warning mb-0 mt-1" ng-if="meetupNoSlotsForToday">No available meetup time for today. Please select another date.</p>
                            </div>
                            <div class="mt-3 pt-3 border-top meetup-downpayment-pay-info" ng-if="paymentSettings.gcash || paymentSettings.bankTransfer">
                                <p class="small fw-bold text-dark mb-2">Send your 30% down payment via GCash or bank transfer, then enter your reference number and upload proof below.</p>
                                <div ng-if="paymentSettings.gcash" class="payment-channel-detail mb-3 d-flex align-items-center flex-nowrap">
                                    <div class="qr-wrapper">
                                        <img ng-src="{{paymentSettings.gcash.qrImageUrl}}" alt="GCash QR" class="qr-image" ng-if="paymentSettings.gcash.qrImageUrl" />
                                    </div>
                                    <div class="details-wrapper ms-3">
                                        <p class="mb-1 pm-text" ng-if="paymentSettings.gcash.accountName"><strong>Account:</strong><br>{{paymentSettings.gcash.accountName}}</p>
                                        <p class="mb-0 pm-text" ng-if="paymentSettings.gcash.accountNumber"><strong>Number:</strong><br>{{paymentSettings.gcash.accountNumber}}</p>
                                    </div>
                                </div>
                                <div ng-if="paymentSettings.bankTransfer" class="payment-channel-detail mb-0 d-flex align-items-center flex-nowrap">
                                    <div class="qr-wrapper">
                                        <img ng-src="{{paymentSettings.bankTransfer.qrImageUrl}}" alt="Bank QR" class="qr-image" ng-if="paymentSettings.bankTransfer.qrImageUrl" />
                                    </div>
                                    <div class="details-wrapper ms-3">
                                        <p class="mb-1 pm-text" ng-if="paymentSettings.bankTransfer.accountName"><strong>Bank / Account:</strong><br>{{paymentSettings.bankTransfer.accountName}}</p>
                                        <p class="mb-0 pm-text" ng-if="paymentSettings.bankTransfer.accountNumber"><strong>Number:</strong><br>{{paymentSettings.bankTransfer.accountNumber}}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div ng-if="paymentFormData.channel !== 'Cash through Meetup'">
                        <p class="text-dark fst-italic small mb-2"
                           ng-if="paymentOrder
                                  && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                                  && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                                  && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit
                                  && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason">
                            <strong>Rejection reason (please fix before resubmitting):</strong>
                            {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}
                        </p>
                        <label class="section-label">Reference Number <span class="text-danger">*</span> <span class="text-muted">(letters and numbers only, max 20 characters)</span></label>
                        <input type="text" class="form-control form-control-sm mb-1" ng-model="paymentForm.referenceNumber" placeholder="Reference #" maxlength="20" autocomplete="off" ng-class="{'is-invalid': paymentValidation.reference || paymentReferenceFormatError()}" />
                        <p class="text-danger small mb-2" ng-if="paymentReferenceFormatError()">Only letters and numbers are allowed. Remove spaces and special characters.</p>
                        <p class="text-danger small mb-2" ng-if="paymentValidation.reference">{{paymentValidation.reference}}</p>
                        <p class="text-muted small mb-2" ng-if="hasValidProof() && !(paymentForm.referenceNumber && paymentForm.referenceNumber.trim()) && !paymentValidation.reference">Enter your reference number above to enable the PAY button.</p>
                        <label class="section-label">Proof of Payment <span class="text-danger">*</span></label>
                        <div class="form-group">
                            <div class="upload-wrapper">
                                <label for="proofUpload" class="custom-upload-btn" ng-class="{'custom-upload-btn-invalid': paymentValidation.file}" ng-click="triggerProofUpload(); $event.preventDefault();">
                                    <i class="bi bi-upload"></i>
                                    <span>Upload</span>
                                </label>
                                <small class="file-name-display">{{proofFileName || 'No file chosen'}}</small>
                            </div>
                            <small class="text-muted photo-limit">JPG or PNG only. Maximum size: 5MB.</small>
                            <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.proof">{{paymentValidation.proof}}</p>
                            <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.file">{{paymentValidation.file}}</p>
                        </div>
                    </div>
                    <div ng-if="paymentFormData.channel === 'Cash through Meetup'" class="mb-3">
                        <label class="section-label">30% Down Payment &#45; Reference Number <span class="text-danger">*</span> <span class="text-muted">(letters and numbers only, max 20 characters)</span></label>
                        <input type="text" class="form-control form-control-sm mb-1" ng-model="paymentForm.referenceNumber" placeholder="Reference #" maxlength="20" autocomplete="off" ng-class="{'is-invalid': paymentValidation.reference || paymentReferenceFormatError()}" />
                        <p class="text-danger small mb-2" ng-if="paymentReferenceFormatError()">Only letters and numbers are allowed. Remove spaces and special characters.</p>
                        <p class="text-danger small mb-2" ng-if="paymentValidation.reference">{{paymentValidation.reference}}</p>
                        <label class="section-label">Proof of 30% Down Payment <span class="text-danger">*</span></label>
                        <div class="form-group">
                            <div class="upload-wrapper">
                                <label for="proofUpload" class="custom-upload-btn" ng-class="{'custom-upload-btn-invalid': paymentValidation.file}" ng-click="triggerProofUpload(); $event.preventDefault();">
                                    <i class="bi bi-upload"></i>
                                    <span>Upload</span>
                                </label>
                                <small class="file-name-display">{{proofFileName || 'No file chosen'}}</small>
                            </div>
                            <small class="text-muted photo-limit">JPG or PNG only. Maximum size: 5MB.</small>
                            <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.proof">{{paymentValidation.proof}}</p>
                            <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.file">{{paymentValidation.file}}</p>
                        </div>
                    </div>
                    <p class="payment-error mt-1" ng-if="paymentError">{{paymentError}}</p>
                </div>

                <div class="pay-btn-container" ng-if="canShowPayForm()">
                    <button type="button"
                            ng-if="paymentFormData.channel !== 'Cash through Meetup'"
                            class="pay-now-btn w-100"
                            ng-click="submitPayment()"
                            ng-disabled="!isPayButtonEnabled()">
                        <span ng-if="!submitting
                                     && paymentOrder
                                     && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                                     && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                                     && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit">
                            SUBMIT RESUBMISSION
                        </span>
                        <span ng-if="!submitting
                                     && (!paymentOrder
                                         || !(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                                         || (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) !== 'REJECTED')
                                         || !(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit)">
                            PAY
                        </span>
                        <span ng-if="submitting">Submitting...</span>
                    </button>
                    <button type="button"
                            ng-if="paymentFormData.channel === 'Cash through Meetup'"
                            class="pay-now-btn w-100"
                            ng-click="submitPayment()"
                            ng-disabled="!isScheduleButtonEnabled()">
                        <span ng-if="!submitting">SCHEDULE &amp; SUBMIT PAYMENT</span>
                        <span ng-if="submitting">Submitting...</span>
                    </button>
                </div>

            </div>

        </div>
    </div>

    <div class="payment-card" ng-if="!paymentOrder && !paymentLoadError">
        <p class="text-center text-white">Loading order...</p>
    </div>
    <div class="payment-card" ng-if="paymentLoadError">
        <p class="text-center text-white">{{paymentLoadError}}</p>
        <div class="text-center mt-3">
            <a href="@Url.Action("SolteiraBrandsMyOrders", "SolteiraAndBrands")" class="btn btn-light">Back to My Orders</a>
        </div>
    </div>

    @* View Payment Proof modal (Under Review) *@
    <div class="modal fade" id="viewPaymentProofModal" tabindex="-1" aria-hidden="true" ng-if="paymentOrder && paymentOrder.latestPaymentForProof">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">View Payment Proof</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" ng-if="paymentOrder.latestPaymentForProof">
                    <p class="mb-2"><strong>Status:</strong> <span ng-class="{'text-warning': paymentOrder.latestPaymentForProof.paymentStatus === 'SUBMITTED', 'text-danger': paymentOrder.latestPaymentForProof.paymentStatus === 'REJECTED'}">{{paymentOrder.latestPaymentForProof.paymentStatus === 'SUBMITTED' ? 'Awaiting Verification' : (paymentOrder.latestPaymentForProof.paymentStatus === 'REJECTED' ? 'Rejected - Please Resubmit' : (paymentOrder.latestPaymentForProof.paymentStatus === 'VERIFIED' ? 'Verified' : 'Awaiting Verification'))}}</span></p>
                    <p class="mb-2"><strong>Amount:</strong> &#8369; {{paymentOrder.latestPaymentForProof.amount | number:2}}</p>
                    <p class="mb-2"><strong>Date submitted:</strong> {{paymentOrder.latestPaymentForProof.createdAt}}</p>
                    <p class="mb-2" ng-if="paymentOrder.latestPaymentForProof.referenceNumber"><strong>Reference number:</strong> {{paymentOrder.latestPaymentForProof.referenceNumber}}</p>
                    <div class="mb-2" ng-if="paymentOrder.latestPaymentForProof.proofImageUrl">
                        <strong>Uploaded image</strong>
                        <img ng-src="{{paymentOrder.latestPaymentForProof.proofImageUrl}}" alt="Proof" class="img-fluid rounded border mt-1" style="max-height: 280px;" />
                    </div>
                    <p class="text-dark mb-0" ng-if="paymentOrder.latestPaymentForProof.paymentStatus === 'REJECTED' && paymentOrder.latestPaymentForProof.rejectionReason"><strong>Rejection reason:</strong> {{paymentOrder.latestPaymentForProof.rejectionReason}}</p>
                </div>
                <div class="modal-footer"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('proofUpload');
        if (input) {
            input.addEventListener('change', function (e) {
                var file = e.target.files[0];
                if (file && window.angular && window.angular.element) {
                    var el = document.querySelector('[ng-controller="SolteiraBrandsController"]');
                    if (el) {
                        var scope = window.angular.element(el).scope();
                        if (scope && scope.onProofFileSelected) {
                            scope.$apply(function () { scope.onProofFileSelected(file); });
                        }
                    }
                }
                input.value = '';
            });
        }
    })();
</script>
