@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/PaymentStyle.css" />

<div class="payment-page-container" ng-controller="SolteiraBrandsController" ng-init="initPaymentPage()">
    <input type="file" id="proofUpload" accept=".jpg,.jpeg,.png" style="display:none;" />

    <div class="payment-card" ng-if="paymentOrder">
        <h2 class="payment-title">PAYMENT</h2>

        @* Order Rejected: show only this, no payment banners. *@
        <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') === 'REJECTED')" class="alert alert-danger mb-3">
            <strong>Order Rejected.</strong> This order was rejected by admin.
        </div>
        <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') === 'PENDING APPROVAL')" class="alert alert-warning mb-3">
            <strong>Order not yet approved.</strong> Your order is pending admin approval. After approval you can pay here.
            <button type="button" class="btn btn-sm btn-outline-dark ms-2" ng-click="reloadPaymentOrder()">Refresh</button>
        </div>
        @* Payment banners only when order is NOT rejected. *@
        <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') !== 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof) && ((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus === 'REJECTED' || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus === 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit" class="alert alert-danger mb-3">
            <strong>Payment was rejected. Please resubmit.</strong>
            <span ng-if="(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason"> {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}</span>
        </div>
        <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') !== 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof) && ((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus === 'REJECTED' || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus === 'REJECTED') && !(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit" class="alert alert-danger mb-3">
            <strong>Payment was rejected and cannot be resubmitted.</strong>
            <span ng-if="(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason"> {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}</span>
            <span class="d-block">Please contact the administrator for assistance.</span>
        </div>
        <div ng-if="paymentOrder && ((paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase().replace(/\s+/g, ' ') !== 'REJECTED') && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof) && ((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus === 'SUBMITTED' || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus === 'SUBMITTED')" class="alert alert-warning mb-3">
            <strong>Your payment is under review.</strong>
            <button type="button" class="btn btn-sm btn-outline-dark ms-2" ng-click="openViewPaymentProofModal()">View Payment Proof</button>
            <a href="@Url.Action("SolteiraBrandsMyOrders", "SolteiraAndBrands")" class="btn btn-sm btn-outline-dark ms-2">Back to My Orders</a>
        </div>
        <div ng-if="paymentOrder && (paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'AWAITING MEETUP'" class="alert alert-info mb-3">
            <strong>Meetup scheduled.</strong> Your Cash through Meetup schedule has been saved. Please proceed on your selected date and time.
            <a href="@Url.Action("SolteiraBrandsMyOrders", "SolteiraAndBrands")" class="btn btn-sm btn-outline-dark ms-2">Back to My Orders</a>
        </div>

        <div class="customer-info-box">
            <div class="info-details">
                <p class="cust-name">{{paymentOrder.customerName}}</p>
                <p class="cust-phoneNum">{{paymentOrder.contactNumber}}</p>
                <p class="cust-address">{{paymentOrder.deliveryAddress}}</p>
            </div>
            <div class="payment-order-summary">
                <p class="section-label">Order summary</p>
                <div class="payment-order-item" ng-repeat="item in paymentOrder.items">
                    <span>{{item.name}} x {{item.qty}}</span>
                    <span>&#8369; {{(item.price * item.qty) | number:2}}</span>
                </div>
            </div>
            <div class="price-display">
                <p ng-if="paymentOrder.paymentType === 'FULL'"><strong>Price:</strong> <span class="amount-to-pay">&#8369; {{paymentOrder.amountDue | number:2}}</span></p>
                <div ng-if="paymentOrder.paymentType === 'LAYAWAY'" class="layaway-price-grid">
                    <p><strong>Total Amount:</strong> <span>&#8369; {{paymentOrder.totalAmount | number:2}}</span></p>
                    <p><strong>Downpayment ({{paymentOrder.downpaymentPercentage || 30}}%):</strong> <span>&#8369; {{(paymentOrder.totalAmount * (paymentOrder.downpaymentPercentage || 30) / 100) | number:2}}</span></p>
                    <p><strong>Remaining Balance:</strong> <span>&#8369; {{paymentOrder.remainingBalance | number:2}}</span></p>
                    <p ng-if="paymentOrder.monthsAllowed"><strong>Installment Plan:</strong> <span>{{paymentOrder.monthsAllowed}} months</span></p>
                    <p ng-if="paymentOrder.monthlyInstallment != null"><strong>Monthly Installment:</strong> <span>&#8369; {{paymentOrder.monthlyInstallment | number:2}} per month</span></p>
                    <p ng-if="paymentOrder.installmentsRemaining != null"><strong>Installments Remaining:</strong> <span>{{paymentOrder.installmentsRemaining}}</span></p>
                    <p ng-if="(paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'APPROVED' || (paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'REJECTED'"><strong>Amount Due (Downpayment):</strong> <span class="amount-to-pay">&#8369; {{paymentOrder.amountDue | number:2}}</span></p>
                    <p ng-if="(paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'LAYAWAY ACTIVE' && paymentOrder.installmentMonthNumber"><strong>Amount Due (Month {{paymentOrder.installmentMonthNumber}} of {{paymentOrder.monthsAllowed}}):</strong> <span class="amount-to-pay">&#8369; {{paymentOrder.amountDue | number:2}}</span></p>
                    <p ng-if="(paymentOrder.order_status || paymentOrder.orderStatus || '').toUpperCase() === 'LAYAWAY ACTIVE' && paymentOrder.dueDateThisMonth"><strong>Due Date:</strong> <span>{{paymentOrder.dueDateThisMonth}}</span></p>
                    <div class="layaway-progress" ng-if="paymentOrder.totalAmount && paymentOrder.remainingBalance != null">
                        <div class="layaway-progress-label">
                            <span>{{getLayawayPaidPercent() | number:2}}% PAID</span>
                        </div>
                        <div class="layaway-progress-bar">
                            <div class="layaway-progress-fill" ng-style="{'width': getLayawayPaidPercent() + '%'}"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Notice box consolidating rejection context (top of white container) *@
        <div class="alert alert-danger mb-3"
             ng-if="paymentOrder
                    && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                    && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                    && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit">
            <p class="mb-1 fst-italic">
                <strong>Rejection reason:</strong>
                {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}
            </p>
            <button type="button"
                    class="btn btn-sm btn-outline-light"
                    ng-click="openViewPaymentProofModal()">
                View Rejected Proof
            </button>
        </div>

        <div class="payment-methods-box" ng-if="canShowPayForm()">
            @* Resubmit path: static channel (no radios), using last rejected payment's channel *@
            <div ng-if="paymentOrder
                        && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                        && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                        && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit">
                <div class="mb-2">
                    <span class="section-label d-block mb-1">Payment Channel</span>
                    <span class="fw-bold">{{paymentFormData.channel}}</span>
                </div>

                <div ng-if="paymentFormData.channel === 'GCash' && paymentSettings.gcash" class="mb-3">
                    <img ng-src="{{paymentSettings.gcash.qrImageUrl}}" alt="GCash QR" class="img-fluid rounded" style="max-height:180px;" ng-if="paymentSettings.gcash.qrImageUrl" />
                    <p class="mb-0 small mt-1" ng-if="paymentSettings.gcash.accountName"><strong>Account:</strong> {{paymentSettings.gcash.accountName}}</p>
                    <p class="mb-0 small" ng-if="paymentSettings.gcash.accountNumber"><strong>Number:</strong> {{paymentSettings.gcash.accountNumber}}</p>
                </div>
                <div ng-if="paymentFormData.channel === 'Bank Transfer' && paymentSettings.bankTransfer" class="mb-3">
                    <img ng-src="{{paymentSettings.bankTransfer.qrImageUrl}}" alt="Bank QR" class="img-fluid rounded" style="max-height:180px;" ng-if="paymentSettings.bankTransfer.qrImageUrl" />
                    <p class="mb-0 small mt-1" ng-if="paymentSettings.bankTransfer.accountName"><strong>Bank / Account:</strong> {{paymentSettings.bankTransfer.accountName}}</p>
                    <p class="mb-0 small" ng-if="paymentSettings.bankTransfer.accountNumber"><strong>Number:</strong> {{paymentSettings.bankTransfer.accountNumber}}</p>
                </div>
                <div ng-if="paymentFormData.channel === 'Cash through Meetup'" class="mb-3 p-3 rounded" style="background:#f8f9fa;">
                    <p class="small fw-bold text-secondary mb-2">Down payment</p>
                    <div class="mb-3">
                        <p class="mb-0"><strong>Total Amount:</strong> &#8369; {{(paymentOrder.totalAmount | number:2)}}</p>
                        <p class="mb-0"><strong>30% Down Payment Required:</strong> &#8369; {{(getMeetupDownpaymentAmount() | number:2)}}</p>
                        <p class="mb-0"><strong>Remaining Balance (to be paid at meetup):</strong> &#8369; {{((paymentOrder.totalAmount - getMeetupDownpaymentAmount()) | number:2)}}</p>
                    </div>
                    <p class="mb-1" ng-if="meetupSettings.locationName || meetupSettings.address"><strong>Location:</strong> <span class="amount-to-pay">{{meetupSettings.locationName}}</span></p>
                    <p class="mb-2 small text-muted" ng-if="meetupSettings.address">{{meetupSettings.address}}</p>
                    <p class="mb-2 small text-muted" ng-if="!meetupSettings.locationName && !meetupSettings.address">Select date and time below.</p>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" ng-model="paymentFormData.meetupDate" min="{{getMinMeetupDate()}}" ng-change="onMeetupDateChange()" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Time <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" ng-model="paymentFormData.meetupTime">
                            <option value="">-- Select time --</option>
                            <option ng-repeat="t in meetupTimeOptions" value="{{t}}">{{t}}</option>
                        </select>
                        <p class="small text-warning mb-0 mt-1" ng-if="meetupNoSlotsForToday">No available meetup time for today. Please select another date.</p>
                    </div>
                </div>
            </div>

            @* Initial payment path: full method + channel selection as before *@
            <div ng-if="!(paymentOrder
                        && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                        && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                        && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit)">
                <label class="section-label">Payment Method <span class="text-danger">*</span></label>
                <div class="form-check mb-1" ng-class="{'payment-method-disabled': paymentOrder.paymentType === 'LAYAWAY'}">
                    <input type="radio" name="paymentMode" id="pmFull" value="Full Payment" ng-model="paymentMode" class="form-check-input" />
                    <label for="pmFull" class="form-check-label">Full Payment</label>
                </div>
                <div class="form-check mb-2" ng-class="{'payment-method-disabled': paymentOrder.paymentType === 'FULL'}">
                    <input type="radio" name="paymentMode" id="pmLayaway" value="Layaway" ng-model="paymentMode" class="form-check-input" />
                    <label for="pmLayaway" class="form-check-label">Layaway</label>
                </div>

                <label class="section-label mt-2">Channel <span class="text-danger">*</span></label>
                <div class="form-check mb-1">
                    <input type="radio" name="paymentChannel" id="chGcash" value="GCash" ng-model="paymentFormData.channel" class="form-check-input" />
                    <label for="chGcash" class="form-check-label">GCash</label>
                </div>
                <div class="form-check mb-1">
                    <input type="radio" name="paymentChannel" id="chBank" value="Bank Transfer" ng-model="paymentFormData.channel" class="form-check-input" />
                    <label for="chBank" class="form-check-label">Bank Transfer</label>
                </div>
                <div class="form-check mb-2" ng-if="paymentOrder.paymentType !== 'LAYAWAY'">
                    <input type="radio" name="paymentChannel" id="chMeetup" value="Cash through Meetup" ng-model="paymentFormData.channel" class="form-check-input" />
                    <label for="chMeetup" class="form-check-label">Cash through Meetup</label>
                </div>

                <div ng-if="paymentFormData.channel === 'GCash' && paymentSettings.gcash" class="mb-3">
                    <img ng-src="{{paymentSettings.gcash.qrImageUrl}}" alt="GCash QR" class="img-fluid rounded" style="max-height:180px;" ng-if="paymentSettings.gcash.qrImageUrl" />
                    <p class="mb-0 small mt-1" ng-if="paymentSettings.gcash.accountName"><strong>Account:</strong> {{paymentSettings.gcash.accountName}}</p>
                    <p class="mb-0 small" ng-if="paymentSettings.gcash.accountNumber"><strong>Number:</strong> {{paymentSettings.gcash.accountNumber}}</p>
                </div>
                <div ng-if="paymentFormData.channel === 'Bank Transfer' && paymentSettings.bankTransfer" class="mb-3">
                    <img ng-src="{{paymentSettings.bankTransfer.qrImageUrl}}" alt="Bank QR" class="img-fluid rounded" style="max-height:180px;" ng-if="paymentSettings.bankTransfer.qrImageUrl" />
                    <p class="mb-0 small mt-1" ng-if="paymentSettings.bankTransfer.accountName"><strong>Bank / Account:</strong> {{paymentSettings.bankTransfer.accountName}}</p>
                    <p class="mb-0 small" ng-if="paymentSettings.bankTransfer.accountNumber"><strong>Number:</strong> {{paymentSettings.bankTransfer.accountNumber}}</p>
                </div>
                <div ng-if="paymentFormData.channel === 'Cash through Meetup'" class="mb-3 p-3 rounded" style="background:#f8f9fa;">
                    <p class="small fw-bold text-secondary mb-2">Down payment</p>
                    <div class="mb-3">
                        <p class="mb-0"><strong>Total Amount:</strong> &#8369; {{(paymentOrder.totalAmount | number:2)}}</p>
                        <p class="mb-0"><strong>30% Down Payment Required:</strong> &#8369; {{(getMeetupDownpaymentAmount() | number:2)}}</p>
                        <p class="mb-0"><strong>Remaining Balance (to be paid at meetup):</strong> &#8369; {{((paymentOrder.totalAmount - getMeetupDownpaymentAmount()) | number:2)}}</p>
                    </div>
                    <p class="mb-1" ng-if="meetupSettings.locationName || meetupSettings.address"><strong>Location:</strong> <span class="amount-to-pay">{{meetupSettings.locationName}}</span></p>
                    <p class="mb-2 small text-muted" ng-if="meetupSettings.address">{{meetupSettings.address}}</p>
                    <p class="mb-2 small text-muted" ng-if="!meetupSettings.locationName && !meetupSettings.address">Select date and time below.</p>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" ng-model="paymentFormData.meetupDate" min="{{getMinMeetupDate()}}" ng-change="onMeetupDateChange()" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Time <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" ng-model="paymentFormData.meetupTime">
                            <option value="">-- Select time --</option>
                            <option ng-repeat="t in meetupTimeOptions" value="{{t}}">{{t}}</option>
                        </select>
                        <p class="small text-warning mb-0 mt-1" ng-if="meetupNoSlotsForToday">No available meetup time for today. Please select another date.</p>
                    </div>
                </div>
            </div>

            <div ng-if="paymentFormData.channel !== 'Cash through Meetup'">
                <p class="text-danger fst-italic small mb-2"
                   ng-if="paymentOrder
                          && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                          && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                          && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit
                          && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason">
                    <strong>Rejection reason (please fix before resubmitting):</strong>
                    {{(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).rejectionReason}}
                </p>
                <label class="section-label">Reference Number <span class="text-danger">*</span> <span class="text-muted">(max 20 characters)</span></label>
                <input type="text" class="form-control form-control-sm mb-1" ng-model="paymentForm.referenceNumber" placeholder="Reference #" maxlength="20" ng-class="{'is-invalid': paymentValidation.reference}" />
                <p class="text-danger small mb-2" ng-if="paymentValidation.reference">{{paymentValidation.reference}}</p>
                <p class="text-muted small mb-2" ng-if="hasValidProof() && !(paymentForm.referenceNumber && paymentForm.referenceNumber.trim()) && !paymentValidation.reference">Enter your reference number above to enable the PAY button.</p>
                <label class="section-label">Proof of Payment <span class="text-danger">*</span></label>
                <div class="form-group">
                    <div class="upload-wrapper">
                        <label for="proofUpload" class="custom-upload-btn" ng-click="triggerProofUpload(); $event.preventDefault();">
                            <i class="bi bi-upload"></i>
                            <span>Upload</span>
                        </label>
                        <small class="file-name-display">{{proofFileName || 'No file chosen'}}</small>
                    </div>
                    <small class="text-muted photo-limit">JPG or PNG only. Maximum size: 5MB. PDF is not accepted.</small>
                    <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.proof">{{paymentValidation.proof}}</p>
                    <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.file">{{paymentValidation.file}}</p>
                </div>
            </div>
            <div ng-if="paymentFormData.channel === 'Cash through Meetup'" class="mb-3">
                <label class="section-label">30% Down Payment &#45; Reference Number <span class="text-danger">*</span> <span class="text-muted">(max 20 characters)</span></label>
                <input type="text" class="form-control form-control-sm mb-1" ng-model="paymentForm.referenceNumber" placeholder="Reference #" maxlength="20" ng-class="{'is-invalid': paymentValidation.reference}" />
                <p class="text-danger small mb-2" ng-if="paymentValidation.reference">{{paymentValidation.reference}}</p>
                <label class="section-label">Proof of 30% Down Payment <span class="text-danger">*</span></label>
                <div class="form-group">
                    <div class="upload-wrapper">
                        <label for="proofUpload" class="custom-upload-btn" ng-click="triggerProofUpload(); $event.preventDefault();">
                            <i class="bi bi-upload"></i>
                            <span>Upload</span>
                        </label>
                        <small class="file-name-display">{{proofFileName || 'No file chosen'}}</small>
                    </div>
                    <small class="text-muted photo-limit">JPG or PNG only. Maximum size: 5MB.</small>
                    <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.proof">{{paymentValidation.proof}}</p>
                    <p class="text-danger small mt-1 mb-0" ng-if="paymentValidation.file">{{paymentValidation.file}}</p>
                </div>
            </div>
            <p class="payment-error mt-1" ng-if="paymentError">{{paymentError}}</p>
        </div>

        <div class="pay-btn-container" ng-if="canShowPayForm()">
            <button type="button"
                    ng-if="paymentFormData.channel !== 'Cash through Meetup'"
                    class="pay-now-btn w-100"
                    ng-click="submitPayment()"
                    ng-disabled="!isPayButtonEnabled()">
                <span ng-if="!submitting
                             && paymentOrder
                             && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                             && (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) === 'REJECTED')
                             && (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit">
                    SUBMIT RESUBMISSION
                </span>
                <span ng-if="!submitting
                             && (!paymentOrder
                                 || !(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof)
                                 || (((paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).paymentStatus || (paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).PaymentStatus) !== 'REJECTED')
                                 || !(paymentOrder.latestPaymentForProof || paymentOrder.LatestPaymentForProof).allowResubmit)">
                    PAY
                </span>
                <span ng-if="submitting">Submitting...</span>
            </button>
            <button type="button"
                    ng-if="paymentFormData.channel === 'Cash through Meetup'"
                    class="pay-now-btn w-100"
                    ng-click="submitPayment()"
                    ng-disabled="!isScheduleButtonEnabled()">
                <span ng-if="!submitting">SCHEDULE &amp; SUBMIT PAYMENT</span>
                <span ng-if="submitting">Submitting...</span>
            </button>
        </div>
    </div>

    <div class="payment-card" ng-if="!paymentOrder && !paymentLoadError">
        <p class="text-center text-white">Loading order...</p>
    </div>
    <div class="payment-card" ng-if="paymentLoadError">
        <p class="text-center text-white">{{paymentLoadError}}</p>
        <div class="text-center mt-3">
            <a href="@Url.Action("SolteiraBrandsMyOrders", "SolteiraAndBrands")" class="btn btn-light">Back to My Orders</a>
        </div>
    </div>

    @* View Payment Proof modal (Under Review) *@
    <div class="modal fade" id="viewPaymentProofModal" tabindex="-1" aria-hidden="true" ng-if="paymentOrder && paymentOrder.latestPaymentForProof">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">View Payment Proof</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" ng-if="paymentOrder.latestPaymentForProof">
                    <p class="mb-2"><strong>Status:</strong> <span ng-class="{'text-warning': paymentOrder.latestPaymentForProof.paymentStatus === 'SUBMITTED', 'text-danger': paymentOrder.latestPaymentForProof.paymentStatus === 'REJECTED'}">{{paymentOrder.latestPaymentForProof.paymentStatus === 'SUBMITTED' ? 'Awaiting Verification' : (paymentOrder.latestPaymentForProof.paymentStatus === 'REJECTED' ? 'Rejected - Please Resubmit' : (paymentOrder.latestPaymentForProof.paymentStatus === 'VERIFIED' ? 'Verified' : 'Awaiting Verification'))}}</span></p>
                    <p class="mb-2"><strong>Amount:</strong> &#8369; {{paymentOrder.latestPaymentForProof.amount | number:2}}</p>
                    <p class="mb-2"><strong>Date submitted:</strong> {{paymentOrder.latestPaymentForProof.createdAt}}</p>
                    <p class="mb-2" ng-if="paymentOrder.latestPaymentForProof.referenceNumber"><strong>Reference number:</strong> {{paymentOrder.latestPaymentForProof.referenceNumber}}</p>
                    <div class="mb-2" ng-if="paymentOrder.latestPaymentForProof.proofImageUrl">
                        <strong>Uploaded image</strong>
                        <img ng-src="{{paymentOrder.latestPaymentForProof.proofImageUrl}}" alt="Proof" class="img-fluid rounded border mt-1" style="max-height: 280px;" />
                    </div>
                    <p class="text-danger mb-0" ng-if="paymentOrder.latestPaymentForProof.paymentStatus === 'REJECTED' && paymentOrder.latestPaymentForProof.rejectionReason"><strong>Rejection reason:</strong> {{paymentOrder.latestPaymentForProof.rejectionReason}}</p>
                </div>
                <div class="modal-footer"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('proofUpload');
        if (input) {
            input.addEventListener('change', function (e) {
                var file = e.target.files[0];
                if (file && window.angular && window.angular.element) {
                    var el = document.querySelector('[ng-controller="SolteiraBrandsController"]');
                    if (el) {
                        var scope = window.angular.element(el).scope();
                        if (scope && scope.onProofFileSelected) {
                            scope.$apply(function () { scope.onProofFileSelected(file); });
                        }
                    }
                }
                input.value = '';
            });
        }
    })();
</script>
