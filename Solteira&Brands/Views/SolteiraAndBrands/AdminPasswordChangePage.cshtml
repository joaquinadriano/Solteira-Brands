@{
    Layout = "~/Views/Shared/_SABInventoryLoginLayout.cshtml";
}
<div class="container container-password d-flex align-items-center justify-content-center">
    <div class="row password-row shadow">
        <div class="col-md-6 password-left d-flex align-items-center justify-content-center py-5">
            <img src="@Url.Content("~/Content/img/solteira-logo.png")"
                 class="img-fluid password-logo-img" />
        </div>

        <div class="col-md-6 password-right d-flex align-items-center justify-content-center">
            <div>
                <p class="password-title text-center mb-0">CREATE YOUR</p>
                <p class="password-title text-center mb-0">PERMANENT PASSWORD</p>
                <p class="password-subtitle text-center mt-2 px-5">
                    Please enter your chosen password to proceed:
                </p>

                <form class="px-4 pt-2">
                    <div class="mb-3">
                        <label class="form-label-adminPassword">Temporary Password<span class="text-danger">*</span></label>
                        <input type="text" class="form-control border-input-password" placeholder="Enter temporary password">
                    </div>

                    <div class="mb-4">
                        <label class="form-label-adminPassword">Permanent Password<span class="text-danger">*</span></label>
                        <input type="password" class="form-control border-input-password" placeholder="Enter your own password">
                    </div>

                    <div class="d-flex justify-content-center">
                        <button class="btn admin-password-button rounded-0">
                            LOGIN
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
