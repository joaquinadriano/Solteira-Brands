@{
    Layout = "~/Views/Shared/_SABInventoryDashboardLayout.cshtml";
}
<div class="main-content">
    <div class="container-fluid dashboard-container">
        <div class="row px-4 pb-0 mb-0">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Dashboard</p>
            </div>
            @*----------Date and Time----------*@
            <div class="col">
                <p class="h1  h4 ps-0 ms-0 text-end">11/17/2024, 4:23PM</p>
            </div>
        </div>
        <div class="row px-5">
            @*----------Cards----------*@
            @*---------first card---------*@
            <div class="d-flex justify-content-center">
                <div class="col-6 dashboard-card-container ">
                    <div class="row dashboard-card-content ">
                        <div class="col dashboard-card-content vl-right">
                            <p>Total Sales</p>
                            <p>
                                ₱248, 320.00
                            </p>
                        </div>
                        <div class="col dashboard-card-content vl-left">
                            <p>Product Sold</p>
                            <p>12</p>
                        </div>
                    </div>
                </div>
                @*---------second card---------*@
                <div class="col-6 dashboard-card-container ">
                    <div class="row dashboard-card-content-2">
                        <div class="col d-flex align-items-center justify-content-center">
                            <p class="dashboard-card2-title">Orders</p>
                        </div>
                        <div class="col dashboard-card-content-2 vl-right">
                            <p>3</p>
                            <p>Pending</p>
                        </div>
                        <div class="col dashboard-card-content-2 vl-left vl-right">
                            <p>2</p>
                            <p>Approved</p>
                        </div>
                        <div class="col dashboard-card-content-2 vl-left">
                            <p>6</p>
                            <p>Shipped</p>
                        </div>
                    </div>
                </div>
                @*----------Cards end----------*@
            </div>
        </div>

        @*----------Charts------------*@
        <div class="row p-5">
            <div class="col-6">
                <p class="fw-bold text-center h4">Total Sales This Month (Daily Breakdown)</p>
        @*----------Line Chart----------*@
        <canvas id="line" class="chart chart-line" chart-data="data"
                    chart-labels="labels" chart-series="series" chart-options="options"
                    chart-dataset-override="datasetOverride" chart-click="onClick">
            </canvas>
        </div>
        <div class="col-6">
            <p class="fw-bold text-center h4">Sales by Category</p>
        @*----------Pie Chart----------*@
        <canvas id="pie" class="chart chart-pie"
                        chart-data="data" chart-labels="labels" chart-options="options">
                </canvas>
            </div>
        </div>
        @*----------Charts end------------*@

        @*----------Table----------*@
        <div class="row  px-5 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="userTable">
                    <thead>
                        <tr>
                            <th colspan=5 class="text-start h5">Inventory Stock</th>
                        </tr>
                        <tr>
                            <th>Photo</th>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">

                        @*Temporary Data *Please modify once the database is implemented**@
                        <tr>
                            <td>Photo</td>
                            <td>P-001</td>
                            <td>Many Shape Tennis</td>
                            <td>3</td>
                            <td>Low Stock</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                            <td>Low Stock</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                            <td>Low Stock</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col">
                <table class="table table-responsive text-center" id="usersTable">
                    <thead>
                        <tr>
                            <th colspan=4 class="text-center h5">Top Selling Products</th>
                        </tr>
                        <tr>
                            <th>Photo</th>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Number of Sold</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*----------Table end----------*@
    </div>

    /tae
</div>