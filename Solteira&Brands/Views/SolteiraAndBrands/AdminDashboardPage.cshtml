                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                            <td>Low Stock</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                            <td>Low Stock</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col">
                <table class="table table-responsive text-center" id="usersTable">
                    <thead>
                        <tr>
                            <th colspan=4 class="text-center h5">Top Selling Products</th>
                        </tr>
                        <tr>
                            <th>Photo</th>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Number of Sold</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                        </tr>
                        <tr>
                            <td>Photo</td>
                            <td>P-002</td>
                            <td>Heart Ring Tennis</td>
                            <td>5</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*----------Table end----------*@
    </div>
</div>