@{
    Layout = User.IsInRole("ADMIN") ? "~/Views/Shared/_AdminLayout.cshtml"
        : (User.IsInRole("STAFF") ? "~/Views/Shared/_StaffLayout.cshtml" : "~/Views/Shared/_OperationsLayout.cshtml");
    var canManagePolicies = User.IsInRole("ADMIN") || User.IsInRole("MANAGER");
}
<div class="main-content" ng-init="loadDashboardData()">
    <div class="container-fluid dashboard-container">
        <div class="row px-4 pb-0 mb-0">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Dashboard</p>
                <div class="d-flex align-items-start flex-wrap gap-2 mt-2">
                    <div class="d-flex flex-column">
                        <div class="d-flex align-items-center">
                            <label class="fw-semibold mb-0 me-2" style="font-size: 1rem;">Filter:</label>
                            <select class="form-select form-select-sm" style="width: auto; max-width: 180px;" ng-model="dashboardRange" ng-change="onDashboardRangeChange()">
                                <option value="daily">Daily</option>
                                <option value="monthly">Monthly</option>
                                <option value="custom">Custom range</option>
                                <option value="all">All</option>
                            </select>
                        </div>
                        <span class="mt-1" style="font-size: 0.7rem; color: #adb5bd; padding-left: 3.6rem;" ng-if="(dashboardRange || '').toLowerCase() === 'all'">From January 2026 to present</span>
                    </div>

                    @* Daily preset *@
                    <div class="align-items-center gap-2 flex-wrap"
                         ng-class="((dashboardRange || '').toLowerCase() === 'daily' ? 'd-flex' : 'd-none')">
                        <select class="form-select form-select-sm" style="width: auto; max-width: 180px;" ng-model="dashboardPreset" ng-change="loadDashboardData()">
                            <option value="today">Today</option>
                            <option value="yesterday">Yesterday</option>
                        </select>
                    </div>

                    @* Monthly preset *@
                    <div class="align-items-center gap-2 flex-wrap"
                         ng-class="((dashboardRange || '').toLowerCase() === 'monthly' ? 'd-flex' : 'd-none')">
                        <select class="form-select form-select-sm" style="width: auto; max-width: 180px;" ng-model="dashboardPreset" ng-change="loadDashboardData()">
                            <option value="thismonth">This month</option>
                            <option value="lastmonth">Last month</option>
                        </select>
                    </div>

                    @* Custom range *@
                    <div class="align-items-center gap-2 flex-wrap"
                         ng-class="((dashboardRange || '').toLowerCase() === 'custom' ? 'd-flex' : 'd-none')">
                        <input id="dashboardStartDate" type="date" class="form-control form-control-sm" style="width: auto;" ng-model="customStartDate" placeholder="From" ng-change="onDashboardCustomDatesChanged()" />
                        <span class="text-muted">to</span>
                        <input id="dashboardEndDate" type="date" class="form-control form-control-sm" style="width: auto;" ng-model="customEndDate" placeholder="To" ng-change="onDashboardCustomDatesChanged()" />
                        <span class="text-muted small">Loads when both dates are set</span>
                    </div>
                </div>
            </div>
            <div class="col">
                <p class="h1 h4 ps-0 ms-0 text-end">{{dashboardDate}}</p>
                @if (canManagePolicies)
                {
                    <div class="d-flex justify-content-end flex-wrap gap-2" style="margin-top: 0.65rem;">
                        <button type="button"
                                class="btn btn-success btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#policySettingsModal"
                                ng-click="openPolicySettingsModal('termsAndConditionsEditor')">
                            <i class="bi bi-file-earmark-text me-1"></i>Manage Terms &amp; Conditions
                        </button>
                    </div>
                }
            </div>
        </div>
        <div class="row px-5">
            <div class="d-flex justify-content-center px-5">
                <div class="col-3 dashboard-card-container-1 ">
                    <div class="row dashboard-card-content ">
                        <div class="col dashboard-card-content">
                            <p><i class="bi bi-cash-stack me-3"></i>Total Sales</p>
                            <p>&#8369; {{dashboardStats.totalSales | number:2}}</p>
                        </div>
                    </div>
                </div>
                <div class="col-3 dashboard-card-container ">
                    <div class="row dashboard-card-content ">
                        <div class="col dashboard-card-content">
                            <p><i class="bi bi-tags  me-3"></i>Product Sold</p>
                            <p>{{dashboardStats.productSold}}</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 dashboard-card-container ">
                    <div class="row dashboard-card-content-2">
                        <div class="col d-flex align-items-center justify-content-center">
                            <p class="dashboard-card2-title"><i class="bi bi-cart-check  me-3"></i>Orders</p>
                        </div>
                        <div class="col dashboard-card-content-2 vl-right">
                            <p>{{dashboardStats.pendingOrders}}</p>
                            <p>Pending</p>
                        </div>
                        <div class="col dashboard-card-content-2 vl-left vl-right">
                            <p>{{dashboardStats.approvedOrders}}</p>
                            <p>Approved</p>
                        </div>
                        <div class="col dashboard-card-content-2 vl-left">
                            <p>{{dashboardStats.shippedOrders}}</p>
                            <p>Shipped</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*----------Charts------------*@
        <div class="row p-5 charts-row">
            <div class="dashboard-chart-1">
                <p class="fw-bold text-center h4">{{totalSalesBreakdownTitle || 'Total Sales (Breakdown)'}}</p>
                @*----------Line Chart----------*@
                <div class="chart-container chart-container--line">
                    <canvas id="line" class="chart chart-line" chart-data="lineData"
                            chart-labels="lineLabels" chart-series="series" chart-options="lineOptions"
                            chart-dataset-override="datasetOverride" chart-colors="lineChartColors" chart-click="onClick">
                    </canvas>
                </div>
            </div>
            <div class=" dashboard-chart-2">
                <p class="fw-bold text-center h4">Sales by Category</p>
                @*----------Pie Chart----------*@
                <div class="chart-container chart-container--pie">
                    <canvas id="pie" class="chart chart-pie" ng-if="pieLabels.length && pieData.length"
                            chart-data="pieData" chart-labels="pieLabels" chart-options="pieOptions">
                    </canvas>
                    <p ng-if="!pieLabels.length || !pieData.length" class="text-muted text-center py-5 mb-0">Loading chart...</p>
                </div>
            </div>
        </div>
        @*----------Charts end------------*@

        @*----------Table----------*@
        <div class="row  px-5 pt-1 table-row1">
            <div class=" table-col-1">
                <table class="table table-responsive text-center" id="dashboardInventoryTable">
                    <thead>
                        <tr>
                            <th colspan="5" class="text-center h6">Inventory Stock</th>
                        </tr>
                        <tr>
                            <th>Photo</th>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <tr ng-repeat="item in dashboardInventoryStock">
                            <td>
                                <img ng-src="{{item.imageUrl || dashboardDefaultProductImage}}" alt="" style="max-width: 50px; max-height: 50px; object-fit: contain;" />
                            </td>
                            <td>P-{{item.id | numberPad:3}}</td>
                            <td>{{item.name}}</td>
                            <td>{{item.stockQuantity}}</td>
                            <td>{{getStockStatus(item.stockQuantity)}}</td>
                        </tr>
                        <tr ng-if="dashboardInventoryStock.length === 0">
                            <td colspan="5" class="text-muted py-3">No low-stock or out-of-stock products.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="  table-col-2">
                <table class="table table-responsive text-center" id="dashboardTopSellingTable">
                    <thead>
                        <tr>
                            <th colspan=4 class="text-center h6">Top Selling Products</th>
                        </tr>
                        <tr>
                            <th>Photo</th>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Number of Sold</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <tr ng-repeat="item in dashboardTopSelling">
                            <td>
                                <img ng-src="{{item.imageUrl || dashboardDefaultProductImage}}" alt="" style="max-width: 50px; max-height: 50px; object-fit: contain;" />
                            </td>
                            <td>P-{{item.id | numberPad:3}}</td>
                            <td>{{item.name}}</td>
                            <td>{{item.totalSold}}</td>
                        </tr>
                        <tr ng-if="dashboardTopSelling.length === 0">
                            <td colspan="4" class="text-muted py-3">No sales yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*----------Table end----------*@
    </div>
</div>
@if (canManagePolicies)
{
    <div class="modal fade" id="policySettingsModal" tabindex="-1" aria-labelledby="policySettingsModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title fw-bold" id="policySettingsModalLabel">Manage Terms, Privacy, and Payment Conditions</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Only managers and system admins can update these storefront policies.</p>

                    <div class="border rounded p-3 mb-3">
                        <h6 class="fw-bold mb-2">1. Terms &amp; Conditions (Registration)</h6>
                        <textarea id="termsAndConditionsEditor"
                                  class="form-control form-control-sm"
                                  rows="8"
                                  maxlength="12000"
                                  ng-model="policySettingsForm.termsAndConditions"
                                  placeholder="Enter terms and conditions text"></textarea>
                        <div class="text-end mt-2">
                            <button type="button" class="btn btn-success btn-sm" ng-click="savePolicySetting('TERMS_AND_CONDITIONS', 'termsAndConditions')">Save Terms</button>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <h6 class="fw-bold mb-2">2. Privacy Policy (Registration)</h6>
                        <textarea id="privacyPolicyEditor"
                                  class="form-control form-control-sm"
                                  rows="8"
                                  maxlength="12000"
                                  ng-model="policySettingsForm.privacyPolicy"
                                  placeholder="Enter privacy policy text"></textarea>
                        <div class="text-end mt-2">
                            <button type="button" class="btn btn-success btn-sm" ng-click="savePolicySetting('PRIVACY_POLICY', 'privacyPolicy')">Save Privacy Policy</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}