@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/AboutStyle.css" />

<div class="about-content">

    <div class="about-title">

        <span>DEFINING ELEGANCE</span>

        <p>
            At Solteira & Brands, we believe that everyone deserves to enjoy jewelry 
            that makes them feel confident and beautiful, without breaking the bank. 
            Whether you’re treating yourself or choosing a meaningful gift, our collection 
            is designed to offer elegance for every moment.
        </p>

    </div>

</div>

<div class="abt-origin">

    <div class="col-6 abt-origin-left">

        <span>Our Origin</span>
        <p>
            Solteira & Brands began in 2020, during the surge of online shopping brought 
            on by the pandemic. What started as a simple idea: to make fine jewelry more 
            accessible which quickly grew into a passion for curating pieces that combine 
            quality, beauty, and affordability.
        </p>

    </div>

   <div class="col-6 abt-origin-right">

       <div class="col-3">
           <img src="@Url.Content("~/Content/img/about/about-img[1].png")"/>
       </div>

       <div class="col-3">
           <img src="@Url.Content("~/Content/img/about/about-img[2].png")"/>
       </div>

   </div>

</div>

<div class="about-pursuit">

    <div class="abt-pursuit-title">

        <span>The Pursuit of Perfection</span>

        <p>
            We partner with trusted international suppliers to bring you timeless, 
            fine-quality jewelry without the luxury price tag. Each piece is carefully 
            selected to ensure that it meets our standards for craftsmanship, durability, 
            and style.
        </p>

    </div>

    <div class="abt-pursuit-category">

        <div class="card" style="width: 22rem;">
            <img src="@Url.Content("~/Content/img/jewelry/citrine-diamond-ring.png")" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">Natural Diamonds Only</h5>
                <p class="card-text">
                    Solteira & Brands exclusively utilizes natural, earth-mined diamonds to
                    ensure unparalleled brilliance and inherent authenticity.
                </p>
            </div>
        </div>

        <div class="card" style="width: 22rem;">
            <img src="@Url.Content("~/Content/img/jewelry/alexandra-set.png")" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">Global Sourcing</h5>
                <p class="card-text">
                    Solteira & Brands meticulously sources materials and unique designs from
                    premier jewelry centers, primarily Hong Kong and Japan.
                </p>
            </div>
        </div>

        <div class="card" style="width: 22rem;">
            <img src="@Url.Content("~/Content/img/jewelry/tiara-ring-whitegold.png")" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">Pure Precious Metals</h5>
                <p class="card-text">
                    The diamonds are set only in Real Gold or Platinum—never in substitutes.
                    This dedication guarantees lasting value and ensures exquisite wear.
                </p>
            </div>
        </div>


