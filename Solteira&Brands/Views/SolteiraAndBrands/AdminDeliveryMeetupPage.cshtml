@{
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
}
<div class="main-content" ng-init="loadDeliveryMeetup()">
    <div class="container-fluid delivery-container px-1">
        <div class="row px-4 pb-0 mb-0 ">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Delivery - Cash through Meetup</p>
            </div>
            <div class="col d-flex justify-content-end align-items-center">
                <small class="text-muted align-self-center me-2">{{ meetupOrdersList.length }} order(s)</small>
                <small class="text-muted align-self-center me-2">All meetup orders</small>
            </div>
        </div>
        @*table*@
        <div class="row  px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="deliveryMeetupTable">
                    <thead>
                        <tr>
                            <th>Order Number</th>
                            <th>Customer</th>
                            <th>Current Order Status</th>
                            <th>Latest Meetup Outcome</th>
                            <th>Outcome Reason</th>
                            <th>Reschedule Date</th>
                            <th>Outcome Action</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-repeat="o in meetupOrdersList track by o.id">
                            <td>{{o.orderNumber}}</td>
                            <td>{{o.customerName}}</td>
                            <td>{{o.orderStatus}}</td>
                            <td>{{o.latestMeetupOutcome || '-'}}</td>
                            <td>{{o.meetupOutcomeReason || '-'}}</td>
                            <td>{{o.meetupRescheduledDateFormatted || o.meetupRescheduledDate || '-'}}</td>
                            <td>
                                <span ng-if="o.orderStatus !== 'Ready for Meetup'" class="text-muted small">No further updates</span>
                                <span ng-if="o.orderStatus === 'Ready for Meetup'">
                                    <button type="button" class="btn btn-sm btn-success me-1" ng-click="completeMeetupWithReceipt(o.id)">Mark Completed (upload receipt)</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" ng-click="updateMeetupOutcome(o.id, 'NO_SHOW')" ng-if="o.latestMeetupOutcome !== 'NO_SHOW'">Mark No Show</button>
                                    <button type="button" class="btn btn-sm btn-outline-warning me-1" ng-click="updateMeetupOutcome(o.id, 'NO_SHOW')" ng-if="o.latestMeetupOutcome === 'NO_SHOW'">Edit No Show</button>
                                    <button type="button" class="btn btn-sm btn-danger" ng-click="updateMeetupOutcome(o.id, 'CANCELLED')">Cancel</button>
                                </span>
                            </td>
                            <td>
                                <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View">
                                    <a class="order-action-icon" href="javascript:void(0)" ng-click="openMeetupViewModal(o)"><img src="@Url.Content("~/Content/img/icons/view.svg")" alt="View" /></a>
                                </div>
                            </td>
                        </tr>
                        <tr ng-if="meetupOrdersList.length === 0">
                            <td colspan="8" class="text-muted py-4">No meetup orders.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @* View Meetup modal (read-only) *@
        <div class="modal fade" id="meetupViewModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content orderDetails-modal-custom" style="background-color: #f8f9fa;" ng-if="meetupDetail">
                    <div class="modal-header border-0 px-4 pt-4 pb-0">
                        <h2 class="fw-bold mb-0">Meetup Details</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeMeetupViewModal()"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="fw-bold mb-0">Order {{meetupDetail.orderSummary.orderNumber}}</h4>
                                            <span class="orderDetails-badgeNew">{{meetupDetail.orderSummary.orderStatus}}</span>
                                        </div>
                                        <div class="mt-2" ng-if="meetupDetail.scheduledAtFormatted">
                                            <label class="orderDetails-infoLabel">Scheduled</label>
                                            <p class="orderDetails-infoValue mb-0">{{meetupDetail.scheduledAtFormatted}}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-person-circle me-2 orderDetails-icon"></i>Customer Information</h5>
                                        <div class="mb-3">
                                            <label class="orderDetails-infoLabel">Name</label>
                                            <p class="orderDetails-infoValue">{{meetupDetail.orderSummary.customerName}}</p>
                                        </div>
                                        <div class="mb-3">
                                            <label class="orderDetails-infoLabel">Email</label>
                                            <p class="orderDetails-infoValue">{{meetupDetail.orderSummary.email}}</p>
                                        </div>
                                        <div>
                                            <label class="orderDetails-infoLabel">Contact No</label>
                                            <p class="orderDetails-infoValue">{{meetupDetail.orderSummary.contactNumber}}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="meetupDetail.meetupSchedule">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2"><i class="bi bi-geo me-2 orderDetails-icon"></i>Meetup Schedule (Location)</h5>
                                        <p class="fw-bold mb-1">{{meetupDetail.meetupSchedule.locationName}}</p>
                                        <p class="mb-0 text-muted small">{{meetupDetail.meetupSchedule.address}}</p>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="meetupDetail.meetupOutcomeStatus">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2">Latest Meetup Outcome</h5>
                                        <p class="mb-1"><strong>Status:</strong> {{meetupDetail.meetupOutcomeStatus}}</p>
                                        <p class="mb-1" ng-if="meetupDetail.meetupOutcomeReason"><strong>Reason:</strong> {{meetupDetail.meetupOutcomeReason}}</p>
                                        <p class="mb-1" ng-if="meetupDetail.meetupRescheduledDateFormatted || meetupDetail.meetupRescheduledDate"><strong>Reschedule date:</strong> {{meetupDetail.meetupRescheduledDateFormatted || meetupDetail.meetupRescheduledDate}}</p>
                                        <p class="mb-0" ng-if="meetupDetail.receiptImageUrl"><strong>Receipt:</strong> <a ng-href="{{meetupDetail.receiptImageUrl}}" target="_blank" rel="noopener">View image</a></p>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="meetupDetail.orderSummary.deliveryType">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2">Order Info</h5>
                                        <p class="mb-1"><strong>Delivery Type:</strong> {{meetupDetail.orderSummary.deliveryType}}</p>
                                        <p class="mb-1"><strong>Payment Type:</strong> {{meetupDetail.orderSummary.paymentType}}</p>
                                        <p class="mb-0" ng-if="meetupDetail.orderSummary.remainingBalance != null"><strong>Remaining Balance:</strong> &#8369; {{meetupDetail.orderSummary.remainingBalance | number:2}}</p>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="meetupDetail.paymentHistory && meetupDetail.paymentHistory.length">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2">Payment History</h5>
                                        <div class="small" ng-repeat="p in meetupDetail.paymentHistory">
                                            <span class="me-2">&#8369; {{p.amount | number:2}}</span>
                                            <span class="me-2">{{p.paymentStatus}}</span>
                                            <span class="me-2" ng-if="p.meetupDatetimeFormatted">Meetup: {{p.meetupDatetimeFormatted}}</span>
                                            <a ng-if="p.proofImageUrl" ng-href="{{p.proofImageUrl}}" target="_blank" rel="noopener">Proof</a>
                                            <span class="text-muted">{{p.createdAt}}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="meetupDetail.deliveryInfo">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2">Delivery (if shipment)</h5>
                                        <p class="mb-1"><strong>Courier:</strong> {{meetupDetail.deliveryInfo.courier || '-'}}</p>
                                        <p class="mb-1"><strong>Tracking:</strong> {{meetupDetail.deliveryInfo.trackingNumber || '-'}}</p>
                                        <p class="mb-1" ng-if="meetupDetail.deliveryInfo.dispatchDateFormatted"><strong>Dispatch:</strong> {{meetupDetail.deliveryInfo.dispatchDateFormatted}}</p>
                                        <p class="mb-0" ng-if="meetupDetail.deliveryInfo.etaFormatted"><strong>ETA:</strong> {{meetupDetail.deliveryInfo.etaFormatted}}</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="meetupDetail.orderSummary.items.length">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-bag-check me-2 orderDetails-icon"></i>Order Items</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead class="border-bottom"><tr class="text-muted small text-uppercase"><th>Item</th><th class="text-center">Qty</th><th class="text-end">Price</th></tr></thead>
                                                <tbody>
                                                    <tr class="border-bottom" ng-repeat="item in meetupDetail.orderSummary.items">
                                                        <td class="fw-bold py-3">{{item.productName}}</td>
                                                        <td class="text-center">{{item.quantity}}</td>
                                                        <td class="text-end">&#8369; {{item.unitPrice * item.quantity | number:2}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-credit-card me-2 orderDetails-icon"></i>Order Summary</h5>
                                        <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3 mt-2">
                                            <span>Total</span>
                                            <span class="orderDetails-total">&#8369; {{meetupDetail.orderSummary.totalAmount | number:2}}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 flex-wrap">
                        <span class="me-2" ng-if="meetupDetail.orderSummary.orderStatus === 'Ready for Meetup'">Actions:</span>
                        <button type="button" class="btn btn-success me-2" ng-if="meetupDetail.orderSummary.orderStatus === 'Ready for Meetup'" ng-click="completeMeetupWithReceipt(meetupDetail.orderSummary.id); closeMeetupViewModal();">Mark Completed (upload receipt)</button>
                        <button type="button" class="btn btn-outline-secondary me-2" ng-if="meetupDetail.orderSummary.orderStatus === 'Ready for Meetup'" ng-click="updateMeetupOutcome(meetupDetail.orderSummary.id, 'NO_SHOW'); closeMeetupViewModal();">Mark No Show</button>
                        <button type="button" class="btn btn-danger me-2" ng-if="meetupDetail.orderSummary.orderStatus === 'Ready for Meetup'" ng-click="updateMeetupOutcome(meetupDetail.orderSummary.id, 'CANCELLED'); closeMeetupViewModal();">Cancel</button>
                        <button class="orderDetails-button px-4 py-2" data-bs-dismiss="modal" ng-click="closeMeetupViewModal()"><span>CLOSE</span></button>
                    </div>
                </div>
            </div>
        </div>
        @* Modal: Upload receipt for Completed *@
        <div class="modal fade" id="meetupReceiptModal" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delivery-form-box">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Upload receipt (required for Completed)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="file" class="form-control" id="meetupReceiptFile" accept=".jpg,.jpeg,.png" />
                        <small class="text-muted">JPG or PNG, max 5MB.</small>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="delivery-btn-add" ng-click="confirmMeetupCompleted()">Confirm</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*----------Table end----------*@
    </div>
</div>