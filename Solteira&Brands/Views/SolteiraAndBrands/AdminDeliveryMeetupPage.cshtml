 @{
    Layout = "~/Views/Shared/_SABInventoryDashboardLayout.cshtml";
}
<div class="main-content">
    <div class="container-fluid delivery-container px-1">
        <div class="row px-4 pb-0 mb-0 ">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Delivery - Cash through Meetup</p>
            </div>
            <div class="col d-flex justify-content-end">
                <button type="button" class="btn-add-order px-2 py-1" data-bs-toggle="modal" data-bs-target="#deliveryAddMeetupModal">
                    <i class="bi bi-plus plus-icon"></i> Add Order
                </button>
                @*Modal - Add Order*@
                <div class="modal fade" id="deliveryAddMeetupModal" tabindex="-1" aria-labelledby="deliveryModalLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content delivery-form-box shadow-lg border-0">
                            <div class="modal-body p-5">
                                <h2 class="delivery-header-text mb-5">New Delivery</h2>

                                <form>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-4 text-end pe-4">
                                            <label class="delivery-label">Order ID: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input class="form-control delivery-input-field" list="orderIdList" placeholder="Order ID">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-4 text-end pe-4">
                                            <label class="delivery-label">Customer Name: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="Customer Name">
                                        </div>
                                    </div>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-4 text-end pe-4">
                                            <label class="delivery-label">Meetup Address: </label>
                                        </div>
                                        <div class="col-sm-7">
                                            <textarea type="textarea" class="form-control delivery-input-field  meetup-address" rows="2" value="I-V G/F JMS Bldg., Mc Arthur Highway, Salapungan, Angeles City, Pampanga" disabled>I-V G/F JMS Bldg., Mc Arthur Highway, Salapungan, Angeles City, Pampanga</textarea>
                                        </div>
                                    </div>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-4 text-end pe-4">
                                            <label class="delivery-label">Meetup Date: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control delivery-input-field">
                                        </div>
                                    </div>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-4 text-end pe-4">
                                            <label class="delivery-label">Meetup Time: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="time" class="form-control delivery-input-field">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-4 text-end pe-4">
                                            <label class="delivery-label">Delivery Status: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <select class="form-select delivery-input-field text-muted">
                                                <option selected disabled>Delivery Status</option>
                                                <option value="pending">Pending</option>
                                                <option value="in-transit">In Transit</option>
                                                <option value="delivered">Delivered</option>
                                                <option value="cancelled">Cancelled</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mb-5 justify-content-center">
                                        <div class="col-sm-3">
                                            <label class="delivery-label">Proof of Transaction: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <div class="input-group">
                                                <input class="form-control delivery-input-field" type="file">
                                            </div>

                                            <small class="meetup-hint-text text-muted d-block mt-1">
                                                Please upload a clear copy of your payment. Maximum Size: 5MB.
                                            </small>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-center gap-3">
                                        <button type="button" class="delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="delivery-btn-add" ng-click="addMeetupStatus()">Add</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                @*modal end*@
            </div>
        </div>
        @*table*@
        <div class="row  px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="deliveryMeetupTable">
                    <thead>
                        <tr>
                            <th>Delivery ID</th>
                            <th>Order ID</th>
                            <th>Customer Name</th>
                            <th>Meetup Address</th>
                            <th>Meetup Date</th>
                            <th>Meetup Time</th>
                            <th>Delivery Status </th>
                            <th>Proof of Transaction</th>
                            <th>Action </th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-init="deliveryMeetupStatus=''">
                            <td>DVR-001</td>
                            <td ng-click="orderDetails()" id="delivery-orderID">ORD-001</td>
                            <td>Jerilee Rosales</td>
                            <td>I-V G/F JMS Bldg.Salapungan, Angeles City, Pampanga</td>
                            <td id="meetupDate">Nov-19-2025</td>
                            <td id="meetupTime">1:00 PM</td>
                            @*status dropdown*@
                            <td>
                                <div class="dropdown">
                                    <a class="btn dropdown-toggle order-dropdown-status text-muted" href="#" role="button" data-bs-toggle="dropdown">
                                        {{ deliveryMeetupStatus || 'Status' }}
                                    </a>

                                    <ul class="dropdown-menu order-dropdown-menu py-0">
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryMeetupStatus='Pending';meetupStatus()">Pending</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryMeetupStatus='Awaiting Meetup'; meetupStatus()">Awaiting Meetup</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryMeetupStatus='Meetup Successful'; meetupStatus()">Meetup Successful</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryMeetupStatus='Failed'; meetupStatus()">Failed</a></li>
                                    </ul>
                                </div>
                            </td>
                            @*upload button*@
                            <td id="upload-col">
                                <button type="button" class="btn meetup-upload px-3 py-1" data-bs-toggle="modal" data-bs-target="#uploadFileModal">
                                    <i class="bi bi-upload me-2"></i> Upload
                                </button>
                                @*modal for upload*@
                                <div class="modal fade" id="uploadFileModal" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content delivery-form-box">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title meetup-label fw-bold">Upload Proof of Transaction</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body px-4 pb-4">
                                                <p class="meetup-hint-text mb-3">Please select a clear image or PDF (Max. 5MB).</p>

                                                <div class="mb-4">
                                                    <input type="file" class="form-control delivery-input-field" id="proofFileInput">
                                                </div>

                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="delivery-btn-cancel px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="button" class="delivery-btn-add px-4" data-bs-dismiss="modal" ng-click="uploadPOFStatus()">Confirm</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*modal end*@
                            </td>
                            @*actions*@
                            <td class="">
                                <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View Meetup Details" class="d-inline-block">
                                    <a class="order-action-icon" data-bs-toggle="modal" data-bs-target="#deliveryViewMeetupModal">
                                        <img src="~/Content/img/icons/view.svg" />
                                    </a>
                                </div>
                                @*modal - view delivery*@
                                <div class="modal fade" id="deliveryViewMeetupModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content view-meetup-container shadow-lg">

                                            <div class="modal-header border-0 pb-0 justify-content-end">
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body p-5 pt-0">
                                                <h2 class="view-meetup-header mb-5 text-center">Meetup Details</h2>

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Delivery ID:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-id-highlight">DVR-007</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Order ID:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-id-highlight">ORD-007</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Customer Name:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-data">Kim Namjuan</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Meetup Address:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-data">I-V G/F JMS Bldg. Salapungan, Angeles City, Pampanga</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Meetup Date:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-data">
                                                            <i class="bi bi-calendar3 me-2"></i> Nov-17-2025
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Meetup Time:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-data">
                                                            <i class="bi bi-clock me-2"></i> 08:37 PM
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-meetup-label">Proof of Transaction:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-meetup-data">
                                                            <span>hello.png</span>
                                                            <a href="#" class="view-meetup-link ms-2">[View]</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*modal end*@
                                @*edit button*@
                                <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Meetup Details" class="d-inline-block">
                                    <a class="order-action-icon" data-bs-toggle="modal" data-bs-target="#deliveryEditMeetupModal">
                                        <img src="~/Content/img/icons/edit.svg" />
                                    </a>
                                </div>
                                @*Modal - Edit Delivery*@
                                <div class="modal fade" id="deliveryEditMeetupModal" tabindex="-1" aria-labelledby="deliveryModalLabel" aria-hidden="true" data-bs-backdrop="static">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content delivery-form-box shadow-lg border-0">
                                            <div class="modal-body p-5">
                                                <h2 class="delivery-header-text mb-5">Edit Meetup Details</h2>

                                                <form>
                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-4 text-end pe-4">
                                                            <label class="delivery-label">Order ID: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input class="form-control delivery-input-field" list="orderIdList" placeholder="Order ID">
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-4 text-end pe-4">
                                                            <label class="delivery-label">Customer Name: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="text" class="form-control delivery-input-field" placeholder="Customer Name">
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-4 text-end pe-4">
                                                            <label class="delivery-label">Meetup Address: </label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <textarea type="textarea" class="form-control delivery-input-field  meetup-address" rows="2" value="I-V G/F JMS Bldg., Mc Arthur Highway, Salapungan, Angeles City, Pampanga" disabled>I-V G/F JMS Bldg., Mc Arthur Highway, Salapungan, Angeles City, Pampanga</textarea>
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-4 text-end pe-4">
                                                            <label class="delivery-label">Meetup Date: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="date" class="form-control delivery-input-field">
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-4 text-end pe-4">
                                                            <label class="delivery-label">Meetup Time: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="time" class="form-control delivery-input-field">
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-4 text-end pe-4">
                                                            <label class="delivery-label">Delivery Status: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <select class="form-select delivery-input-field text-muted">
                                                                <option selected disabled>Delivery Status</option>
                                                                <option value="pending">Pending</option>
                                                                <option value="in-transit">In Transit</option>
                                                                <option value="delivered">Delivered</option>
                                                                <option value="cancelled">Cancelled</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="row mb-5 justify-content-center">
                                                        <div class="col-sm-3">
                                                            <label class="delivery-label">Proof of Transaction: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <div class="input-group">
                                                                <input class="form-control delivery-input-field" type="file">
                                                            </div>

                                                            <small class="meetup-hint-text text-muted d-block mt-1">
                                                                Please upload a clear copy of your payment. Maximum Size: 5MB.
                                                            </small>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex justify-content-center gap-3">
                                                        <button type="button" class="delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="delivery-btn-add" ng-click="updateMeetupStatus()">Update</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*end of modal*@
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*----------Table end----------*@
    </div>
</div>