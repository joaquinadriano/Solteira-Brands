@{
    Layout = User.IsInRole("STAFF") ? "~/Views/Shared/_StaffLayout.cshtml" : "~/Views/Shared/_OperationsLayout.cshtml";
}
<div class="main-content" ng-init="loadDeliveryMeetup()">
    <div class="container-fluid delivery-container px-1">
        <div class="row px-4 pb-0 mb-0 ">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Delivery - Cash through Meetup</p>
            </div>
        </div>
        @*table*@
        <div class="row  px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="deliveryMeetupTable">
                    <thead>
                        <tr>
                            <th>Meetup ID</th>
                            <th>Order ID</th>
                            <th>Customer Name</th>
                            <th>Address</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Scheduled</th>
                            <th class="table-col-actions">Actions</th>
                            <th class="table-col-actions">View</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-repeat="o in meetupOrdersList track by o.id">
                            <td data-order="{{o.meetupOutcomeId || 0}}">{{o.meetupOutcomeId ? ('CTM-' + o.meetupOutcomeId) : '-'}}</td>
                            <td data-order="{{o.id || 0}}">{{o.orderNumber}}</td>
                            <td>{{o.customerName}}</td>
                            <td>{{ (o.deliveryAddress || '').indexOf('Cash through meetup') >= 0 ? 'Meetup pickup' : o.deliveryAddress }}</td>
                            <td>&#8369; {{o.totalAmount | number:2}}</td>
                            <td>
                                <span class="badge"
                                      ng-class="{
                                          'bg-secondary': o.orderStatus === 'Ready for Meetup' || o.orderStatus === 'Meetup Rescheduled' || o.orderStatus === 'No Show',
                                          'bg-success': o.orderStatus === 'Completed',
                                          'bg-danger': o.orderStatus === 'Cancelled'
                                      }">
                                    {{(o.orderStatus === 'Ready for Meetup' && !o.scheduledAtFormatted) ? 'Awaiting Schedule' : o.orderStatus}}
                                </span>
                            </td>
                            <td>{{o.scheduledAtFormatted || '-'}}</td>
                            <td class="table-col-actions">
                                <div class="d-flex justify-content-center align-items-center flex-wrap gap-1">
                                <button type="button" class="btn btn-sm btn-success px-2" title="Schedule meetup"
                                        ng-click="openScheduleMeetupModal(o)"
                                        ng-if="o.needsMeetupSchedule">
                                    <i class="bi bi-calendar-check"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-success"
                                        ng-click="completeMeetupWithReceipt(o.id)"
                                        ng-if="(o.orderStatus === 'Ready for Meetup' || o.orderStatus === 'Meetup Rescheduled') && o.scheduledAt">
                                    Mark Completed (upload proof)
                                </button>
                                <button type="button" class="btn btn-sm btn-danger"
                                        ng-click="updateMeetupOutcome(o.id, 'NO_SHOW')"
                                        ng-if="(o.orderStatus === 'Ready for Meetup' || o.orderStatus === 'Meetup Rescheduled') && o.scheduledAt">
                                    Mark No Show
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        ng-click="openRescheduleModal(o)"
                                        ng-if="o.orderStatus === 'No Show' || ((o.orderStatus === 'Ready for Meetup' || o.orderStatus === 'Meetup Rescheduled') && o.scheduledAt)">
                                    Reschedule
                                </button>
                                </div>
                            </td>
                            <td class="table-col-actions">
                                <div class="d-flex justify-content-center align-items-center">
                                    <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View">
                                        <a class="order-action-icon" href="javascript:void(0)" ng-click="openMeetupViewModal(o)"><img src="@Url.Content("~/Content/img/icons/view.svg")" alt="View" /></a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr ng-if="meetupOrdersList.length === 0">
                            <td colspan="9" class="text-muted py-4">No meetup orders found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @* View Meetup modal (read-only) *@
        <div class="modal fade" id="meetupViewModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content orderDetails-modal-custom" style="background-color: #f8f9fa;" ng-if="meetupDetail">
                    <div class="modal-header border-0 px-4 pt-4 pb-0">
                        <h2 class="fw-bold mb-0">Meetup Details</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeMeetupViewModal()"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h4 class="fw-bold mb-0">Order {{meetupDetail.orderSummary.orderNumber}}</h4>
                                            <span class="orderDetails-badgeNew">{{(meetupDetail.orderSummary.orderStatus === 'Ready for Meetup' && !meetupDetail.scheduledAtFormatted) ? 'Awaiting Schedule' : meetupDetail.orderSummary.orderStatus}}</span>
                                        </div>
                                        <div class="mt-2" ng-if="meetupDetail.scheduledAtFormatted">
                                            <label class="orderDetails-infoLabel">Scheduled</label>
                                            <p class="orderDetails-infoValue mb-0">{{meetupDetail.scheduledAtFormatted}}</p>
                                        </div>
                                        <div class="mt-2" ng-if="meetupDetail.orderCancellationReason && meetupDetail.orderSummary.orderStatus === 'Cancelled'">
                                            <label class="orderDetails-infoLabel">Cancellation / No show reason</label>
                                            <p class="orderDetails-infoValue mb-0 text-danger small">{{meetupDetail.orderCancellationReason}}</p>
                                        </div>
                                        <div class="mt-3" ng-if="meetupDetail.meetupOutcomeStatus">
                                            <label class="orderDetails-infoLabel">Latest outcome</label>
                                            <p class="orderDetails-infoValue mb-1">
                                                <span class="badge"
                                                      ng-class="{
                                                          'bg-success': meetupDetail.meetupOutcomeStatus === 'COMPLETED',
                                                          'bg-warning text-dark': meetupDetail.meetupOutcomeStatus === 'NO_SHOW',
                                                          'bg-danger': meetupDetail.meetupOutcomeStatus === 'CANCELLED',
                                                          'bg-secondary': meetupDetail.meetupOutcomeStatus === 'READY_FOR_MEETUP'
                                                      }">
                                                    {{meetupDetail.meetupOutcomeStatus === 'READY_FOR_MEETUP' ? 'Ready for Meetup' : meetupDetail.meetupOutcomeStatus}}
                                                </span>
                                            </p>
                                            <p class="orderDetails-infoValue mb-0 text-muted small" ng-if="meetupDetail.meetupOutcomeAtFormatted">
                                                {{meetupDetail.meetupOutcomeAtFormatted}}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-person-circle me-2 orderDetails-icon"></i>Customer Information</h5>
                                        <div class="mb-3">
                                            <label class="orderDetails-infoLabel">Name</label>
                                            <p class="orderDetails-infoValue">{{meetupDetail.orderSummary.customerName}}</p>
                                        </div>
                                        <div class="mb-3">
                                            <label class="orderDetails-infoLabel">Email</label>
                                            <p class="orderDetails-infoValue">{{meetupDetail.orderSummary.email}}</p>
                                        </div>
                                        <div>
                                            <label class="orderDetails-infoLabel">Contact No</label>
                                            <p class="orderDetails-infoValue">{{formatPhilippineContactDisplay(meetupDetail.orderSummary.contactNumber)}}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="meetupDetail.meetupSchedule">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-2"><i class="bi bi-geo me-2 orderDetails-icon"></i>Meetup Schedule (Location)</h5>
                                        <p class="fw-bold mb-1">{{meetupDetail.meetupSchedule.locationName}}</p>
                                        <p class="mb-0 text-muted small text-break">{{meetupDetail.meetupSchedule.address}}</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="meetupDetail.orderSummary.items.length">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-bag-check me-2 orderDetails-icon"></i>Order Items</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead class="border-bottom"><tr class="text-muted small text-uppercase"><th>Item</th><th class="text-center">Qty</th><th class="text-end">Price</th></tr></thead>
                                                <tbody>
                                                    <tr class="border-bottom" ng-repeat="item in meetupDetail.orderSummary.items">
                                                        <td class="fw-bold py-3">{{item.productName}}</td>
                                                        <td class="text-center">{{item.quantity}}</td>
                                                        <td class="text-end">&#8369; {{item.unitPrice * item.quantity | number:2}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="meetupDetail.meetupReceiptImageUrl">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-camera-reels me-2 orderDetails-icon"></i>Meetup Proof</h5>
                                        <div class="text-center" ng-if="!isVideoUrl(meetupDetail.meetupReceiptImageUrl)">
                                            <a ng-href="{{meetupDetail.meetupReceiptImageUrl}}" target="_blank" rel="noopener">
                                                <img ng-src="{{meetupDetail.meetupReceiptImageUrl}}" alt="Meetup proof" class="img-fluid rounded border" style="max-height: 260px;" />
                                            </a>
                                        </div>
                                        <div class="text-center" ng-if="isVideoUrl(meetupDetail.meetupReceiptImageUrl)">
                                            <video class="img-fluid rounded border" style="max-height: 320px;" controls preload="metadata">
                                                <source ng-src="{{meetupDetail.meetupReceiptImageUrl}}" type="video/mp4" />
                                                Your browser does not support video preview.
                                            </video>
                                            <div class="mt-2">
                                                <a ng-href="{{meetupDetail.meetupReceiptImageUrl}}" target="_blank" rel="noopener">Open video in new tab</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-4"
                                     ng-if="meetupDetail.installmentSchedule && meetupDetail.installmentSchedule.length">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-credit-card me-2 orderDetails-icon"></i>Payment Summary</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead class="border-bottom">
                                                    <tr class="text-muted small text-uppercase">
                                                        <th>Payment</th>
                                                        <th>Due Date</th>
                                                        <th class="text-end">Amount</th>
                                                        <th>Status</th>
                                                        <th>Proof</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr class="border-bottom" ng-repeat="row in meetupDetail.installmentSchedule">
                                                        <td class="fw-bold py-3">{{row.label}}</td>
                                                        <td>{{row.dueDate}}</td>
                                                        <td class="text-end">&#8369; {{row.amount | number:2}}</td>
                                                        <td><span class="badge" ng-class="{'bg-success': row.status === 'Paid', 'bg-danger': row.status === 'Rejected' || row.status === 'Rejected - Please Resubmit' || row.status === 'Overdue', 'bg-warning text-dark': row.status === 'Awaiting Verification', 'bg-secondary': row.status === 'Pending'}">{{row.status}}</span></td>
                                                        <td>
                                                            <a ng-if="row.proofImageUrl" ng-href="{{row.proofImageUrl}}" target="_blank" class="btn btn-sm btn-outline-secondary">View proof</a>
                                                            <span ng-if="!row.proofImageUrl" class="text-muted">No data available</span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4 mb-4"
                                     ng-if="meetupDetail.paymentHistory && meetupDetail.paymentHistory.length">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-cash-stack me-2 orderDetails-icon"></i>Payment History</h5>
                                        <div class="table-responsive">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead class="border-bottom">
                                                    <tr class="text-muted small text-uppercase">
                                                        <th>Amount</th>
                                                        <th>Status</th>
                                                        <th>Reference</th>
                                                        <th>Proof</th>
                                                        <th>Date</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr class="border-bottom" ng-repeat="p in meetupDetail.paymentHistory">
                                                        <td class="fw-bold">&#8369; {{p.amount | number:2}}</td>
                                                        <td><span class="badge" ng-class="getPaymentStatusBadgeClass(p.paymentStatus)">{{getPaymentStatusDisplayText(p.paymentStatus, p)}}</span></td>
                                                        <td>{{p.referenceNumber || '-'}}</td>
                                                        <td>
                                                            <a ng-if="p.proofImageUrl" ng-href="{{p.proofImageUrl}}" target="_blank" class="btn btn-sm btn-outline-secondary">View proof</a>
                                                            <span ng-if="!p.proofImageUrl" class="text-muted">No data available</span>
                                                        </td>
                                                        <td>{{p.verifiedAt || p.createdAt}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-3"><i class="bi bi-credit-card me-2 orderDetails-icon"></i>Order Summary</h5>
                                        <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3 mt-2">
                                            <span>Total</span>
                                            <span class="orderDetails-total">&#8369; {{meetupDetail.orderSummary.totalAmount | number:2}}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 flex-wrap"
                         ng-if="meetupDetail.orderSummary.orderStatus !== 'Completed' && meetupDetail.orderSummary.orderStatus !== 'Cancelled'">
                        <button type="button" class="btn btn-success me-2 px-3" title="Schedule meetup"
                                ng-click="closeMeetupViewModal(); openScheduleMeetupModal({ id: meetupDetail.orderSummary.id, needsMeetupSchedule: true });"
                                ng-if="meetupDetail.scheduledAtFormatted == null && (meetupDetail.orderSummary.orderStatus === 'Ready for Meetup')">
                            <i class="bi bi-calendar-check"></i>
                        </button>
                        <button type="button" class="btn btn-success me-2"
                                ng-click="completeMeetupWithReceipt(meetupDetail.orderSummary.id); closeMeetupViewModal();"
                                ng-if="(meetupDetail.orderSummary.orderStatus === 'Ready for Meetup' || meetupDetail.orderSummary.orderStatus === 'Meetup Rescheduled') && meetupDetail.scheduledAtFormatted">
                            Mark Completed (upload proof)
                        </button>
                        <button type="button" class="btn btn-danger me-2"
                                ng-click="updateMeetupOutcome(meetupDetail.orderSummary.id, 'NO_SHOW'); closeMeetupViewModal();"
                                ng-if="(meetupDetail.orderSummary.orderStatus === 'Ready for Meetup' || meetupDetail.orderSummary.orderStatus === 'Meetup Rescheduled') && meetupDetail.scheduledAtFormatted">
                            Mark No Show
                        </button>
                        <button type="button" class="btn btn-outline-primary me-2"
                                ng-click="closeMeetupViewModal(); openRescheduleModal({ id: meetupDetail.orderSummary.id });"
                                ng-if="meetupDetail.orderSummary.orderStatus === 'No Show' || ((meetupDetail.orderSummary.orderStatus === 'Ready for Meetup' || meetupDetail.orderSummary.orderStatus === 'Meetup Rescheduled') && meetupDetail.scheduledAtFormatted)">
                            Reschedule
                        </button>
                    </div>
                </div>
            </div>
        </div>
        @* Modal: Upload proof for Completed *@
        <div class="modal fade" id="meetupReceiptModal" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delivery-form-box">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Upload proof (required for Completed)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="file" class="form-control" id="meetupReceiptFile" accept=".jpg,.jpeg,.png,.mp4" />
                        <small class="text-muted">JPG, PNG, or MP4, max 5MB.</small>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="delivery-btn-add" ng-click="confirmMeetupCompleted()">Confirm</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* Modal: Reschedule meetup (same date/time format as buyer: 10:00 AM - 5:00 PM) *@
        <div class="modal fade" id="rescheduleMeetupModal" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delivery-form-box">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Reschedule meetup</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeRescheduleModal()"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control form-control-sm mb-2" ng-model="rescheduleDate" min="{{getMinMeetupDateReschedule()}}" ng-change="onRescheduleDateChange()" />
                        <label class="form-label">Time</label>
                        <select class="form-select form-select-sm" ng-model="rescheduleTime" ng-options="t for t in rescheduleTimeOptions"></select>
                        <small class="text-muted">Business hours 8:00 AM - 7:00 PM.</small>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="delivery-btn-add" ng-click="confirmReschedule()">Reschedule</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* Modal: First-time schedule (admin sets date/time for buyer) *@
        <div class="modal fade" id="scheduleMeetupModal" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delivery-form-box">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Schedule meetup</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeScheduleMeetupModal()"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control form-control-sm mb-2" ng-model="scheduleDate" min="{{getMinMeetupDateReschedule()}}" ng-change="onScheduleDateChange()" />
                        <label class="form-label">Time</label>
                        <select class="form-select form-select-sm" ng-model="scheduleTime" ng-options="t for t in scheduleTimeOptions"></select>
                        <small class="text-muted">Business hours 8:00 AM - 7:00 PM.</small>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="delivery-btn-add" ng-click="confirmScheduleMeetup()">Save schedule</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*----------Table end----------*@
    </div>
</div>