@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content" ng-init="loadActivityLogs()">
    <div class="container-fluid orders-container px-1">

        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Activity Logs</p>
                <p class="text-muted mb-0">Audit trail of actions by managers, staff, and system admins.</p>
            </div>
        </div>

        <div class="row px-4 pt-3">
            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-3 pb-0">
                        <div class="row g-2 align-items-end flex-wrap border-bottom mb-0 pb-3">
                            <div class="col-12 col-md">
                                <label class="form-label small mb-0 fw-semibold">Search</label>
                                <input type="text" class="form-control form-control-sm" placeholder="User, role, or action" ng-model="logsSearch" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0 fw-semibold">From date</label>
                                <input type="date" class="form-control form-control-sm" ng-model="logsFilterDateFrom" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0 fw-semibold">To date</label>
                                <input type="date" class="form-control form-control-sm" ng-model="logsFilterDateTo" />
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-outline-secondary" ng-click="logsSearch=''; logsFilterDateFrom=''; logsFilterDateTo='';">Clear filters</button>
                            </div>
                        </div>
                    </div>
                    <div class="p-3 pt-0">
                    <table class="table table-hover table-striped text-center align-middle mb-0" id="activityLogsTable" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start ps-3">User</th>
                                <th>Role</th>
                                <th>Action</th>
                                <th>Module</th>
                                <th>Entity ID</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody class="table-group-divider">
                            <tr ng-repeat="log in getFilteredActivityLogs()">
                                <td class="text-start ps-3">{{log.username}}</td>
                                <td><span class="badge" ng-class="getActivityLogRoleClass(log.roleName)" ng-bind="log.roleName"></span></td>
                                <td class="fw-bold" ng-class="getActivityLogActionClass(log.action)" ng-bind="log.action"></td>
                                <td>{{log.module}}</td>
                                <td>{{log.entityId != null ? log.entityId : '-'}}</td>
                                <td>{{log.createdAtString}}</td>
                            </tr>
                            <tr ng-if="activityLogsList.length === 0">
                                <td colspan="6" class="text-muted py-4">No activity logs yet.</td>
                            </tr>
                            <tr ng-if="activityLogsList.length > 0 && getFilteredActivityLogs().length === 0">
                                <td colspan="6" class="text-muted py-4">No matching logs. Try adjusting filters.</td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>