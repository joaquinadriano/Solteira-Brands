@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/CartStyle.css" />

<div ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">
    
    <div class="shopping-cart-text">
        <span>Shopping Cart ({{cart.length}})</span>
    </div>

    <hr class="hr-line" />

    <div class="empty-cart-wrapper" ng-if="cart.length === 0">
        <div class="empty-cart-message">
            <i class="bi bi-cart-x"></i>
            <p>Your jewelry box is currently empty.</p>
            <a href="@Url.Action("SolteiraBrandsJewelries", "SolteiraAndBrands")" class="btn shopping-btn">
                CONTINUE SHOPPING
            </a>
        </div>
    </div>

    <div class="cart-page-wrapper">

        <hr class="hr-line" ng-show="cart.length > 0" />

        <div class="cart-list" ng-if="cart.length > 0">
            <div class="cart-item" ng-repeat="item in cart">

                <div class="item-selection">
                    <label class="custom-checkbox">
                        <input type="checkbox" ng-model="item.selected" />
                        <span class="checkmark"></span>
                    </label>
                </div>

                <div class="item-image">
                    <img ng-src="/Content/img/jewelry/{{item.img}}" alt="{{item.name}}" />
                </div>

                <div class="product-details">
                    <h3 class="product-name">{{item.name}}</h3>
                    <div class="product-price">&#8369; {{item.price | number:2}}</div>

                    <div class="product-specs" ng-if="item.stones || item.material">
                        <span ng-if="item.stones">{{item.stones}}</span>
                        <span ng-if="item.material">{{item.material}}</span>
                        <span ng-if="item.weight">{{item.weight}}<span ng-if="item.length">, {{item.length}}</span></span>
                    </div>

                    <div class="product-qty-display">
                        Quantity: {{item.qty}}
                    </div>
                </div>

                <div class="item-actions">
                    <button class="remove-btn" ng-click="removeFromCart($index)">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="cart-summary-footer" ng-if="cart.length > 0">

        <div class="footer-left-actions">

            <label class="custom-checkbox select-all-container">
                <input type="checkbox" ng-model="selectAll" ng-change="toggleAll()" />
                <span class="checkmark"></span>
                <span class="select-all-label">Select All</span>
            </label>

        </div>

        <div class="footer-right-actions">

            <div class="total-display"> 
                <span class="total-label">Total:</span>
                <span class="total-amount">&#8369; {{getCartTotal() | number:2}}</span>
            </div>

            <button ng-click="proceedToCheckout('@Url.Action("SolteiraBrandsCheckout", "SolteiraAndBrands")')"
                    class="checkout-btn"
                    ng-disabled="(cart | filter:{selected: true}).length === 0">
                CHECK OUT
            </button>

        </div>

    </div>

</div>
