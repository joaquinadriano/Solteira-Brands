        @* Angular-driven Edit Item Modal *@
        <div class="modal fade" id="inventoryEditItemModal" tabindex="-1" aria-labelledby="inventoryEditItemLabel" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content delivery-form-box shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-5 pt-0" ng-if="editProduct">
                        <h2 class="delivery-header-text mb-5" id="inventoryEditItemLabel">Edit Inventory Item</h2>

                        <form>
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Product ID (read-only):</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text"
                                           class="form-control delivery-input-field"
                                           ng-value="'P-' + ('000' + editProduct.id).slice(-3)"
                                           readonly />
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Product Name: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" maxlength="30" ng-model="editProduct.name" />
                                    <small class="text-muted">Max 30 characters.</small>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Category: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <select class="form-select delivery-input-field"
                                            ng-model="editProduct.category"
                                            ng-options="c for c in productCategories">
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Selling Price: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="number" step="0.01" class="form-control delivery-input-field" ng-model="editProduct.price">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Stocks: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="number"
                                           min="0"
                                           step="1"
                                           onkeydown="if(event.key === '-') event.preventDefault();"
                                           oninput="this.value=this.value.replace(/[^0-9]/g,'');"
                                           class="form-control delivery-input-field"
                                           ng-model="editProduct.stockQuantity">
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Stones: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" maxlength="50" ng-model="editProduct.stones">
                                    <small class="text-muted">Max 50 characters.</small>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Material: <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" maxlength="50" ng-model="editProduct.material">
                                    <small class="text-muted">Max 50 characters.</small>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Color:</label>
                                </div>
                                <div class="col-sm-7">
                                    <select class="form-control delivery-input-field" ng-model="editProduct.color">
                                        <option value="">-- Select Color --</option>
                                        <option value="White">White</option>
                                        <option value="Gold">Gold</option>
                                        <option value="Silver">Silver</option>
                                        <option value="Blue">Blue</option>
                                        <option value="Green">Green</option>
                                        <option value="Red">Red</option>
                                        <option value="Purple">Purple</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center" ng-if="editProduct.category === 'Ring'">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Ring Size (US): <span class="delivery-required">*</span></label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="number" step="0.5" min="1" max="16"
                                           class="form-control delivery-input-field"
                                           placeholder="e.g., 7"
                                           ng-model="editProduct.ringSize"
                                           onkeydown="if(event.key === '-') event.preventDefault();" />
                                    <small class="text-muted">US ring size (numeric). Required for rings.</small>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Weight:</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" maxlength="50" ng-model="editProduct.weight">
                                    <small class="text-muted">Max 50 characters.</small>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Length:</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" maxlength="50" ng-model="editProduct.length">
                                    <small class="text-muted">Max 50 characters.</small>
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Show in Featured Products:</label>
                                </div>
                                <div class="col-sm-7">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="editFeatured" ng-model="editProduct.isFeatured" />
                                        <label class="form-check-label" for="editFeatured">Display on homepage Featured carousel</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Photo:</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="file" class="form-control delivery-input-field" accept=".jpg,.jpeg,.png" ng-class="{'is-invalid': inventoryEditFileValidationMessage}"
                                           onchange="angular.element(this).scope().onInventoryEditFileSelected(this.files)" />
                                    <small class="text-muted">PNG or JPG, less than 5MB. Leave empty to keep current.</small>
                                    <p class="text-danger small mt-1 mb-0" ng-if="inventoryEditFileValidationMessage">{{inventoryEditFileValidationMessage}}</p>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end pt-2">
                                <button type="button" class="btn delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn delivery-btn-add" ng-click="updateInventoryProduct()">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
