@{
    Layout = User.IsInRole("ADMIN") ? "~/Views/Shared/_AdminLayout.cshtml"
        : (User.IsInRole("STAFF") ? "~/Views/Shared/_StaffLayout.cshtml" : "~/Views/Shared/_OperationsLayout.cshtml");
}
<div class="main-content" ng-init="inventoryDefaultPhotoUrl='@Url.Content("~/Content/img/shared/default-product.svg")'">
    <div class="container-fluid orders-container px-1">
        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Inventory</p>
            </div>
            <div class="col d-flex justify-content-end align-items-center gap-2 flex-wrap">
                @if (User.IsInRole("ADMIN"))
                {
                    <div class="btn-group me-2 b" role="group">
                        <button type="button"
                                class="btn btn-sm btn-showactive btn-outline-success"
                                id="btn-showactive"
                                ng-class="{'active': !showArchivedInventory}"
                                ng-click="showArchivedInventory = false; loadInventoryProducts();">
                            Show Active
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-showarchive btn-outline-secondary"
                                id="btn-showarchive"
                                ng-class="{'active': showArchivedInventory}"
                                ng-click="showArchivedInventory = true; loadInventoryProducts();">
                            Show Archived
                        </button>
                    </div>
                }

                @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER"))
                {
                <button type="button"
                        class="btn btn-add-order px-2 py-1"
                        data-bs-toggle="modal"
                        data-bs-target="#inventoryAddItemModal">
                    <i class="bi bi-plus plus-icon"></i> Add Item
                </button>

                @*Modal - Add Item (styled consistent with Delivery Shipments modal)*@
                <div class="modal fade" id="inventoryAddItemModal" tabindex="-1" aria-labelledby="inventoryAddItemLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content delivery-form-box shadow-lg">

                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body p-5 pt-0">
                                <h2 class="delivery-header-text mb-5" id="inventoryAddItemLabel">New Inventory Item</h2>

                                <form>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product ID: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field"
                                                   ng-value="nextProductDisplayId"
                                                   placeholder="P-001" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product Name: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" maxlength="30" placeholder="Many Shape Tennis" ng-model="newProduct.name" />
                                            <small class="text-muted">Max 30 characters.</small>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Category: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <select class="form-select delivery-input-field"
                                                    ng-model="newProduct.category"
                                                    ng-options="c for c in productCategories">
                                                <option value="" disabled selected>Select category</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Selling Price: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="number" step="0.01" min="0" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="55990.00" ng-model="newProduct.price">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Stocks: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="number"
                                                   min="0"
                                                   step="1"
                                                   onkeydown="if(event.key === '-') event.preventDefault();"
                                                   oninput="this.value=this.value.replace(/[^0-9]/g,'');"
                                                   class="form-control delivery-input-field"
                                                   placeholder="3"
                                                   ng-model="newProduct.stockQuantity">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Stones: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" maxlength="50" placeholder="e.g., 5 Total Carat Diamond" ng-model="newProduct.stones">
                                            <small class="text-muted">Max 50 characters.</small>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Material: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" maxlength="50" placeholder="e.g., 18K White Gold" ng-model="newProduct.material">
                                            <small class="text-muted">Max 50 characters.</small>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Color:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <select class="form-control delivery-input-field" ng-model="newProduct.color">
                                                <option value="">-- Select Color --</option>
                                                <option value="White">White</option>
                                                <option value="Gold">Gold</option>
                                                <option value="Silver">Silver</option>
                                                <option value="Blue">Blue</option>
                                                <option value="Green">Green</option>
                                                <option value="Red">Red</option>
                                                <option value="Purple">Purple</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center" ng-if="newProduct.category === 'Ring'">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Ring Size (US): <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="number" step="0.5" min="1" max="16"
                                                   class="form-control delivery-input-field"
                                                   placeholder="e.g., 7"
                                                   ng-model="newProduct.ringSize"
                                                   onkeydown="if(event.key === '-') event.preventDefault();" />
                                            <small class="text-muted">US ring size (numeric). Required for rings.</small>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Weight:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" maxlength="50" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="e.g., 9.6 grams" ng-model="newProduct.weight">
                                            <small class="text-muted">Max 50 characters.</small>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Length:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" maxlength="50" onkeydown="if(event.key === '-') event.preventDefault();" class="form-control delivery-input-field" placeholder="e.g., 18cm" ng-model="newProduct.length">
                                            <small class="text-muted">Max 50 characters.</small>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Show in Featured Products:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="addFeatured" ng-model="newProduct.isFeatured" />
                                                <label class="form-check-label" for="addFeatured">Display on homepage Featured carousel</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-4 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Photo: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="file" id="inventoryAddPhotoInput" class="form-control delivery-input-field" accept=".jpg,.jpeg,.png" ng-class="{'is-invalid': inventoryFileValidationMessage}"
                                                   onchange="angular.element(this).scope().onInventoryFileSelected(this.files)" />
                                            <small class="text-muted">PNG or JPG, less than 5MB.</small>
                                            <p class="text-danger small mt-1 mb-0" ng-if="inventoryFileValidationMessage">{{inventoryFileValidationMessage}}</p>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end pt-2">
                                        <button type="button" class="btn delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn delivery-btn-add" ng-click="createInventoryProduct()">Add Item</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                @*Modal - Add Item end*@
                }
            </div>
        </div>

        <div class="row px-4 pt-3 pb-2">
            <div class="col-md-12">
                <div class="card bg-light border-0 p-3 rounded-3">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Category</label>
                            <select class="form-select form-select-sm" ng-model="inventoryCategoryFilter" ng-change="onInventoryFilterChange()">
                                <option value="All Categories">All Categories</option>
                                <option value="Ring">Ring</option>
                                <option value="Earring">Earring</option>
                                <option value="Necklace">Necklace</option>
                                <option value="Bracelet">Bracelet</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Material</label>
                            <select class="form-select form-select-sm" ng-model="inventoryMaterialFilter" ng-change="onInventoryFilterChange()">
                                <option value="">All Materials</option>
                                <option value="18K White Gold">18K White Gold</option>
                                <option value="18K Yellow Gold">18K Yellow Gold</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Color</label>
                            <select class="form-select form-select-sm" ng-model="inventoryColorFilter" ng-change="onInventoryFilterChange()">
                                <option value="">All Colors</option>
                                <option value="White">White</option>
                                <option value="Gold">Gold</option>
                                <option value="Silver">Silver</option>
                                <option value="Blue">Blue</option>
                                <option value="Green">Green</option>
                                <option value="Red">Red</option>
                                <option value="Purple">Purple</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Price</label>
                            <select class="form-select form-select-sm" ng-model="inventoryPriceFilter" ng-change="onInventoryFilterChange()">
                                <option value="">All Prices</option>
                                <option value="lt20000">&lt; &#8369;20,000</option>
                                <option value="lt40000">&lt; &#8369;40,000</option>
                                <option value="lt60000">&lt; &#8369;60,000</option>
                                <option value="lt80000">&lt; &#8369;80,000</option>
                                <option value="lt100000">&lt; &#8369;100,000</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Stock</label>
                            <select class="form-select form-select-sm" ng-model="inventoryStockFilter" ng-change="onInventoryFilterChange()">
                                <option value="">All Stock Levels</option>
                                <option value="lt3">&lt; 3</option>
                                <option value="lt5">&lt; 5</option>
                                <option value="lt10">&lt; 10</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Availability</label>
                            <select class="form-select form-select-sm" ng-model="inventoryAvailabilityFilter" ng-change="onInventoryFilterChange()">
                                <option value="">All</option>
                                <option value="instock">In Stock</option>
                                <option value="outofstock">Out of Stock</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold small mb-1">Ring Size</label>
                            <select class="form-select form-select-sm" ng-model="inventoryRingSizeFilter" ng-change="onInventoryFilterChange()">
                                <option value="">All Sizes</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="8">8</option>
                                <option value="9">9</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Inventory table (DataTables initialized via Angular after data loads) *@
        <div class="row px-4 pt-1">
            <div class="col">
                <table ng-if="inventoryTableVisible" class="table table-striped table-responsive text-center inventory-datatable" id="inventoryTable">
                    <thead>
                        <tr>
                            <th>Product ID</th>
                            <th>Category</th>
                            <th>Product Name</th>
                            <th>Product Description</th>
                            <th>Selling Price</th>
                            <th>Stocks</th>
                            <th>Sold</th>
                            <th>Date Added</th>
                            <th>Date Updated</th>
                            <th class="table-col-actions">Action</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-repeat="item in getFilteredInventoryProducts() track by item.id">
                            <td>{{item.id}}</td>
                            <td>{{item.category}}</td>
                            <td>{{item.name}}</td>
                            <td class="product-description-cell">
                                <span class="d-block">{{displayInventoryField(item.stones)}}</span>
                                <span class="d-block">{{displayInventoryField(item.material)}}</span>
                                <span class="d-block" ng-if="item.color">Color: {{item.color}}</span>
                                <span class="d-block" ng-if="item.ringSize">Ring Size: {{item.ringSize}} (US)</span>
                                <span class="d-block"><span ng-if="displayInventoryField(item.weight)">{{displayInventoryField(item.weight)}}</span><span ng-if="displayInventoryField(item.weight) && displayInventoryField(item.length)">, </span><span ng-if="displayInventoryField(item.length)">{{displayInventoryField(item.length)}}</span></span>
                            </td>
                            <td>{{formatProductPrice(item.price)}}</td>
                            <td>{{item.stockQuantity}}</td>
                            <td>{{item.sold != null ? item.sold : 0}}</td>
                            <td>{{item.createdAtString}}</td>
                            <td>{{item.updatedAtString}}</td>
                            <td class="table-col-actions">
                                <div class="d-inline-flex align-items-center flex-nowrap gap-1 justify-content-center inventory-table-actions">
                                    @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER") || User.IsInRole("STAFF"))
                                    {
                                        <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View product details">
                                            <a class="order-action-icon" ng-click="openViewPhotoModal(item)" aria-label="View product details">
                                                <img src="@Url.Content("~/Content/img/icons/view.svg")" alt="" />
                                            </a>
                                        </div>
                                    }
                                    @if (User.IsInRole("ADMIN") || User.IsInRole("MANAGER"))
                                    {
                                        <div ng-if="!showArchivedInventory"
                                             data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Item">
                                            <a class="order-action-icon" ng-click="openEditProduct(item)">
                                                <img src="@Url.Content("~/Content/img/icons/edit.svg")" alt="Edit" />
                                            </a>
                                        </div>
                                    }

                                    @if (User.IsInRole("ADMIN"))
                                    {
                                        <div data-bs-toggle="tooltip"
                                             data-bs-placement="bottom"
                                             data-bs-title="{{showArchivedInventory ? 'Restore Item' : 'Archive Item'}}">
                                            <a class="order-action-icon" ng-click="inventoryArchiveAlert(item)" aria-label="Archive or restore item">
                                                <img ng-if="!showArchivedInventory" src="@Url.Content("~/Content/img/icons/archive-status.svg")" alt="" />
                                                <img ng-if="showArchivedInventory" src="@Url.Content("~/Content/img/icons/restore.svg")" alt="" />
                                            </a>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div ng-if="inventoryTableVisible && getFilteredInventoryProducts().length === 0" class="text-center py-4">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #aaa;"></i>
                    <p class="text-muted mt-2 mb-0">No products match the selected filters.</p>
                </div>
            </div>
        </div>

@* View Product Modal: full view with large image (ADMIN / MANAGER / STAFF) *@
        <div class="modal fade product-view-modal" id="inventoryViewPhotoModal" tabindex="-1" aria-labelledby="inventoryViewPhotoLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content view-prod shadow-lg" ng-if="viewPhotoItem" style="border-radius: 25px; border: none; padding: 15px;">

                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="product-view-modal-title mb-0" id="inventoryViewPhotoLabel" style="font-weight: 800;">{{viewPhotoItem.name}}</h2>
                        </div>
                        <button type="button" class="btn-close" aria-label="Close" ng-click="closeViewPhotoAndEdit()"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="product-view-grid">

                            <div class="product-image-section text-center">
                                <div class="position-relative overflow-hidden" style="border-radius: 18px;">
                                    <img ng-if="viewPhotoItem.imageUrl"
                                         ng-src="{{viewPhotoItem.imageUrl}}"
                                         alt="{{viewPhotoItem.name}}"
                                         class="product-view-img product-view-img-enlarge"
                                         ng-click="viewPhotoItem.imageUrl && openImagePreview(viewPhotoItem.imageUrl); $event.stopPropagation()"
                                         role="button"
                                         title="Click to enlarge" />

                                    <img ng-if="!viewPhotoItem.imageUrl"
                                         src="@Url.Content("~/Content/img/shared/default-product.svg")"
                                         alt="No image"
                                         class="product-view-img" />
                                </div>

                                <div ng-if="!viewPhotoItem.imageUrl && !showArchivedInventory" class="mt-2">
                                    <a href="javascript:void(0)" class="text-primary" ng-click="closeViewPhotoAndEdit(viewPhotoItem)">Add Photo</a>
                                </div>
                            </div>

                            <div class="product-details-section">
                                <h1 class="mb-0" style="font-weight: 800; font-size: 2.5rem; ">{{formatProductPrice(viewPhotoItem.price)}}</h1>

                                <div class="row gx-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-3 rounded-4 d-flex justify-content-between align-items-center" style="background-color: #FFFDF1;">
                                            <small class="fw-bold text-muted" style="letter-spacing: 0.5px; font-size: 0.7rem;">STOCK LEFT</small>
                                            <span class="h5 mb-0 fw-bold">{{viewPhotoItem.stockQuantity}}</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 rounded-4 d-flex justify-content-between align-items-center" style="background-color: #FFFDF1;">
                                            <small class="fw-bold text-muted" style="letter-spacing: 0.5px; font-size: 0.7rem;">TOTAL SOLD</small>
                                            <span class="h5 mb-0 fw-bold text-success">{{viewPhotoItem.sold != null ? viewPhotoItem.sold : 0}}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-4 border rounded-4">
                                    <div class="small text-dark">
                                        <p class="mb-1 "><strong>Product ID: </strong>#{{viewPhotoItem.id}}</p>
                                        <p class="mb-1"><strong>Category:</strong> {{viewPhotoItem.category}}</p>
                                        <p class="mb-1 fw-bold text-success btn-outline-success" ng-if="viewPhotoItem.isFeatured" style="text-shadow: 0 1px 2px rgba(0,0,0,0.1);  ">
                                            Featured
                                        </p>
                                        <p class="mb-1 text-secondary" ng-if="!viewPhotoItem.isFeatured">
                                            Not Featured
                                        </p>
                                        <p class="mb-1"><strong>Date Added:</strong> {{viewPhotoItem.createdAtString}}</p>
                                        <p class="mb-0 "><strong>Date Updated:</strong> {{viewPhotoItem.updatedAtString}}</p>
                                    </div>

                                    <hr class="my-3 opacity-10">

                                    <div class="small">
                                        <p class="fw-bold mb-1" style="font-size: 0.9rem;">Product Specifications</p>

                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span class="text-muted">Material</span>
                                            <span class="fw-bold text-uppercase">{{displayInventoryField(viewPhotoItem.material)}}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 small" ng-if="viewPhotoItem.color">
                                            <span class="text-muted">Color</span>
                                            <span class="fw-bold text-uppercase">{{viewPhotoItem.color}}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 small" ng-if="viewPhotoItem.ringSize">
                                            <span class="text-muted">Ring Size (US)</span>
                                            <span class="fw-bold text-uppercase">{{viewPhotoItem.ringSize}}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span class="text-muted">Stones</span>
                                            <span class="fw-bold text-uppercase">{{displayInventoryField(viewPhotoItem.stones)}}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span class="text-muted">Weight</span>
                                            <span class="fw-bold text-uppercase">{{displayInventoryField(viewPhotoItem.weight)}}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-0 small">
                                            <span class="text-muted">Length</span>
                                            <span class="fw-bold text-uppercase">{{displayInventoryField(viewPhotoItem.length)}}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Temporary Edit Item Modals (front-end only, one per product) *@

        <div class="modal fade" id="inventoryEditItemModal-001" tabindex="-1" aria-labelledby="inventoryEditItemLabel-001" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content delivery-form-box shadow-lg">
                    <div class="modal-header border-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-5 pt-0">
                        <h2 class="delivery-header-text mb-5" id="inventoryEditItemLabel-001">Edit Inventory Item (Temporary)</h2>

                        <form>
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Product ID (read-only):</label>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" class="form-control delivery-input-field" value="P-001" readonly />
                                </div>
                            </div>

                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-5">
                                    <label class="delivery-label">Product Name:</label>
                                </div>
                                <div class="col-sm-7">
