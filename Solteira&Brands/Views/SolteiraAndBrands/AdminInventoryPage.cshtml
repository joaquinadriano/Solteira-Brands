@{
    Layout = "~/Views/Shared/_SABInventoryDashboardLayout.cshtml";
}
<div class="main-content">
    <div class="container-fluid inventory-container px-1">
        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Inventory</p>
            </div>
            <div class="col d-flex justify-content-end">
                <button type="button"
                        class="btn btn-add-order px-2 py-1"
                        data-bs-toggle="modal"
                        data-bs-target="#inventoryAddItemModal">
                    <i class="bi bi-plus plus-icon"></i> Add Item
                </button>

                @*Modal - Add Item (styled consistent with Delivery Shipments modal)*@
                <div class="modal fade" id="inventoryAddItemModal" tabindex="-1" aria-labelledby="inventoryAddItemLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content delivery-form-box shadow-lg">

                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body p-5 pt-0">
                                <h2 class="delivery-header-text mb-5" id="inventoryAddItemLabel">New Inventory Item</h2>

                                <form>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product ID: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="P-001">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product Name: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="Many Shape Tennis">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Category: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="Bracelet">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Selling Price: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="P 55,990.00">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Stock Left: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="number" class="form-control delivery-input-field" placeholder="3">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Product Description:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <textarea class="form-control delivery-input-field" rows="3" placeholder="Description (optional)"></textarea>
                                        </div>
                                    </div>

                                    <div class="row mb-4 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Photo:</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="file" class="form-control delivery-input-field" />
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end pt-2">
                                        <button type="button" class="btn delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn delivery-btn-add">Add Item</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                @*Modal - Add Item end*@
            </div>
        </div>

        @* Inventory table *@
        <div class="row px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="inventoryTable">
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Product ID</th>
                            <th>Category</th>
                            <th>Product Name</th>
                            <th>Product Description</th>
                            <th>Selling Price</th>
                            <th>Stock Left</th>
                            <th>Date Added</th>
                            <th>Date Updated</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        @* Temporary static data for UI purposes only. Replace with database data later. *@
                        <tr class="inventory-row">
                            <td>
                                <img src="~/Content/img/solteira-logo.png"
                                     alt="Product photo"
                                     class="inventory-product-photo" />
                            </td>
                            <td>001</td>
                            <td>Bracelet</td>
                            <td>Many Shape Tennis</td>
                            <td class="text-start">
                                5 Total Carat Diamond 18K White Gold<br />
                                9.6 grams<br />
                                18cm
                            </td>
                            <td>P 55,990.00</td>
                            <td>3</td>
                            <td>11/04/25</td>
                            <td>N/A</td>
                            <td>
                                <a class="inventory-action-icon me-1" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Item">
                                    <img src="~/Content/img/icons/edit.svg" alt="Edit" />
                                </a>
                                <a class="inventory-action-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Archive Item">
                                    <img src="~/Content/img/icons/archive-status.svg" alt="Archive" />
                                </a>
                            </td>
                        </tr>

                        <tr class="inventory-row">
                            <td>
                                <img src="~/Content/img/solteira-logo.png"
                                     alt="Product photo"
                                     class="inventory-product-photo" />
                            </td>
                            <td>002</td>
                            <td>Ring</td>
                            <td>Tiara Ring - White Gold</td>
                            <td class="text-start">
                                1 Total Carat Diamond 18K White Gold<br />
                                4.5 grams
                            </td>
                            <td>P 34,478.00</td>
                            <td>2</td>
                            <td>10/29/25</td>
                            <td>N/A</td>
                            <td>
                                <a class="inventory-action-icon me-1" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Item">
                                    <img src="~/Content/img/icons/edit.svg" alt="Edit" />
                                </a>
                                <a class="inventory-action-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Archive Item">
                                    <img src="~/Content/img/icons/archive-status.svg" alt="Archive" />
                                </a>
                            </td>
                        </tr>

                        <tr class="inventory-row">
                            <td>
                                <img src="~/Content/img/solteira-logo.png"
                                     alt="Product photo"
                                     class="inventory-product-photo" />
                            </td>
                            <td>003</td>
                            <td>Earring</td>
                            <td>Water Dangling Earrings</td>
                            <td class="text-start">
                                0.250 Total Carat Diamond<br />
                                18K - Yellow Gold<br />
                                0.3 grams
                            </td>
                            <td>P 14,378.00</td>
                            <td>2</td>
                            <td>10/15/25</td>
                            <td>N/A</td>
                            <td>
                                <a class="inventory-action-icon me-1" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Item">
                                    <img src="~/Content/img/icons/edit.svg" alt="Edit" />
                                </a>
                                <a class="inventory-action-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Archive Item">
                                    <img src="~/Content/img/icons/archive-status.svg" alt="Archive" />
                                </a>
                            </td>
                        </tr>

                        <tr class="inventory-row">
                            <td>
                                <img src="~/Content/img/solteira-logo.png"
                                     alt="Product photo"
                                     class="inventory-product-photo" />
                            </td>
                            <td>004</td>
                            <td>Necklace</td>
                            <td>1 Carat Station Necklace</td>
                            <td class="text-start">
                                1 Total Carat Diamond<br />
                                18K White Gold
                            </td>
                            <td>P 28,482.00</td>
                            <td>1</td>
                            <td>10/15/25</td>
                            <td>N/A</td>
                            <td>
                                <a class="inventory-action-icon me-1" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Item">
                                    <img src="~/Content/img/icons/edit.svg" alt="Edit" />
                                </a>
                                <a class="inventory-action-icon" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Archive Item">
                                    <img src="~/Content/img/icons/archive-status.svg" alt="Archive" />
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
