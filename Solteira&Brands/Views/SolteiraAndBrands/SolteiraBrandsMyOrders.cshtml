@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/MyOrders.css" />

<div class="my-orders-main-wrapper" ng-app="SolteiraBrandsApplication" ng-controller="SolteiraBrandsController">

    <div class="my-orders-text">
        <span>MY ORDERS ({{orders.length}})</span>
    </div>

    <hr class="hr-line" />

    <div class="my-orders-page-wrapper">
        <div class="my-orders-container">

            <div class="search-container">
                <div class="search-wrapper">
                    <input type="text" ng-model="searchOrder" placeholder="Search by Order ID, Product Name" class="order-search-input" />
                    <span class="search-icon-btn"><i class="bi bi-search"></i></span>
                </div>
            </div>

            <div class="orders-section"
                 ng-repeat="order in orders | filter:searchOrder"
                 ng-click="viewOrderDetails(order.orderId)"
                 style="cursor: pointer; margin-bottom: 30px;">

                <div class="order-header">
                    <div class="order-status">
                        <span>Order Status: <span class="status-weight">{{order.status}}</span></span>
                    </div>
                    <div class="delivery-info" ng-if="order.status !== 'Cancelled'">
                        <div class="delivery-status">
                            Delivery Status: <span class="status-weight">{{order.deliveryStatus}}</span>
                        </div>
                        <a href="" class="track-link">Track Delivery</a>
                    </div>
                </div>

                <div class="order-card-white">
                    <div class="order-products">
                        <div class="product-row" ng-repeat="item in order.items">
                            <div class="product-info">
                                <img ng-src="/Content/img/jewelry/{{item.img}}" class="product-img" alt="{{item.name}}" />
                                <div class="product-details">
                                    <span class="product-name">{{item.name}}</span>
                                    <span class="product-desc">{{item.stones}}</span>
                                    <span class="product-desc">{{item.material}}</span>
                                    <span class="product-qty">Qty: {{item.qty}}</span>
                                </div>
                            </div>
                            <div class="product-price">&#8369; {{item.price | number:2}}</div>
                        </div>
                    </div>

                    <div class="order-total-section">
                        <span class="total-label">Total: </span>
                        <span class="total-amount">&#8369; {{order.total | number:2}}</span>
                    </div>
                </div>
            </div>

            <div ng-if="orders.length === 0" style="text-align:center; padding: 50px; color: #888;">
                <i class="bi bi-bag-x" style="font-size: 3rem;"></i>
                <p>You haven't placed any orders yet.</p>
            </div>

        </div>
    </div>
</div>
