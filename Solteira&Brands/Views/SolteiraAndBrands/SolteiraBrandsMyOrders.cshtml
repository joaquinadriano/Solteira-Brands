@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/MyOrders.css" />

<div class="my-orders-main-wrapper" ng-controller="SolteiraBrandsController" ng-init="loadMyOrders()">

    <div class="my-orders-text">
        <span>MY ORDERS ({{orders.length}})</span>
    </div>

    <hr class="hr-line" />

    <div class="my-orders-page-wrapper">
        <div class="my-orders-container">

            <div class="search-container">
                <div class="search-wrapper">
                    <input type="text" ng-model="searchOrder" placeholder="Search by Order ID, Product Name" class="order-search-input" />
                    <span class="search-icon-btn"><i class="bi bi-search"></i></span>
                </div>
            </div>

            <div class="orders-section" ng-repeat="order in orders | filter:searchOrder track by (order.orderId || order.id || order.orderNumber || $index)" ng-attr-data-order-id="{{order.orderNumber}}">

                <div class="order-header">
                    <div class="order-status">
                        <span class="d-block fw-bold text-white mb-2">Order #{{order.orderNumber}}</span>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="status-weight badge px-3 py-2" ng-class="getOrderStatusBadgeClass(order)">{{getBuyerOrderStatusLabel(order)}}</span>
                            <span class="badge bg-warning text-dark small" ng-if="getOverallStatus(order) === 'Layaway Active' && order.hasSubmittedPayment">Awaiting Verification</span>
                            <span class="text-white-50 small">({{buyerOrderPaymentTypeBadgeLabel(order)}})</span>
                        </div>
                        <p class="text-white-50 small mb-0 mt-2" ng-if="buyerCashMeetupAwaitingSchedule(order)">Meetup date and time will appear after admin schedules.</p>
                    </div>
                </div>

                <div class="order-card-white">
                    <div class="order-products">
                        <div class="product-row" ng-repeat="item in order.items track by $index">
                            <div class="product-info">
                                <img ng-src="{{item.img || defaultProductImageUrl}}" class="product-img" alt="{{item.name}}" />
                                <div class="product-details">
                                    <span class="product-name" ng-bind="item.name"></span>
                                    <span class="product-desc" ng-if="item.stones">{{item.stones}}</span>
                                    <span class="product-desc" ng-if="item.material">{{item.material}}</span>
                                    <span class="product-desc" ng-if="item.weight">{{item.weight}}</span>
                                    <span class="product-qty">Qty: {{item.qty}}</span>
                                </div>
                            </div>
                            <div class="product-price">
                                &#8369; {{(item.price * item.qty) | number:2}}
                            </div>
                        </div>
                    </div>

                    <hr style="border-top: 1px solid #f0f0f0; margin: 1vw 0;" />

                    <div class="order-total-section d-flex justify-content-between align-items-end flex-wrap gap-3">
                        <div class="text-start d-flex flex-column align-items-start gap-2">
                            <button type="button" class="btn-order-action" ng-click="handleOrderAction(order); $event.stopPropagation();">{{getOrderActionLabel(order)}}</button>
                            <small class="text-muted"
                                   ng-if="order.paymentDeadlineFormatted && !buyerHidePaymentDeadlineInSummary(order)">
                                Pay by: {{order.paymentDeadlineFormatted}} ({{order.paymentDeadlineRemainingText}})
                            </small>
                        </div>
                        <div class="text-end">
                            <span class="total-label">Total: </span>
                            <span class="total-amount">&#8369; {{order.total | number:2}}</span>
                        </div>
                    </div>
                </div>

                <div ng-if="order.latestPaymentRejectionReason && getOverallStatus(order) === 'Resubmit Payment Required'" class="order-rejection-message mt-2">
                    <strong>Rejection reason:</strong> {{order.latestPaymentRejectionReason}}
                </div>
            </div>

            <div ng-if="orders.length === 0" class="text-center py-5 text-muted empty-orders-zero">
                <i class="bi bi-bag-x" style="font-size: 3rem;"></i>
                <p class="mb-0 mt-2">You haven't placed any orders yet.</p>
            </div>

            <div ng-if="orders.length > 0 && (orders | filter:searchOrder).length === 0" class="text-center py-5 no-orders-filter">
                <p class="mb-0">No orders found.</p>
            </div>

        </div>
    </div>

    @* Buyer-side Order Details modal (order summary) *@
    <div class="modal fade" id="buyerOrderDetailsModal" tabindex="-1" aria-labelledby="buyerOrderDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content buyer-order-details-modal buyer-modal-container" ng-if="selectedOrderForDetails">
                <div class="modal-header border-0 pb-0 position-relative">
                    <button type="button"
                            class="btn-close shadow-none"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                            ng-click="closeOrderDetailsModal()"
                            style="position: absolute; right: 1.5rem; top: 1.5rem; z-index: 2;">
                    </button>
                    <div class="w-100 text-center mt-3">
                        <h2 class="modal-title order-summary-title" id="buyerOrderDetailsModalLabel">ORDER SUMMARY</h2>
                    </div>
                </div>
                <div class="modal-body buyer-order-details-body">
                    <p class="buyer-order-status-line">
                        <span class="buyer-order-status-label">Status:</span>
                        <span class="buyer-order-status-value badge px-3 py-2" ng-class="getOrderStatusBadgeClass(selectedOrderForDetails)">{{getBuyerOrderStatusLabel(selectedOrderForDetails)}}</span>
                        <span class="badge bg-warning text-dark ms-2 small" ng-if="getOverallStatus(selectedOrderForDetails) === 'Layaway Active' && selectedOrderForDetails.hasSubmittedPayment">Awaiting Verification</span>
                    </p>
                    <p class="small text-muted mb-2" ng-if="buyerCashMeetupAwaitingSchedule(selectedOrderForDetails)">
                        Down payment verified. A meetup date and time will show here once admin schedules it.
                    </p>
                    <p ng-if="buyerShowMeetupContextInSummary(selectedOrderForDetails) && selectedOrderForDetails.meetupScheduledAtFormatted" class="mb-1"><strong>Meetup date &amp; time:</strong> {{selectedOrderForDetails.meetupScheduledAtFormatted}}</p>
                    <p ng-if="(selectedOrderForDetails.meetupLocationName || selectedOrderForDetails.meetupAddress) && buyerShowMeetupContextInSummary(selectedOrderForDetails)" class="mb-1 small">
                        <strong>Meetup place:</strong>
                        <span ng-if="selectedOrderForDetails.meetupLocationName" class="d-block fw-semibold">{{selectedOrderForDetails.meetupLocationName}}</span>
                        <span ng-if="selectedOrderForDetails.meetupAddress" class="d-block text-muted">{{selectedOrderForDetails.meetupAddress}}</span>
                    </p>
                    <p ng-if="getOverallStatus(selectedOrderForDetails) === 'No Show'" class="mb-1 text-warning"><strong>Reschedule Pending</strong> - Admin will reschedule your meetup.</p>
                    <p ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'COMPLETED' && selectedOrderForDetails.meetupOutcomeAtFormatted" class="mb-1">
                        <strong>Completed via meetup:</strong> {{selectedOrderForDetails.meetupOutcomeAtFormatted}}
                        <span ng-if="selectedOrderForDetails.meetupReceiptImageUrl">
                            -
                            <a ng-href="{{selectedOrderForDetails.meetupReceiptImageUrl}}" target="_blank" rel="noopener">View proof</a>
                        </span>
                    </p>
                    <div class="buyer-order-summary-card">
                        <div class="buyer-order-item" ng-repeat="item in selectedOrderForDetails.items">
                            <img ng-src="{{item.img || defaultProductImageUrl}}" class="buyer-order-item-img" alt="{{item.name}}" />
                            <div class="buyer-order-item-details">
                                <span class="buyer-order-item-name">{{item.name}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.stones">{{item.stones}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.material">{{item.material}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.weight">{{item.weight}}</span>
                                <span class="buyer-order-item-qty">Qty: {{item.qty}}</span>
                            </div>
                            <div class="buyer-order-item-price">&#8369; {{(item.price * item.qty) | number:2}}</div>
                        </div>
                        <div class="buyer-order-total-row">
                            <span class="buyer-order-total-label">Total</span>
                            <span class="buyer-order-total-value">&#8369; {{selectedOrderForDetails.total | number:2}}</span>
                        </div>
                    </div>
                    <div class="buyer-order-meta mt-3">
                        <p class="mb-1"><strong>Order #</strong> {{selectedOrderForDetails.orderNumber}}</p>
                        <p class="mb-1"><strong>Date</strong> {{selectedOrderForDetails.orderDate | date:'MMM d, y'}}</p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.paymentDeadlineFormatted && !buyerHidePaymentDeadlineInSummary(selectedOrderForDetails)">
                            <strong>Payment deadline</strong> {{selectedOrderForDetails.paymentDeadlineFormatted}}
                            <span class="text-muted">({{selectedOrderForDetails.paymentDeadlineRemainingText}})</span>
                        </p>
                        <p class="mb-1"><strong>Payment</strong> {{buyerOrderPaymentTypeDisplay(selectedOrderForDetails)}}</p>
                        <p ng-if="(getOverallStatus(selectedOrderForDetails) === 'Order Cancelled - Delivery Failed' || getOverallStatus(selectedOrderForDetails) === 'Order Cancelled - No Show') && selectedOrderForDetails.cancellationReason" class="text-danger mb-1">
                            <strong>Cancellation reason:</strong> {{selectedOrderForDetails.cancellationReason}}
                        </p>
                        <p ng-if="selectedOrderForDetails.status === 'Rejected' && selectedOrderForDetails.rejectionReason" class="text-danger mb-0"><strong>Rejection reason:</strong> {{selectedOrderForDetails.rejectionReason}}</p>
                        <p ng-if="selectedOrderForDetails.latestPaymentRejectionReason
                                  && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)
                                  && (getOverallStatus(selectedOrderForDetails) === 'Resubmit Payment Required'
                                      || getOverallStatus(selectedOrderForDetails) === 'Awaiting Payment Verification')"
                           class="text-warning mb-0">
                            <strong>Payment was rejected:</strong> {{selectedOrderForDetails.latestPaymentRejectionReason}} You can submit a new proof via Pay Now.
                        </p>
                        <p ng-if="getOverallStatus(selectedOrderForDetails) === 'Cancelled'" class="text-danger mb-0">
                            <span ng-if="selectedOrderForDetails.latestPaymentRejectionReason">
                                <strong>Cancellation reason:</strong> {{selectedOrderForDetails.latestPaymentRejectionReason}}
                            </span>
                            <span ng-if="!selectedOrderForDetails.latestPaymentRejectionReason && selectedOrderForDetails.rejectionReason">
                                <strong>Cancellation reason:</strong> {{selectedOrderForDetails.rejectionReason}}
                            </span>
                            <span ng-if="!selectedOrderForDetails.latestPaymentRejectionReason && !selectedOrderForDetails.rejectionReason && !selectedOrderForDetails.paymentDeadlineExpired">
                                This order was cancelled.
                            </span>
                            <span ng-if="!selectedOrderForDetails.latestPaymentRejectionReason && !selectedOrderForDetails.rejectionReason && selectedOrderForDetails.paymentDeadlineExpired">
                                Payment overdue/expired. This order was cancelled.
                            </span>
                        </p>
                    </div>
                    <div class="buyer-order-layaway-info mt-3 p-3 rounded" style="background:#f8f9fa;"
                         ng-if="buyerShowPaymentScheduleSection(selectedOrderForDetails)">
                        <h6 class="fw-bold mb-2">{{buyerPaymentScheduleHeading(selectedOrderForDetails)}}</h6>
                        <div ng-if="(selectedOrderForDetails.paymentType || '').toUpperCase() === 'LAYAWAY'">
                            <p class="mb-1" ng-if="selectedOrderForDetails.downpaymentPercentage">
                                <strong>Downpayment:</strong>
                                {{selectedOrderForDetails.downpaymentPercentage | number:0}}%
                                (&#8369; {{(selectedOrderForDetails.downpaymentPaid || 0) | number:2}} paid)
                            </p>
                            <p class="mb-1">
                                <strong>Remaining Balance:</strong>
                                &#8369; {{(selectedOrderForDetails.remainingBalance || 0) | number:2}}
                            </p>
                            <p class="mb-2" ng-if="selectedOrderForDetails.monthlyInstallment && selectedOrderForDetails.installmentPlanMonths">
                                <strong>Installment Plan:</strong>
                                &#8369; {{selectedOrderForDetails.monthlyInstallment | number:2}} x {{selectedOrderForDetails.installmentPlanMonths}} month(s)
                            </p>
                        </div>
                        <div ng-if="(selectedOrderForDetails.paymentType || '').toUpperCase() === 'CASH_MEETUP'">
                            <p class="mb-1" ng-if="selectedOrderForDetails.downpaymentPercentage != null">
                                <strong>Online down payment:</strong>
                                {{selectedOrderForDetails.downpaymentPercentage | number:0}}%
                                (&#8369; {{(selectedOrderForDetails.downpaymentPaid || 0) | number:2}} paid online)
                            </p>
                            <p class="mb-1">
                                <strong>Remaining (at meetup):</strong>
                                &#8369; {{(selectedOrderForDetails.remainingBalance || 0) | number:2}}
                            </p>
                        </div>
                        <p class="mb-2 small text-muted" ng-if="buyerShowPaidFullPaymentSubtitle(selectedOrderForDetails)">
                            <strong>Total:</strong> &#8369; {{selectedOrderForDetails.total | number:2}} (paid in full)
                        </p>
                        <p class="mb-2 small text-muted" ng-if="buyerShowCashMeetupDownpaymentPaidSubtitle(selectedOrderForDetails)">
                            <strong>Order total:</strong> &#8369; {{selectedOrderForDetails.total | number:2}}
                            <span class="text-muted">- online down payment verified; remaining balance is due at meetup.</span>
                        </p>
                        <p class="mb-2 small text-muted" ng-if="buyerShowSingleRowPaymentRejectedSubtitle(selectedOrderForDetails)">
                            <strong>Order total:</strong> &#8369; {{selectedOrderForDetails.total | number:2}}
                            <span class="text-danger">- see payment status below</span>
                        </p>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>{{ (selectedOrderForDetails.paymentType || '').toUpperCase() === 'LAYAWAY' ? 'Installment #' : 'Payment' }}</th>
                                        <th>Due Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Proof</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="row in buyerPaymentScheduleRows(selectedOrderForDetails) track by $index">
                                        <td>{{row.label}}</td>
                                        <td>{{row.dueDate}}</td>
                                        <td>&#8369; {{row.amount | number:2}}</td>
                                        <td>
                                            <span class="badge"
                                                  ng-class="{
                                                      'bg-success': row.status === 'Paid',
                                                      'bg-warning text-dark': row.status === 'Awaiting Verification',
                                                      'bg-secondary': row.status === 'Pending',
                                                      'bg-danger': row.status === 'Rejected' || row.status === 'Overdue' || row.status === 'Expired' || row.status === 'Rejected – Please Resubmit' || row.status === 'Rejected - Please Resubmit'
                                                  }">
                                                {{row.status}}
                                            </span>
                                        </td>
                                        <td>
                                            <span ng-if="getOverallStatus(selectedOrderForDetails) === 'Paid - Waiting for Shipment'" class="text-muted">-</span>
                                            <span ng-if="getOverallStatus(selectedOrderForDetails) !== 'Paid - Waiting for Shipment' && row.proofImageUrl">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        ng-click="$event.preventDefault(); $event.stopPropagation(); openViewPaymentProofModalFromOrders(selectedOrderForDetails, row)">
                                                    View proof
                                                </button>
                                            </span>
                                            <span ng-if="getOverallStatus(selectedOrderForDetails) !== 'Paid - Waiting for Shipment' && !row.proofImageUrl"
                                                  class="text-muted">No data available</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="buyer-order-delivery-info mt-3 p-3 rounded" style="background:#f8f9fa;"
                         ng-if="buyerShowOrderSummaryDelivery(selectedOrderForDetails)">
                        <h6 class="fw-bold mb-2">Delivery</h6>
                        <p class="mb-1"><strong>Courier:</strong> {{selectedOrderForDetails.courier || '-'}}</p>
                        <p class="mb-1">
                            <strong>Tracking Number:</strong>
                            <span>{{selectedOrderForDetails.trackingNumber || '-'}}</span>
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 ms-2"
                                    ng-if="selectedOrderForDetails.trackingNumber"
                                    ng-click="copyTrackingNumber(selectedOrderForDetails.trackingNumber)">
                                Copy to Clipboard
                            </button>
                        </p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.dispatchDate"><strong>Dispatch Date:</strong> {{selectedOrderForDetails.dispatchDate}}</p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.eta"><strong>ETA:</strong> {{selectedOrderForDetails.eta}}</p>
                        <p class="mb-1"
                           ng-if="selectedOrderForDetails.trackingNumber">
                            <a href="#"
                               ng-click="goToTracking(selectedOrderForDetails.trackingNumber, selectedOrderForDetails.trackingLink, selectedOrderForDetails.courier); $event.preventDefault();"
                               class="btn btn-sm btn-outline-primary">
                                Open Courier Tracking
                            </a>
                        </p>
                        <p class="small text-muted mb-0 mt-2"
                           ng-if="(selectedOrderForDetails.courier && selectedOrderForDetails.courier.toLowerCase().indexOf('fedex') !== -1)
                                  || (selectedOrderForDetails.trackingLink && selectedOrderForDetails.trackingLink.toLowerCase().indexOf('fedex') !== -1)">
                            Note: Please copy the tracking number and paste it on the FedEx tracking page to track your parcel.
                        </p>
                        <p class="small text-muted mb-0 mt-2"
                           ng-if="(!selectedOrderForDetails.courier || selectedOrderForDetails.courier.toLowerCase().indexOf('fedex') === -1)
                                  && (!selectedOrderForDetails.trackingLink || selectedOrderForDetails.trackingLink.toLowerCase().indexOf('fedex') === -1)">
                            Note: Please copy the tracking number and paste it on the LBC tracking page to track your parcel.
                        </p>
                    </div>
                </div>
                <div class="modal-footer border-0 d-flex flex-wrap gap-2 justify-content-end">
                    <button type="button" class="btn btn-success"
                            ng-if="!selectedOrderForDetails.isArchived
                                   && (getOverallStatus(selectedOrderForDetails) === 'Approved'
                                       || getOverallStatus(selectedOrderForDetails) === 'Pending Payment'
                                       || (getOverallStatus(selectedOrderForDetails) === 'Resubmit Payment Required'))
                                   && selectedOrderForDetails.paymentType !== 'LAYAWAY'
                                   && (selectedOrderForDetails.paymentType || '').toUpperCase() !== 'CASH_MEETUP'
                                   && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)"
                            ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">
                        {{ selectedOrderForDetails.latestPaymentRejectionReason ? 'Resubmit' : 'Pay Now' }}
                    </button>
                    <button type="button" class="btn btn-success"
                            ng-if="!selectedOrderForDetails.isArchived
                                   && (getOverallStatus(selectedOrderForDetails) === 'Approved'
                                       || getOverallStatus(selectedOrderForDetails) === 'Pending Downpayment')
                                   && (selectedOrderForDetails.paymentType === 'LAYAWAY' || (selectedOrderForDetails.paymentType || '').toUpperCase() === 'CASH_MEETUP')
                                   && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)"
                            ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">
                        Pay Downpayment
                    </button>
                    <button type="button" class="btn btn-success"
                            ng-if="!selectedOrderForDetails.isArchived
                                   && getOverallStatus(selectedOrderForDetails) === 'Layaway Active'
                                   && selectedOrderForDetails.remainingBalance > 0
                                   && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)"
                            ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">
                        Pay Remaining Balance
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* View Payment Proof modal (Under Review) *@
    <div class="modal fade" id="viewPaymentProofModalMyOrders" tabindex="-1" aria-hidden="true" ng-if="selectedPaymentForProof">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">View Payment Proof</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeViewPaymentProofModal()"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        <strong>Status:</strong>
                        <span ng-class="{'text-warning': selectedPaymentForProof.paymentStatus === 'SUBMITTED', 'text-danger': selectedPaymentForProof.paymentStatus === 'REJECTED'}">
                            {{selectedPaymentForProof.paymentStatus === 'SUBMITTED'
                                ? 'Awaiting Verification'
                                : (selectedPaymentForProof.paymentStatus === 'REJECTED'
                                    ? ((selectedPaymentForProof.allowResubmit === false || selectedPaymentForProof.allowResubmit === 0) ? 'Rejected' : 'Rejected - Please Resubmit')
                                    : (selectedPaymentForProof.paymentStatus === 'VERIFIED'
                                        ? 'Verified'
                                        : 'Awaiting Verification'))}}
                        </span>
                    </p>
                    <p class="mb-2"><strong>Amount:</strong> &#8369; {{selectedPaymentForProof.amount | number:2}}</p>
                    <p class="mb-2"><strong>Date submitted:</strong> {{selectedPaymentForProof.createdAt}}</p>
                    <p class="mb-2" ng-if="selectedPaymentForProof.referenceNumber"><strong>Reference number:</strong> {{selectedPaymentForProof.referenceNumber}}</p>
                    <div class="mb-2" ng-if="selectedPaymentForProof.proofImageUrl">
                        <strong>Uploaded image</strong>
                        <img ng-src="{{selectedPaymentForProof.proofImageUrl}}" alt="Proof" class="img-fluid rounded border mt-1" style="max-height: 280px;" />
                    </div>
                    <p class="text-dark mb-0" ng-if="selectedPaymentForProof.paymentStatus === 'REJECTED' && selectedPaymentForProof.rejectionReason">
                        <strong>Rejection reason:</strong> {{selectedPaymentForProof.rejectionReason}}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
