@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/MyOrders.css" />

<div class="my-orders-main-wrapper" ng-controller="SolteiraBrandsController" ng-init="loadMyOrders()">

    <div class="my-orders-text">
        <span>MY ORDERS</span>
    </div>

    <hr class="hr-line" />

    <div class="my-orders-page-wrapper">
        <div class="my-orders-container">

            <div class="row g-4" ng-if="orders.length > 0">
                <div class="col-12" ng-repeat="order in orders" ng-attr.data-order-id="{{order.orderNumber}}">
                    <div class="my-orders-card">
                        <div class="card-header border-0 bg-transparent d-flex justify-content-between align-items-center py-3 px-4">
                            <span class="fw-bold">Order #{{order.orderNumber}}</span>
                            <div class="d-flex align-items-center flex-wrap justify-content-end gap-2">
                                <span class="status-weight badge px-2 py-1" ng-class="getOrderStatusBadgeClass(order)">{{getOverallStatus(order)}}</span>
                                <span class="badge bg-warning text-dark small" ng-if="getOverallStatus(order) === 'Layaway Active' && order.hasSubmittedPayment">Awaiting Verification</span>
                                <i class="bi bi-info-circle small text-muted" ng-if="getOverallStatusTooltip(order)" title="{{getOverallStatusTooltip(order)}}" style="cursor:help;"></i>
                                <span class="text-muted small">({{order.paymentType === 'LAYAWAY' ? 'Layaway' : 'Full payment'}})</span>
                            </div>
                        </div>
                        <div class="card-body py-2 px-4">
                            <div class="d-flex align-items-center justify-content-between p-3 rounded border border-light bg-light bg-opacity-50 mb-2" ng-repeat="item in order.items">
                                <img ng-src="{{item.img || defaultProductImageUrl}}" alt="{{item.name}}" class="rounded flex-shrink-0 border" style="width:72px;height:72px;object-fit:cover;" />
                                <div class="flex-grow-1 min-w-0 ms-3">
                                    <span class="fw-bold d-block text-dark" ng-bind="item.name"></span>
                                    <span class="text-muted small">Qty: {{item.qty}}</span>
                                </div>
                                <div class="fw-bold text-dark flex-shrink-0 ms-3 text-end">&#8369; {{(item.price * item.qty) | number:2}}</div>
                            </div>
                        </div>
                        <div class="card-footer border-0 bg-transparent d-flex justify-content-between align-items-center py-3 px-4">
                            <div class="d-flex align-items-center">
                                <span class="text-muted">Total:</span>
                                <span class="fw-bold text-success fs-6 ms-2">&#8369; {{order.total | number:2}}</span>
                            </div>
                            <button type="button" class="btn btn-outline-success btn-sm" ng-click="handleOrderAction(order); $event.stopPropagation();">{{getOrderActionLabel(order)}}</button>
                        </div>
                    </div>
                </div>
            </div>

            <div ng-if="orders.length === 0" class="text-center py-5 text-muted">
                <i class="bi bi-bag-x" style="font-size: 3rem;"></i>
                <p class="mb-0 mt-2">You haven't placed any orders yet.</p>
            </div>

        </div>
    </div>

    @* Buyer-side Order Details modal (order summary) *@
    <div class="modal fade" id="buyerOrderDetailsModal" tabindex="-1" aria-labelledby="buyerOrderDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content buyer-order-details-modal" ng-if="selectedOrderForDetails">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title buyer-order-details-title" id="buyerOrderDetailsModalLabel">Order Summary</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeOrderDetailsModal()"></button>
                </div>
                <div class="modal-body buyer-order-details-body">
                    <p class="buyer-order-status-line">
                        <span class="buyer-order-status-label">Status:</span>
                        <span class="buyer-order-status-value badge px-2 py-1" ng-class="getOrderStatusBadgeClass(selectedOrderForDetails)">{{getOverallStatus(selectedOrderForDetails)}}</span><i class="bi bi-info-circle ms-1 small text-muted" ng-if="getOverallStatusTooltip(selectedOrderForDetails)" title="{{getOverallStatusTooltip(selectedOrderForDetails)}}" style="cursor:help;"></i>
                        <span class="badge bg-warning text-dark ms-1 small" ng-if="getOverallStatus(selectedOrderForDetails) === 'Layaway Active' && selectedOrderForDetails.hasSubmittedPayment">Awaiting Verification</span>
                    </p>
                    <p ng-if="(getOverallStatus(selectedOrderForDetails) === 'Ready for Meetup' || getOverallStatus(selectedOrderForDetails) === 'Meetup Rescheduled') && selectedOrderForDetails.meetupScheduledAtFormatted" class="mb-1"><strong>Meetup date &amp; time:</strong> {{selectedOrderForDetails.meetupScheduledAtFormatted}}</p>
                    <p ng-if="getOverallStatus(selectedOrderForDetails) === 'No Show'" class="mb-1 text-warning"><strong>Reschedule Pending</strong> - Admin will reschedule your meetup.</p>
                    <p ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'COMPLETED' && selectedOrderForDetails.meetupOutcomeAtFormatted" class="mb-1">
                        <strong>Completed via meetup:</strong> {{selectedOrderForDetails.meetupOutcomeAtFormatted}}
                        <span ng-if="selectedOrderForDetails.meetupReceiptImageUrl">
                            -
                            <a ng-href="{{selectedOrderForDetails.meetupReceiptImageUrl}}" target="_blank" rel="noopener">View receipt</a>
                        </span>
                    </p>
                    <div class="buyer-order-summary-card">
                        <div class="buyer-order-item" ng-repeat="item in selectedOrderForDetails.items">
                            <img ng-src="{{item.img || defaultProductImageUrl}}" class="buyer-order-item-img" alt="{{item.name}}" />
                            <div class="buyer-order-item-details">
                                <span class="buyer-order-item-name">{{item.name}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.stones">{{item.stones}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.material">{{item.material}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.weight">{{item.weight}}</span>
                                <span class="buyer-order-item-qty">Qty: {{item.qty}}</span>
                            </div>
                            <div class="buyer-order-item-price">&#8369; {{(item.price * item.qty) | number:2}}</div>
                        </div>
                        <div class="buyer-order-total-row">
                            <span class="buyer-order-total-label">Total</span>
                            <span class="buyer-order-total-value">&#8369; {{selectedOrderForDetails.total | number:2}}</span>
                        </div>
                    </div>
                    <div class="buyer-order-meta mt-3">
                        <p class="mb-1"><strong>Order #</strong> {{selectedOrderForDetails.orderNumber}}</p>
                        <p class="mb-1"><strong>Date</strong> {{selectedOrderForDetails.orderDate | date:'MMM d, y'}}</p>
                        <p class="mb-1"><strong>Payment</strong> {{selectedOrderForDetails.paymentType === 'LAYAWAY' ? 'LAYAWAY' : 'FULL'}}</p>
                        <p ng-if="selectedOrderForDetails.status === 'Rejected' && selectedOrderForDetails.rejectionReason" class="text-danger mb-0"><strong>Rejection reason:</strong> {{selectedOrderForDetails.rejectionReason}}</p>
                        <p ng-if="selectedOrderForDetails.latestPaymentRejectionReason
                                  && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)
                                  && (getOverallStatus(selectedOrderForDetails) === 'Resubmit Payment Required'
                                      || getOverallStatus(selectedOrderForDetails) === 'Awaiting Payment Verification')"
                           class="text-warning mb-0">
                            <strong>Payment was rejected:</strong> {{selectedOrderForDetails.latestPaymentRejectionReason}} You can submit a new proof via Pay Now.
                        </p>
                        <p ng-if="selectedOrderForDetails.status === 'Cancelled'" class="text-muted mb-0">
                            <span ng-if="selectedOrderForDetails.rejectionReason">
                                <strong>Cancellation reason:</strong> {{selectedOrderForDetails.rejectionReason}}
                            </span>
                            <span ng-if="!selectedOrderForDetails.rejectionReason">
                                This order was cancelled.
                            </span>
                        </p>
                    </div>
                    <div class="buyer-order-layaway-info mt-3 p-3 rounded" style="background:#f8f9fa;"
                         ng-if="selectedOrderForDetails.paymentType === 'LAYAWAY' && selectedOrderForDetails.installmentSchedule && selectedOrderForDetails.installmentSchedule.length">
                        <h6 class="fw-bold mb-2">Layaway Progress</h6>
                        <p class="mb-1" ng-if="selectedOrderForDetails.downpaymentPercentage">
                            <strong>Downpayment:</strong>
                            {{selectedOrderForDetails.downpaymentPercentage | number:0}}%
                            (&#8369; {{(selectedOrderForDetails.downpaymentPaid || 0) | number:2}} paid)
                        </p>
                        <p class="mb-1">
                            <strong>Remaining Balance:</strong>
                            &#8369; {{(selectedOrderForDetails.remainingBalance || 0) | number:2}}
                        </p>
                        <p class="mb-2" ng-if="selectedOrderForDetails.monthlyInstallment && selectedOrderForDetails.installmentPlanMonths">
                            <strong>Installment Plan:</strong>
                            &#8369; {{selectedOrderForDetails.monthlyInstallment | number:2}} x {{selectedOrderForDetails.installmentPlanMonths}} month(s)
                        </p>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Installment #</th>
                                        <th>Due Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Proof</th>
                                        <th>Rejection Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="row in selectedOrderForDetails.installmentSchedule">
                                        <td>{{row.label}}</td>
                                        <td>{{row.dueDate}}</td>
                                        <td>&#8369; {{row.amount | number:2}}</td>
                                        <td>
                                            <span class="badge"
                                                  ng-class="{
                                                      'bg-success': row.status === 'Paid',
                                                      'bg-warning text-dark': row.status === 'Awaiting Verification',
                                                      'bg-secondary': row.status === 'Pending',
                                                      'bg-danger': row.status === 'Rejected' || row.status === 'Overdue' || row.status === 'Expired' || row.status === 'Rejected - Please Resubmit'
                                                  }">
                                                {{row.status}}
                                            </span>
                                        </td>
                                        <td>
                                            <span ng-if="row.proofImageUrl">
                                                <a ng-href="{{row.proofImageUrl}}" target="_blank" rel="noopener">View proof</a>
                                            </span>
                                            <span class="text-muted" ng-if="!row.proofImageUrl">No data available</span>
                                        </td>
                                        <td>{{row.rejectionReason || '-'}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="buyer-order-delivery-info mt-3 p-3 rounded" style="background:#f8f9fa;"
                         ng-if="(selectedOrderForDetails.courier || selectedOrderForDetails.trackingNumber) && (getOverallStatus(selectedOrderForDetails) === 'In Delivery' || getOverallStatus(selectedOrderForDetails) === 'Completed' || getOverallStatus(selectedOrderForDetails) === 'Delivered')">
                        <h6 class="fw-bold mb-2">Delivery</h6>
                        <p class="mb-1"><strong>Courier:</strong> {{selectedOrderForDetails.courier || '-'}}</p>
                        <p class="mb-1">
                            <strong>Tracking Number:</strong>
                            <span>{{selectedOrderForDetails.trackingNumber || '-'}}</span>
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 ms-2"
                                    ng-if="selectedOrderForDetails.trackingNumber"
                                    ng-click="copyTrackingNumber(selectedOrderForDetails.trackingNumber)">
                                Copy to Clipboard
                            </button>
                        </p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.dispatchDate"><strong>Dispatch Date:</strong> {{selectedOrderForDetails.dispatchDate}}</p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.eta"><strong>ETA:</strong> {{selectedOrderForDetails.eta}}</p>
                        <p class="mb-1"
                           ng-if="selectedOrderForDetails.trackingNumber">
                            <a href="#"
                               ng-click="goToTracking(selectedOrderForDetails.trackingNumber, selectedOrderForDetails.trackingLink, selectedOrderForDetails.courier); $event.preventDefault();"
                               class="btn btn-sm btn-outline-primary">
                                Open Courier Tracking
                            </a>
                        </p>
                        <p class="small text-muted mb-0 mt-2"
                           ng-if="(selectedOrderForDetails.courier && selectedOrderForDetails.courier.toLowerCase().indexOf('fedex') !== -1)
                                  || (selectedOrderForDetails.trackingLink && selectedOrderForDetails.trackingLink.toLowerCase().indexOf('fedex') !== -1)">
                            Note: Please copy the tracking number and paste it on the FedEx tracking page to track your parcel.
                        </p>
                        <p class="small text-muted mb-0 mt-2"
                           ng-if="(!selectedOrderForDetails.courier || selectedOrderForDetails.courier.toLowerCase().indexOf('fedex') === -1)
                                  && (!selectedOrderForDetails.trackingLink || selectedOrderForDetails.trackingLink.toLowerCase().indexOf('fedex') === -1)">
                            Note: Please copy the tracking number and paste it on the LBC tracking page to track your parcel.
                        </p>
                    </div>
                </div>
                <div class="modal-footer border-0 d-flex flex-wrap gap-2 justify-content-end">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            ng-if="selectedOrderForDetails.hasSubmittedPayment && selectedOrderForDetails.latestPaymentForProof"
                            ng-click="openViewPaymentProofModalFromOrders(selectedOrderForDetails)">
                        View Payment Proof
                    </button>
                    <button type="button" class="btn btn-success"
                            ng-if="!selectedOrderForDetails.isArchived
                                   && (getOverallStatus(selectedOrderForDetails) === 'Approved'
                                       || getOverallStatus(selectedOrderForDetails) === 'Pending Payment'
                                       || (getOverallStatus(selectedOrderForDetails) === 'Resubmit Payment Required'))
                                   && selectedOrderForDetails.paymentType !== 'LAYAWAY'
                                   && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)"
                            ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">
                        {{ selectedOrderForDetails.latestPaymentRejectionReason ? 'Resubmit' : 'Pay Now' }}
                    </button>
                    <button type="button" class="btn btn-success"
                            ng-if="!selectedOrderForDetails.isArchived
                                   && (getOverallStatus(selectedOrderForDetails) === 'Approved'
                                       || getOverallStatus(selectedOrderForDetails) === 'Pending Downpayment')
                                   && selectedOrderForDetails.paymentType === 'LAYAWAY'
                                   && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)"
                            ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">
                        Pay Downpayment
                    </button>
                    <button type="button" class="btn btn-success"
                            ng-if="!selectedOrderForDetails.isArchived
                                   && getOverallStatus(selectedOrderForDetails) === 'Layaway Active'
                                   && selectedOrderForDetails.remainingBalance > 0
                                   && (selectedOrderForDetails.hasSubmittedPayment !== true && selectedOrderForDetails.HasSubmittedPayment !== true)"
                            ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">
                        Pay Installment
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* View Payment Proof modal (Under Review) *@
    <div class="modal fade" id="viewPaymentProofModalMyOrders" tabindex="-1" aria-hidden="true" ng-if="selectedOrderForProof && selectedOrderForProof.latestPaymentForProof">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">View Payment Proof</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeViewPaymentProofModal()"></button>
                </div>
                <div class="modal-body" ng-if="selectedOrderForProof.latestPaymentForProof">
                    <p class="mb-2"><strong>Status:</strong> <span ng-class="{'text-warning': selectedOrderForProof.latestPaymentForProof.paymentStatus === 'SUBMITTED', 'text-danger': selectedOrderForProof.latestPaymentForProof.paymentStatus === 'REJECTED'}">{{selectedOrderForProof.latestPaymentForProof.paymentStatus === 'SUBMITTED' ? 'Awaiting Verification' : (selectedOrderForProof.latestPaymentForProof.paymentStatus === 'REJECTED' ? 'Rejected - Please Resubmit' : (selectedOrderForProof.latestPaymentForProof.paymentStatus === 'VERIFIED' ? 'Verified' : 'Awaiting Verification'))}}</span></p>
                    <p class="mb-2"><strong>Amount:</strong> &#8369; {{selectedOrderForProof.latestPaymentForProof.amount | number:2}}</p>
                    <p class="mb-2"><strong>Date submitted:</strong> {{selectedOrderForProof.latestPaymentForProof.createdAt}}</p>
                    <p class="mb-2" ng-if="selectedOrderForProof.latestPaymentForProof.referenceNumber"><strong>Reference number:</strong> {{selectedOrderForProof.latestPaymentForProof.referenceNumber}}</p>
                    <div class="mb-2" ng-if="selectedOrderForProof.latestPaymentForProof.proofImageUrl">
                        <strong>Uploaded image</strong>
                        <img ng-src="{{selectedOrderForProof.latestPaymentForProof.proofImageUrl}}" alt="Proof" class="img-fluid rounded border mt-1" style="max-height: 280px;" />
                    </div>
                    <p class="text-danger mb-0" ng-if="selectedOrderForProof.latestPaymentForProof.paymentStatus === 'REJECTED' && selectedOrderForProof.latestPaymentForProof.rejectionReason"><strong>Rejection reason:</strong> {{selectedOrderForProof.latestPaymentForProof.rejectionReason}}</p>
                </div>
            </div>
        </div>
    </div>
</div>
