@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/SolteiraBrandsStyle/MyOrders.css" />

<div class="my-orders-text">
    <span>MY ORDERS (1)</span>
</div>

<hr class="hr-line" />

<div class="my-orders-page-wrapper">
    <div class="my-orders-container">

        <div class="search-container">
            <div class="search-wrapper">
                <input type="text" placeholder="Search by Order ID, Product Name" class="order-search-input" />
                <span class="search-icon-btn">
                    <i class="bi bi-search"></i>
                </span>
            </div>
        </div>

        <div class="orders-section">
            <div class="order-status">
                <span>Order: <span class="status-weight">Pending</span></span>
            </div>

            <div class="order-card-white">
                <div class="order-products">
                    <div class="product-row">
                        <div class="product-info">
                            <img src="~/Content/SolteiraBrandsImages/SBJewelryImages/many-shape-bracelet.png" alt="Tennis Bracelet" class="product-img" />
                            <div class="product-details">
                                <span class="product-name">Many Shape Tennis Bracelet</span>
                                <span class="product-desc">5 Total Carat Diamond</span>
                                <span class="product-desc">18K - White Gold</span>
                                <span class="product-desc">9.6 grams, 18cm</span>
                                <span class="product-qty">Qty: 1</span>
                            </div>
                        </div>
                        <div class="product-price">P 55, 790.00</div>
                    </div>

                    <div class="product-row">
                        <div class="product-info">
                            <img src="~/Content/SolteiraBrandsImages/SBJewelryImages/tiara-ring-whitegold.png" alt="Tiara Ring" class="product-img" />
                            <div class="product-details">
                                <span class="product-name">Tiara Ring - White Gold</span>
                                <span class="product-desc">1 Total Carat Diamond</span>
                                <span class="product-desc">18K - White Gold</span>
                                <span class="product-desc">4.5 grams</span>
                                <span class="product-qty">Qty: 1</span>
                            </div>
                        </div>
                        <div class="product-price">P 34, 478.00</div>
                    </div>
                </div>

                <div class="order-total-section">
                    <span class="total-label">Total: </span>
                    <span class="total-amount">P 90, 468.00</span>
                </div>
            </div>
        </div>
    </div>
</div>

