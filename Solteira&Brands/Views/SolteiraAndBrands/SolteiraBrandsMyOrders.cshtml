@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/MyOrders.css" />

<div class="my-orders-main-wrapper" ng-controller="SolteiraBrandsController" ng-init="loadMyOrders()">

    <div class="my-orders-text">
        <span>MY ORDERS</span>
    </div>

    <hr class="hr-line" />

    <div class="my-orders-page-wrapper">
        <div class="my-orders-container">

            <div class="table-responsive" ng-if="orders.length > 0">
                <table class="table table-striped table-hover align-middle my-orders-table" id="myOrdersTable">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Payment Type</th>
                            <th class="text-center">Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="orders-section-row" ng-repeat="order in orders" ng-attr.data-order-id="{{order.orderNumber}}">
                            <td>{{order.orderNumber}}</td>
                            <td>{{order.orderDate | date:'MMM d, y'}}</td>
                            <td>&#8369; {{order.total | number:2}}</td>
                            <td>{{order.paymentType === 'LAYAWAY' ? 'LAYAWAY' : 'FULL'}}</td>
                            <td class="text-center"><span class="status-weight">{{getOverallStatus(order)}}</span><span class="badge bg-warning text-dark ms-1 small" ng-if="getOverallStatus(order) === 'Layaway Active' && order.hasSubmittedPayment">Installment Under Review</span></td>
                            <td>
                                <button type="button" class="btn-order-action" ng-click="handleOrderAction(order); $event.stopPropagation();">{{getOrderActionLabel(order)}}</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div ng-if="orders.length === 0" style="text-align:center; padding: 50px; color: #888;">
                <i class="bi bi-bag-x" style="font-size: 3rem;"></i>
                <p>You haven't placed any orders yet.</p>
            </div>

        </div>
    </div>

    @* Buyer-side Order Details modal (order summary) *@
    <div class="modal fade" id="buyerOrderDetailsModal" tabindex="-1" aria-labelledby="buyerOrderDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content buyer-order-details-modal" ng-if="selectedOrderForDetails">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title buyer-order-details-title" id="buyerOrderDetailsModalLabel">Order Summary</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeOrderDetailsModal()"></button>
                </div>
                <div class="modal-body buyer-order-details-body">
                    <p class="buyer-order-status-line">
                        <span class="buyer-order-status-label">Status:</span>
                        <span class="buyer-order-status-value">{{getOverallStatus(selectedOrderForDetails)}}</span>
                        <span class="badge bg-warning text-dark ms-1 small" ng-if="getOverallStatus(selectedOrderForDetails) === 'Layaway Active' && selectedOrderForDetails.hasSubmittedPayment">Installment Under Review</span>
                    </p>
                    <div class="buyer-order-summary-card">
                        <div class="buyer-order-item" ng-repeat="item in selectedOrderForDetails.items">
                            <img ng-src="{{item.img || defaultProductImageUrl}}" class="buyer-order-item-img" alt="{{item.name}}" />
                            <div class="buyer-order-item-details">
                                <span class="buyer-order-item-name">{{item.name}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.stones">{{item.stones}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.material">{{item.material}}</span>
                                <span class="buyer-order-item-specs" ng-if="item.weight">{{item.weight}}</span>
                                <span class="buyer-order-item-qty">Qty: {{item.qty}}</span>
                            </div>
                            <div class="buyer-order-item-price">&#8369; {{(item.price * item.qty) | number:2}}</div>
                        </div>
                        <div class="buyer-order-total-row">
                            <span class="buyer-order-total-label">Total</span>
                            <span class="buyer-order-total-value">&#8369; {{selectedOrderForDetails.total | number:2}}</span>
                        </div>
                    </div>
                    <div class="buyer-order-meta mt-3">
                        <p class="mb-1"><strong>Order #</strong> {{selectedOrderForDetails.orderNumber}}</p>
                        <p class="mb-1"><strong>Date</strong> {{selectedOrderForDetails.orderDate | date:'MMM d, y'}}</p>
                        <p class="mb-1"><strong>Payment</strong> {{selectedOrderForDetails.paymentType === 'LAYAWAY' ? 'LAYAWAY' : 'FULL'}}</p>
                        <p ng-if="selectedOrderForDetails.status === 'Rejected' && selectedOrderForDetails.rejectionReason" class="text-danger mb-0"><strong>Rejection reason:</strong> {{selectedOrderForDetails.rejectionReason}}</p>
                        <p ng-if="selectedOrderForDetails.status === 'Approved' && selectedOrderForDetails.latestPaymentRejectionReason" class="text-warning mb-0"><strong>Payment was rejected:</strong> {{selectedOrderForDetails.latestPaymentRejectionReason}} You can submit a new proof via Pay Now.</p>
                        <p ng-if="selectedOrderForDetails.paymentType === 'LAYAWAY' && selectedOrderForDetails.status === 'Cancelled'" class="text-danger mb-0">
                            Your layaway order has been cancelled due to missed payment deadline. All payments made are non-refundable.
                        </p>
                        <p ng-if="selectedOrderForDetails.paymentType !== 'LAYAWAY' && selectedOrderForDetails.status === 'Cancelled' && selectedOrderForDetails.rejectionReason" class="text-danger mb-0"><strong>Cancellation reason:</strong> {{selectedOrderForDetails.rejectionReason}}</p>
                        <p ng-if="selectedOrderForDetails.paymentType !== 'LAYAWAY' && selectedOrderForDetails.status === 'Cancelled' && !selectedOrderForDetails.rejectionReason" class="text-muted mb-0">This order was cancelled.</p>
                    </div>
                    <div class="buyer-order-layaway-info mt-3 p-3 rounded" style="background:#f8f9fa;"
                         ng-if="selectedOrderForDetails.paymentType === 'LAYAWAY' && selectedOrderForDetails.installmentSchedule && selectedOrderForDetails.installmentSchedule.length">
                        <h6 class="fw-bold mb-2">Layaway Progress</h6>
                        <p class="mb-1" ng-if="selectedOrderForDetails.downpaymentPercentage">
                            <strong>Downpayment:</strong>
                            {{selectedOrderForDetails.downpaymentPercentage | number:0}}%
                            (&#8369; {{(selectedOrderForDetails.downpaymentPaid || 0) | number:2}} paid)
                        </p>
                        <p class="mb-1">
                            <strong>Remaining Balance:</strong>
                            &#8369; {{(selectedOrderForDetails.remainingBalance || 0) | number:2}}
                        </p>
                        <p class="mb-2" ng-if="selectedOrderForDetails.monthlyInstallment && selectedOrderForDetails.installmentPlanMonths">
                            <strong>Installment Plan:</strong>
                            &#8369; {{selectedOrderForDetails.monthlyInstallment | number:2}} x {{selectedOrderForDetails.installmentPlanMonths}} month(s)
                        </p>
                        <p class="mb-2" ng-if="selectedOrderForDetails.remainingBalance > 0 && selectedOrderForDetails.nextDueDate">
                            <strong>Next due:</strong> {{selectedOrderForDetails.nextDueDate}}
                            <span ng-if="selectedOrderForDetails.nextDueAmount"> - &#8369; {{selectedOrderForDetails.nextDueAmount | number:2}}</span>
                            <span class="badge bg-danger ms-1" ng-if="selectedOrderForDetails.nextDueOverdue">Overdue</span>
                        </p>
                        <div class="mb-2" ng-if="selectedOrderForDetails.total && selectedOrderForDetails.remainingBalance != null">
                            <p class="mb-1"><strong>Progress:</strong> {{((selectedOrderForDetails.total - selectedOrderForDetails.remainingBalance) / selectedOrderForDetails.total * 100) | number:2}}% (&#8369; {{(selectedOrderForDetails.total - selectedOrderForDetails.remainingBalance) | number:2}} paid)</p>
                            <div class="layaway-progress-bar rounded" style="height: 10px; background: #e9ecef;">
                                <div class="layaway-progress-fill rounded" ng-style="{'width': (selectedOrderForDetails.total - selectedOrderForDetails.remainingBalance) / selectedOrderForDetails.total * 100 + '%'}" style="height: 10px; background: #28a745;"></div>
                            </div>
                            <p class="small mb-0 mt-1 text-muted" ng-if="selectedOrderForDetails.currentDate"><strong>Current Date:</strong> {{selectedOrderForDetails.currentDate}}</p>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Installment #</th>
                                        <th>Due Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Proof</th>
                                        <th>Rejection Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="row in selectedOrderForDetails.installmentSchedule">
                                        <td>{{row.label}}</td>
                                        <td>{{row.dueDate}}</td>
                                        <td>&#8369; {{row.amount | number:2}}</td>
                                        <td>
                                            <span class="badge"
                                                  ng-class="{
                                                      'bg-success': row.status === 'Paid',
                                                      'bg-warning text-dark': row.status === 'Pending' || row.status === 'Awaiting Verification',
                                                      'bg-danger': row.status === 'Rejected' || row.status === 'Overdue' || row.status === 'Expired',
                                                      'bg-secondary': row.status === 'Cancelled'
                                                  }">
                                                {{row.status}}
                                            </span>
                                        </td>
                                        <td>
                                            <span ng-if="row.proofImageUrl">
                                                <a ng-href="{{row.proofImageUrl}}" target="_blank" rel="noopener">View proof</a>
                                            </span>
                                            <span class="text-muted" ng-if="!row.proofImageUrl">No data available</span>
                                        </td>
                                        <td>{{row.rejectionReason || '-'}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="buyer-order-delivery-info mt-3 p-3 rounded" style="background:#f8f9fa;" ng-if="selectedOrderForDetails.courier || selectedOrderForDetails.trackingNumber">
                        <h6 class="fw-bold mb-2">Delivery</h6>
                        <p class="mb-1"><strong>Courier:</strong> {{selectedOrderForDetails.courier || '-'}}</p>
                        <p class="mb-1"><strong>Tracking Number:</strong> {{selectedOrderForDetails.trackingNumber || '-'}}</p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.dispatchDate"><strong>Dispatch Date:</strong> {{selectedOrderForDetails.dispatchDate}}</p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.eta"><strong>ETA:</strong> {{selectedOrderForDetails.eta}}</p>
                        <p class="small text-muted mb-0 mt-2" ng-if="selectedOrderForDetails.courier && selectedOrderForDetails.courier.indexOf('Custom') === 0">Please track your shipment directly via the courier's official website.</p>
                    </div>
                    <div class="buyer-order-meetup-info mt-3 p-3 rounded position-relative" ng-class="{'buyer-meetup-has-outcome': selectedOrderForDetails.meetupOutcomeStatus || selectedOrderForDetails.meetupRescheduledDateFormatted || selectedOrderForDetails.meetupRescheduledDate}" ng-if="selectedOrderForDetails.deliveryType === 'MEETUP'">
                        <span class="badge buyer-meetup-status-badge bg-warning text-dark position-absolute top-0 end-0 mt-2 me-2" ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'NO_SHOW'">No Show - Rescheduled</span>
                        <span class="badge buyer-meetup-status-badge bg-danger position-absolute top-0 end-0 mt-2 me-2" ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'CANCELLED'">Cancelled</span>
                        <span class="badge buyer-meetup-status-badge bg-success position-absolute top-0 end-0 mt-2 me-2" ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'COMPLETED'">Completed</span>
                        <h6 class="fw-bold mb-2">Cash Through Meetup</h6>
                        <p class="mb-1" ng-if="selectedOrderForDetails.meetupScheduledAtFormatted"><strong>Original meetup date &amp; time:</strong> {{selectedOrderForDetails.meetupScheduledAtFormatted}}</p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.meetupOutcomeStatus"><strong>Outcome:</strong>
                            <span class="fw-bold" ng-class="{'text-warning': selectedOrderForDetails.meetupOutcomeStatus === 'NO_SHOW', 'text-danger': selectedOrderForDetails.meetupOutcomeStatus === 'CANCELLED', 'text-success': selectedOrderForDetails.meetupOutcomeStatus === 'COMPLETED'}">
                                <span ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'NO_SHOW'">No Show</span>
                                <span ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'CANCELLED'">Cancelled</span>
                                <span ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'COMPLETED'">Completed</span>
                                <span ng-if="selectedOrderForDetails.meetupOutcomeStatus !== 'NO_SHOW' && selectedOrderForDetails.meetupOutcomeStatus !== 'CANCELLED' && selectedOrderForDetails.meetupOutcomeStatus !== 'COMPLETED'">{{selectedOrderForDetails.meetupOutcomeStatus}}</span>
                            </span>
                        </p>
                        <p class="mb-1" ng-if="selectedOrderForDetails.meetupReason"><strong>Reason:</strong> {{selectedOrderForDetails.meetupReason}}</p>
                        <p class="mb-1 buyer-meetup-reschedule-highlight" ng-if="selectedOrderForDetails.meetupRescheduledDateFormatted || selectedOrderForDetails.meetupRescheduledDate"><strong>Rescheduled date &amp; time:</strong> <span class="fw-bold">{{selectedOrderForDetails.meetupRescheduledDateFormatted || selectedOrderForDetails.meetupRescheduledDate}}</span></p>
                        <p class="mb-0" ng-if="selectedOrderForDetails.meetupOutcomeStatus === 'COMPLETED' && selectedOrderForDetails.meetupReceiptImageUrl">
                            <strong>Receipt:</strong> <a ng-href="{{selectedOrderForDetails.meetupReceiptImageUrl}}" target="_blank" rel="noopener">View receipt image</a>
                        </p>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" ng-click="closeOrderDetailsModal()">Close</button>
                    <button type="button" class="btn btn-success" ng-if="selectedOrderForDetails.status === 'Approved' && selectedOrderForDetails.paymentType !== 'LAYAWAY'" ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">{{ (selectedOrderForDetails.latestPaymentForProof && selectedOrderForDetails.latestPaymentForProof.paymentStatus === 'REJECTED' && selectedOrderForDetails.latestPaymentForProof.allowResubmit) ? 'Resubmit' : 'Pay Now' }}</button>
                    <button type="button" class="btn btn-success" ng-if="(selectedOrderForDetails.status === 'Layaway Active' || (selectedOrderForDetails.paymentType === 'LAYAWAY' && selectedOrderForDetails.remainingBalance > 0 && selectedOrderForDetails.verifiedPaymentsCount >= 1)) && !selectedOrderForDetails.hasSubmittedPayment" ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">Pay Installment</button>
                    <button type="button" class="btn btn-success" ng-if="selectedOrderForDetails.status === 'Approved' && selectedOrderForDetails.paymentType === 'LAYAWAY' && !selectedOrderForDetails.hasSubmittedPayment" ng-click="goToPaymentFromOrderModal(selectedOrderForDetails)">Pay Now</button>
                    <button type="button" class="btn btn-primary" ng-if="selectedOrderForDetails.status === 'In Delivery'" ng-click="goToTracking(selectedOrderForDetails.trackingNumber)">Track Now</button>
                </div>
            </div>
        </div>
    </div>

    @* View Payment Proof modal (Under Review) *@
    <div class="modal fade" id="viewPaymentProofModalMyOrders" tabindex="-1" aria-hidden="true" ng-if="selectedOrderForProof && selectedOrderForProof.latestPaymentForProof">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">View Payment Proof</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closeViewPaymentProofModal()"></button>
                </div>
                <div class="modal-body" ng-if="selectedOrderForProof.latestPaymentForProof">
                    <p class="mb-2"><strong>Status:</strong> <span ng-class="{'text-warning': selectedOrderForProof.latestPaymentForProof.paymentStatus === 'SUBMITTED', 'text-danger': selectedOrderForProof.latestPaymentForProof.paymentStatus === 'REJECTED'}">{{selectedOrderForProof.latestPaymentForProof.paymentStatus === 'SUBMITTED' ? 'Under Review' : selectedOrderForProof.latestPaymentForProof.paymentStatus}}</span></p>
                    <p class="mb-2"><strong>Amount:</strong> &#8369; {{selectedOrderForProof.latestPaymentForProof.amount | number:2}}</p>
                    <p class="mb-2"><strong>Date submitted:</strong> {{selectedOrderForProof.latestPaymentForProof.createdAt}}</p>
                    <p class="mb-2" ng-if="selectedOrderForProof.latestPaymentForProof.referenceNumber"><strong>Reference number:</strong> {{selectedOrderForProof.latestPaymentForProof.referenceNumber}}</p>
                    <div class="mb-2" ng-if="selectedOrderForProof.latestPaymentForProof.proofImageUrl">
                        <strong>Uploaded image</strong>
                        <img ng-src="{{selectedOrderForProof.latestPaymentForProof.proofImageUrl}}" alt="Proof" class="img-fluid rounded border mt-1" style="max-height: 280px;" />
                    </div>
                    <p class="text-danger mb-0" ng-if="selectedOrderForProof.latestPaymentForProof.paymentStatus === 'REJECTED' && selectedOrderForProof.latestPaymentForProof.rejectionReason"><strong>Rejection reason:</strong> {{selectedOrderForProof.latestPaymentForProof.rejectionReason}}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" ng-click="closeViewPaymentProofModal()">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
