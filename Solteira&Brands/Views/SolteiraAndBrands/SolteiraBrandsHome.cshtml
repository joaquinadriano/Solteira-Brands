@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/HomeStyle.css"/>

<div class="home-banner">

    <img src="@Url.Content("~/Content/img/home/Solteira&BrandsHomeBanner.png")" class="home-banner-img img-fluid"/>

    <div class="home-overlay ">

        <div class="home-description">
            Experience the luxury of natural diamonds,<br>
            exquisitely set in real gold and platinum.
        </div>
        <div class="button-wrapper">
            <a class="shop-btn text-decoration-none" href="@Url.Action("SolteiraBrandsJewelries", "SolteiraAndBrands")">
                Shop Now
            </a>
        </div>
    </div>

</div>

<div class="home-products" ng-controller="SolteiraBrandsController" ng-init="loadStorefrontProducts()">

    <div class="featured-title">FEATURED PRODUCTS</div>

    <div class="featured-carousel-container" ng-if="featuredCarouselSlides.length > 0" ng-mouseenter="stopFeaturedCarousel()" ng-mouseleave="startFeaturedCarousel()">
        <button type="button" class="featured-carousel-btn featured-carousel-prev carousel-arrow left" aria-label="Previous" ng-click="prevFeaturedSlide()" ng-disabled="featuredCarouselSlides.length <= 1">
            <i class="bi bi-chevron-left"></i>
        </button>
        <div class="featured-carousel">
            <div class="featured-carousel-viewport">
                <div class="carousel-track" ng-style="{'transform': 'translateX(-' + (currentFeaturedSlide * 100) + '%)'}">
                    <div class="carousel-slide" ng-repeat="slide in featuredCarouselSlides track by $index">
                        <div class="home-products-grid home-products-grid-max4">
                            <a ng-repeat="item in slide track by item.id" href="javascript:void(0)" class="featured-product-card" ng-click="goToProduct(item)">
                                <div class="featured-card-image">
                                    <img ng-src="{{item.img || defaultProductImageUrl}}" alt="{{item.name}}" />
                                </div>
                                <span class="featured-card-category">{{item.category || 'Jewelry'}}</span>
                                <span class="featured-card-name">{{item.name}}</span>
                                <p class="featured-card-desc">{{getShortDescription(item)}}</p>
                                <span class="featured-card-price">&#8369; {{item.price | number:2}}</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button type="button" class="featured-carousel-btn featured-carousel-next carousel-arrow right" aria-label="Next" ng-click="nextFeaturedSlide()" ng-disabled="featuredCarouselSlides.length <= 1">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>

</div>