@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/HomeStyle.css"/>

<div class="home-banner">

    <img src="@Url.Content("~/Content/img/home/Solteira&BrandsHomeBanner.png")" class="home-banner-img img-fluid"/>

    <div class="home-overlay ">

        <div class="home-description">
            Experience the luxury of natural diamonds,<br>
            exquisitely set in real gold and platinum.
        </div>
        <div class="button-wrapper">
            <a class="shop-btn text-decoration-none" href="@Url.Action("SolteiraBrandsJewelries", "SolteiraAndBrands")">
                Shop Now
            </a>
        </div>
    </div>

</div>

<div class="home-products" ng-controller="SolteiraBrandsController">

    <div class="featured-title">FEATURED PRODUCTS</div>

    <div class="home-content">

        <div ng-repeat="item in jewelries | limitTo: 4" ng-class="'jewelry' + ($index + 1)">
            <a href="javascript:void(0)" class="product-link" ng-click="goToProduct(item)">
                <img ng-src="{{item.img || defaultProductImageUrl}}" alt="{{item.name}}" />
                <span>{{item.name}}</span>
            </a>
        </div>

    </div>

</div>