@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/CheckoutStyle.css" />

<div class="checkout-page-wrapper">

    <div class="checkout-main-container" ng-controller="SolteiraBrandsController">

        <!-- LEFT: ORDER SUMMARY -->
        <div class="order-summary-section">

            <div class="checkout-item" ng-repeat="item in getSelectedItems()">
                <div class="checkout-item-img">
                    <img ng-src="{{item.img || defaultProductImageUrl}}"
                         alt="{{item.name}}" />
                </div>

                <div class="checkout-item-details">
                    <div class="checkout-item-header">
                        <span class="product-name">{{item.name}}</span>
                        <button type="button" class="remove-btn"
                                ng-click="removeFromCartByItem(item)">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="product-price">
                        &#8369; {{item.price | number:2}}
                    </div>

                    <span class="product-desc">{{item.stones}}</span>
                    <span class="product-desc">{{item.material}}</span>
                    <span class="product-desc" ng-if="item.weight">{{item.weight}}</span>

                    <span class="product-qty">
                        Quantity: {{item.qty}}
                    </span>
                </div>
            </div>

            <div class="total-row">
                <span>Total:</span>
                <span class="total-price">
                    &#8369; {{getCheckoutSubtotal() | number:2}}
                </span>
            </div>
        </div>

        <!-- RIGHT: CHECKOUT FORM -->
        <div class="checkout-form-card">
            <h3>CHECKOUT</h3>

            <form name="checkoutForm" novalidate>
            <div class="form-group">
                <label>Contact Name <span class="text-danger">*</span></label>
                <input type="text" name="customerName" placeholder="e.g. Juan dela Cruz"
                       ng-model="customerName" required ng-maxlength="30" maxlength="30" autocomplete="name"
                       ng-pattern="checkoutContactNamePattern" />
                <span class="validation-error" ng-show="checkoutForm.customerName.$error.required && (checkoutForm.customerName.$dirty || checkoutForm.customerName.$touched)">This field is required.</span>
                <span class="validation-error" ng-show="checkoutForm.customerName.$error.maxlength">Maximum 30 characters.</span>
                <span class="validation-error" ng-show="checkoutForm.customerName.$error.pattern && (checkoutForm.customerName.$dirty || checkoutForm.customerName.$touched)">Use letters only, with spaces or apostrophes, periods, or hyphens as needed. No numbers.</span>
            </div>

            <div class="form-group">
                <label>Contact Number <span class="text-danger">*</span></label>
                <input type="text" name="contactNumber" placeholder="09XXXXXXXXX"
                       ng-model="contactNumber" required maxlength="11" ng-pattern="/^\d{11}$/" />
                <span class="validation-error" ng-show="checkoutForm.contactNumber.$error.required && (checkoutForm.contactNumber.$dirty || checkoutForm.contactNumber.$touched)">This field is required.</span>
                <span class="validation-error" ng-show="checkoutForm.contactNumber.$error.pattern && checkoutForm.contactNumber.$dirty">Must be exactly 11 digits (e.g. 09XXXXXXXXX).</span>
            </div>

            <div class="form-group">
                <label>Delivery Address <span class="text-danger">*</span></label>
                <span class="address-field-label">Address Line 1 <span class="text-danger">*</span></span>
                <input type="text" name="deliveryLine1" placeholder="House/Unit No., Street, Barangay"
                       ng-model="deliveryLine1" required ng-maxlength="100" maxlength="100" autocomplete="address-line1" />
                <span class="validation-error" ng-show="checkoutForm.deliveryLine1.$error.required && (checkoutForm.deliveryLine1.$dirty || checkoutForm.deliveryLine1.$touched)">Address Line 1 is required.</span>

                <span class="address-field-label" style="margin-top: 0.5vw;">Address Line 2</span>
                <input type="text" name="deliveryLine2" placeholder="Building, Floor, Landmark (optional)"
                       ng-model="deliveryLine2" ng-maxlength="100" maxlength="100" autocomplete="address-line2" />

                <div class="address-row" style="margin-top: 0.5vw;">
                    <div class="address-field">
                        <span class="address-field-label">City <span class="text-danger">*</span></span>
                        <input type="text" name="deliveryCity" placeholder="City / Municipality"
                               ng-model="deliveryCity" required ng-maxlength="50" maxlength="50" autocomplete="address-level2" />
                        <span class="validation-error" ng-show="checkoutForm.deliveryCity.$error.required && (checkoutForm.deliveryCity.$dirty || checkoutForm.deliveryCity.$touched)">City is required.</span>
                    </div>
                    <div class="address-field">
                        <span class="address-field-label">Province <span class="text-danger">*</span></span>
                        <input type="text" name="deliveryProvince" placeholder="Province"
                               ng-model="deliveryProvince" required ng-maxlength="50" maxlength="50" autocomplete="address-level1" />
                        <span class="validation-error" ng-show="checkoutForm.deliveryProvince.$error.required && (checkoutForm.deliveryProvince.$dirty || checkoutForm.deliveryProvince.$touched)">Province is required.</span>
                    </div>
                    <div class="address-field address-field-zip">
                        <span class="address-field-label">ZIP Code <span class="text-danger">*</span></span>
                        <input type="text" name="deliveryZip" placeholder="ZIP Code"
                               ng-model="deliveryZip" required ng-maxlength="10" maxlength="10" ng-pattern="/^\d{4,10}$/" autocomplete="postal-code" />
                        <span class="validation-error" ng-show="checkoutForm.deliveryZip.$error.required && (checkoutForm.deliveryZip.$dirty || checkoutForm.deliveryZip.$touched)">ZIP is required.</span>
                        <span class="validation-error" ng-show="checkoutForm.deliveryZip.$error.pattern && checkoutForm.deliveryZip.$dirty">Enter a valid ZIP code.</span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Billing Address</label>
                <label class="custom-container billing-same-checkbox" style="margin-top: 0.5vw; font-size: 1rem; font-weight: normal;">
                    <input type="checkbox" ng-model="billingSameAsDelivery" ng-click="billingSameAsDelivery = $event.target.checked" id="billingSameCheck" />
                    <span class="custom-mark checkbox-mark"></span>
                    <span class="terms-text" style="font-size: 1rem;">Same as Delivery Address</span>
                </label>

                <div ng-show="!billingSameAsDelivery" style="margin-top: 0.75vw;">
                    <span class="address-field-label">Address Line 1 <span class="text-danger">*</span></span>
                    <input type="text" name="billingLine1" placeholder="House/Unit No., Street, Barangay"
                           ng-model="billingLine1" ng-required="!billingSameAsDelivery" ng-maxlength="100" maxlength="100" autocomplete="billing address-line1" />
                    <span class="validation-error" ng-show="!billingSameAsDelivery && checkoutForm.billingLine1.$error.required && (checkoutForm.billingLine1.$dirty || checkoutForm.billingLine1.$touched)">Address Line 1 is required.</span>

                    <span class="address-field-label" style="margin-top: 0.5vw;">Address Line 2</span>
                    <input type="text" name="billingLine2" placeholder="Building, Floor, Landmark (optional)"
                           ng-model="billingLine2" ng-maxlength="100" maxlength="100" autocomplete="billing address-line2" />

                    <div class="address-row" style="margin-top: 0.5vw;">
                        <div class="address-field">
                            <span class="address-field-label">City <span class="text-danger">*</span></span>
                            <input type="text" name="billingCity" placeholder="City / Municipality"
                                   ng-model="billingCity" ng-required="!billingSameAsDelivery" ng-maxlength="50" maxlength="50" autocomplete="billing address-level2" />
                            <span class="validation-error" ng-show="!billingSameAsDelivery && checkoutForm.billingCity.$error.required && (checkoutForm.billingCity.$dirty || checkoutForm.billingCity.$touched)">City is required.</span>
                        </div>
                        <div class="address-field">
                            <span class="address-field-label">Province <span class="text-danger">*</span></span>
                            <input type="text" name="billingProvince" placeholder="Province"
                                   ng-model="billingProvince" ng-required="!billingSameAsDelivery" ng-maxlength="50" maxlength="50" autocomplete="billing address-level1" />
                            <span class="validation-error" ng-show="!billingSameAsDelivery && checkoutForm.billingProvince.$error.required && (checkoutForm.billingProvince.$dirty || checkoutForm.billingProvince.$touched)">Province is required.</span>
                        </div>
                        <div class="address-field address-field-zip">
                            <span class="address-field-label">ZIP Code <span class="text-danger">*</span></span>
                            <input type="text" name="billingZip" placeholder="ZIP Code"
                                   ng-model="billingZip" ng-required="!billingSameAsDelivery" ng-maxlength="10" maxlength="10" ng-pattern="/^\d{4,10}$/" autocomplete="billing postal-code" />
                            <span class="validation-error" ng-show="!billingSameAsDelivery && checkoutForm.billingZip.$error.required && (checkoutForm.billingZip.$dirty || checkoutForm.billingZip.$touched)">ZIP is required.</span>
                            <span class="validation-error" ng-show="!billingSameAsDelivery && checkoutForm.billingZip.$error.pattern && checkoutForm.billingZip.$dirty">Enter a valid ZIP code.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="payment-options">
                <label>Payment Options <span class="text-danger">*</span></label>

                <div class="radio-option-container">
                    <label class="custom-container radio-option">
                        <input type="radio" name="payment" id="full" ng-model="paymentMethod" value="Full Payment" ng-change="agreeTerms = false" />
                        <span class="custom-mark radio-mark"></span>
                        <div class="label-text">
                            Full Payment <br>
                            <small>GCash, Bank Transfer, Cash through meetup</small>
                        </div>
                    </label>

                    <div class="payment-terms" ng-show="paymentMethod === 'Full Payment'">
                        <ol>
                            <li>
                                Full payment is required upon the completion of the checkout process for
                                all item(s) purchased on this website.
                            </li>
                            <li>
                                Customers are required to settle the full order amount within two (2) to three (3)
                                business days following the receipt of the official order confirmation email.
                            </li>
                            <li>
                                For Cash through meetup, a 30% down payment is required. Enter N/A for the delivery address. 
                                The meetup location is set by the seller, and date/time must be selected. 
                                Final details will be shown after order approval.
                            </li>
                        </ol>
                    </div>
                </div>

                <div class="radio-option-container">
                    <label class="custom-container radio-option">
                        <input type="radio" name="payment" id="layaway" ng-model="paymentMethod" value="Layaway" ng-change="agreeTerms = false" />
                        <span class="custom-mark radio-mark"></span>
                        <div class="label-text">
                            Layaway <br>
                            <small>GCash, Bank Transfer</small>
                        </div>
                    </label>

                    <div class="payment-terms layaway-details" ng-show="paymentMethod === 'Layaway'">
                        <div class="terms-group">
                            <strong>1. Reservation &amp; Payment Schedule</strong>
                            <ul>
                                <li>30% Down Payment is required immediately.</li>
                                <li>The remaining balance must be paid in monthly installments.</li>
                                <li>The item's price is fixed when you start the plan.</li>
                            </ul>
                        </div>
                        <div class="terms-group">
                            <strong>2. Policy on Non-Compliance &amp; Cancellation</strong>
                            <ul>
                                <li>Missing a payment or the final deadline automatically cancels your order.</li>
                                <li>All money paid will be kept by Solteira &amp; Brands.</li>
                                <li>The item will be put back up for sale.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="terms-checkbox" ng-if="paymentMethod">
                <label class="custom-container">
                    <input type="checkbox" id="agreeFull" ng-model="agreeTerms" ng-click="agreeTerms = $event.target.checked" />
                    <span class="custom-mark checkbox-mark"></span>
                    <span class="terms-text">
                        <span ng-show="paymentMethod === 'Full Payment'">
                            I acknowledge and agree to the Full Payment Terms and Conditions above.
                        </span>
                        <span ng-show="paymentMethod === 'Layaway'">
                            I acknowledge and agree to the Layaway Terms and Conditions above.
                        </span>
                    </span>
                </label>
            </div>

            <div class="order-btn-container">
                <button type="button" class="order-btn"
                        ng-click="placeOrder()"
                        ng-disabled="!isCheckoutReadyToPlaceOrder()">
                    ORDER
                </button>
            </div>
            </form>

        </div>
    </div>
</div>
