@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/CheckoutStyle.css"/>

<div class="checkout-main-container">
    <div class="order-summary-section">
        <div class="checkout-item">
            <div class="checkout-item-img">
                <img src="@Url.Content("~/Content/img/jewelry/many-shape-bracelet.png")" alt="Many Shape Tennis Bracelet" />
            </div>
            <div class="checkout-item-details">
                <div class="checkout-item-header">
                    <span class="product-name">Many Shape Tennis Bracelet</span>
                    <button class="remove-btn"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="product-price">P 55, 790.00</div>
                <span class="product-desc">5 Total Carat Diamond</span>
                <span class="product-desc">18K - White Gold</span>
                <span class="product-desc">9.6 grams, 18cm</span>
                <span class="product-qty">Quantity: 1</span>
            </div>
        </div>

        <div class="checkout-item">
            <div class="checkout-item-img">
                <img src="@Url.Content("~/Content/img/jewelry/tiara-ring-whitegold.png")" alt="Tiara Ring" />
            </div>
            <div class="checkout-item-details">
                <div class="checkout-item-header">
                    <span class="product-name">Tiara Ring - White Gold</span>
                    <button class="remove-btn"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="product-price">P 34, 478.00</div>
                <span class="product-desc">1 Total Carat Diamond</span>
                <span class="product-desc">18K - White Gold</span>
                <span class="product-desc">4.5 grams</span>
                <span class="product-qty">Quantity: 1</span>
            </div>
        </div>

        <div class="subtotal-row">
            <span>Subtotal:</span>
            <span class="total-price">P 90, 468.00</span>
        </div>
    </div>

    <div class="checkout-form-card">
        <h3>CHECKOUT</h3>

        <div class="form-group">
            <label>Name</label>
            <input type="text" value="Egg Sheeran" />
        </div>

        <div class="form-group">
            <label>Contact Number *</label>
            <input type="text" placeholder="Enter contact number" />
        </div>

        <div class="form-group">
            <label>Delivery Address *</label>
            <input type="text" placeholder="Enter delivery address" />
        </div>

        <div class="payment-options">
            <label>Payment Options *</label>
            <div class="radio-option">
                <input type="radio" name="payment" id="full" checked />
                <label for="full">Full Payment <br><small>Bank Transfer, GCash or Meta</small></label>
            </div>
            <div class="radio-option">
                <input type="radio" name="payment" id="layaway" />
                <label for="layaway">Layaway <br><small>Bank Transfer</small></label>
            </div>
        </div>

        <button class="order-btn">ORDER</button>
    </div>
</div>