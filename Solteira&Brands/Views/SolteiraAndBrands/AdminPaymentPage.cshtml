@{
    Layout = "~/Views/Shared/_OperationsLayout.cshtml";
}
<div class="main-content" ng-init="loadPayments(); startPaymentRefresh()">
    <div class="container-fluid payment-container px-1">
        <div class="row px-4 pb-0 mb-0 align-items-center">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0 mb-0">Payment</p>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#paymentSettingsModal" ng-click="openPaymentSettingsModal()">
                    <i class="bi bi-gear me-1"></i>Manage Payment Settings
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" ng-click="loadPayments()" title="Refresh list">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </div>
        </div>
        <div class="row px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="paymentTable">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Order No</th>
                            <th>Customer Name</th>
                            <th>Payment Date</th>
                            <th>Payment Option</th>
                            <th>Payment Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-repeat="payment in paymentsList">
                            <td>PMT-{{payment.paymentId}}</td>
                            <td>{{payment.orderNumber}}</td>
                            <td>{{payment.customerName}}</td>
                            <td>{{payment.paymentDateString}}</td>
                            <td>{{payment.paymentOption}}</td>
                            <td>{{payment.paymentMethod || '-'}}</td>
                            <td>&#8369; {{payment.amount | number:2}}</td>
                            <td><span class="badge" ng-class="getPaymentStatusBadgeClass(payment.paymentStatus)">{{payment.paymentStatus}}</span></td>
                            <td>
                                <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View Payment Details">
                                    <a class="order-action-icon" href="javascript:void(0)" ng-click="openPaymentProofModal(payment)">
                                        <img src="@Url.Content("~/Content/img/icons/view.svg")" alt="View" />
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <tr ng-if="paymentsList.length === 0">
                            <td colspan="9" class="text-center text-muted py-4">No payments yet. Payments appear here when buyers submit proof.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* View Payment modal — Order Details style layout *@
    <div class="modal fade" id="paymentDetailModal" tabindex="-1" aria-labelledby="paymentDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content orderDetails-modal-custom" style="background-color: #f8f9fa;" ng-if="paymentDetail">

                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <h2 class="fw-bold mb-0" id="paymentDetailModalLabel">Payment Details</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ng-click="closePaymentProofModal()"></button>
                    </div>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm rounded-4 mb-4">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="fw-bold mb-0">PMT-{{paymentDetail.paymentOverview.paymentId}} · Order {{paymentDetail.paymentOverview.orderNumber}}</h4>
                                        <span class="badge" ng-class="getPaymentStatusBadgeClass(paymentDetail.paymentOverview.paymentStatus)">{{paymentDetail.paymentOverview.paymentStatus}}</span>
                                    </div>
                                    <p class="text-muted mb-0">
                                        <i class="bi bi-calendar me-1"></i>
                                        {{paymentDetail.paymentOverview.createdAtString}}
                                    </p>
                                    <div class="mt-3">
                                        <span class="orderDetails-infoLabel">Amount</span>
                                        <p class="orderDetails-infoValue orderDetails-total mb-0">&#8369; {{paymentDetail.paymentOverview.amount | number:2}}</p>
                                    </div>
                                    <div class="mt-2" ng-if="paymentDetail.paymentOverview.referenceNumber">
                                        <span class="orderDetails-infoLabel">Reference</span>
                                        <p class="orderDetails-infoValue mb-0">{{paymentDetail.paymentOverview.referenceNumber}}</p>
                                    </div>
                                    <div class="mt-2" ng-if="paymentDetail.paymentOverview.rejectionReason">
                                        <span class="orderDetails-infoLabel text-danger">Rejection reason</span>
                                        <p class="text-danger small mb-0">{{paymentDetail.paymentOverview.rejectionReason}}</p>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="paymentDetail.orderSummary">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-person-circle me-2 orderDetails-icon"></i>
                                        Customer Information
                                    </h5>
                                    <div class="mb-3">
                                        <label class="orderDetails-infoLabel">Name</label>
                                        <p class="orderDetails-infoValue">{{paymentDetail.orderSummary.customerName}}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="orderDetails-infoLabel">Email</label>
                                        <p class="orderDetails-infoValue">{{paymentDetail.orderSummary.email}}</p>
                                    </div>
                                    <div>
                                        <label class="orderDetails-infoLabel">Contact No</label>
                                        <p class="orderDetails-infoValue">{{paymentDetail.orderSummary.contactNumber}}</p>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="paymentDetail.orderSummary">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-2">
                                        <i class="bi bi-geo-alt me-2 orderDetails-icon"></i>
                                        Delivery Address
                                    </h5>
                                    <p class="fw-bold mb-1">{{paymentDetail.orderSummary.customerName}}</p>
                                    <p class="mb-1">{{paymentDetail.orderSummary.deliveryAddress}}</p>
                                    <p class="mb-0 text-muted small">Contact: {{paymentDetail.orderSummary.contactNumber}}</p>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-2" ng-if="paymentDetail.deliveryInfo">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-truck me-2 orderDetails-icon"></i>
                                        Delivery Information
                                    </h5>
                                    <div class="mb-2"><span class="orderDetails-infoLabel">Courier</span><p class="orderDetails-infoValue mb-0">{{paymentDetail.deliveryInfo.courier || '-'}}</p></div>
                                    <div class="mb-2"><span class="orderDetails-infoLabel">Tracking Number</span><p class="orderDetails-infoValue mb-0">{{paymentDetail.deliveryInfo.trackingNumber || '-'}}</p></div>
                                    <div class="mb-2"><span class="orderDetails-infoLabel">Dispatch Date</span><p class="orderDetails-infoValue mb-0">{{paymentDetail.deliveryInfo.dispatchDateFormatted || '-'}}</p></div>
                                    <div class="mb-2"><span class="orderDetails-infoLabel">ETA</span><p class="orderDetails-infoValue mb-0">{{paymentDetail.deliveryInfo.etaFormatted || '-'}}</p></div>
                                    <div><span class="orderDetails-infoLabel">Delivery Status</span><p class="orderDetails-infoValue mb-0">{{paymentDetail.deliveryInfo.deliveryStatus || '-'}}</p></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="paymentDetail.orderSummary && paymentDetail.orderSummary.items.length">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-bag-check me-2 orderDetails-icon"></i>
                                        Order Items
                                    </h5>
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle mb-0">
                                            <thead class="border-bottom">
                                                <tr class="text-muted small text-uppercase">
                                                    <th>Item</th>
                                                    <th class="text-center">Quantity</th>
                                                    <th class="text-end">Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="border-bottom" ng-repeat="item in paymentDetail.orderSummary.items">
                                                    <td class="fw-bold py-3">{{item.productName}}</td>
                                                    <td class="text-center">{{item.quantity}}</td>
                                                    <td class="text-end">&#8369; {{item.unitPrice * item.quantity | number:2}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="paymentDetail.installmentSchedule && paymentDetail.installmentSchedule.length">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-calendar-check me-2 orderDetails-icon"></i>
                                        Installment Schedule
                                    </h5>
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle mb-0">
                                            <thead class="border-bottom">
                                                <tr class="text-muted small text-uppercase">
                                                    <th>Installment #</th>
                                                    <th>Due Date</th>
                                                    <th class="text-end">Amount</th>
                                                    <th>Status</th>
                                                    <th>Proof</th>
                                                    <th>Rejection reason</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="border-bottom" ng-repeat="row in paymentDetail.installmentSchedule">
                                                    <td class="fw-bold py-3">{{row.label || ('Month ' + row.installmentNumber)}}</td>
                                                    <td>{{row.dueDate}}</td>
                                                    <td class="text-end">&#8369; {{row.amount | number:2}}</td>
                                                    <td><span class="badge" ng-class="{'bg-success': row.status === 'Paid', 'bg-danger': row.status === 'Overdue' || row.status === 'Rejected', 'bg-warning text-dark': row.status === 'Awaiting Verification', 'bg-secondary': row.status === 'Pending' || row.status === 'Cancelled'}">{{row.status}}</span></td>
                                                    <td>
                                                        <a ng-if="row.proofImageUrl" ng-href="{{row.proofImageUrl}}" target="_blank" class="btn btn-sm btn-outline-secondary">View proof</a>
                                                        <span ng-if="!row.proofImageUrl" class="text-muted">No data available</span>
                                                    </td>
                                                    <td class="small" ng-class="{'text-danger': row.rejectionReason}">{{row.rejectionReason || '-'}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="paymentDetail.meetupSchedule && paymentDetail.orderSummary.deliveryType === 'MEETUP'">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-geo me-2 orderDetails-icon"></i>
                                        Meetup Schedule
                                    </h5>
                                    <p class="fw-bold mb-1">{{paymentDetail.meetupSchedule.locationName}}</p>
                                    <p class="mb-0 text-muted small">{{paymentDetail.meetupSchedule.address}}</p>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-4" ng-if="paymentDetail.paymentHistory && paymentDetail.paymentHistory.length">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-cash-stack me-2 orderDetails-icon"></i>
                                        Payment History
                                    </h5>
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle mb-0">
                                            <thead class="border-bottom">
                                                <tr class="text-muted small text-uppercase">
                                                    <th>Amount</th>
                                                    <th>Status</th>
                                                    <th>Reference</th>
                                                    <th>Proof</th>
                                                    <th>Date</th>
                                                    <th>Rejection reason</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="border-bottom" ng-repeat="p in paymentDetail.paymentHistory">
                                                    <td class="fw-bold">&#8369; {{p.amount | number:2}}</td>
                                                    <td><span class="badge" ng-class="getPaymentStatusBadgeClass(p.paymentStatus)">{{p.paymentStatus}}</span></td>
                                                    <td>{{p.referenceNumber || '-'}}</td>
                                                    <td>
                                                        <a ng-if="p.proofImageUrl" ng-href="{{p.proofImageUrl}}" target="_blank" class="btn btn-sm btn-outline-secondary">View proof</a>
                                                        <span ng-if="!p.proofImageUrl" class="text-muted">No data available</span>
                                                    </td>
                                                    <td class="small">{{p.verifiedAt || p.createdAt}}</td>
                                                    <td class="small" ng-class="{'text-danger': p.rejectionReason}">{{p.rejectionReason || '-'}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 mb-4">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-image me-2 orderDetails-icon"></i>
                                        Proof Viewer
                                    </h5>
                                    <div class="text-center">
                                        <img ng-src="{{paymentDetail.selectedPayment.proofImageUrl}}" class="img-fluid rounded border" style="max-height: 280px;" alt="Proof of Payment" ng-if="paymentDetail.selectedPayment.proofImageUrl" />
                                        <p ng-if="!paymentDetail.selectedPayment.proofImageUrl" class="text-muted mb-0">No data available</p>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">
                                        <i class="bi bi-credit-card me-2 orderDetails-icon"></i>
                                        Payment Summary
                                    </h5>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Payment Method</span>
                                        <span>{{paymentDetail.orderSummary.paymentMethod}}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Payment Type</span>
                                        <span>{{paymentDetail.paymentOverview.paymentOption || 'FULL'}}</span>
                                    </div>
                                    <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3 mt-2">
                                        <span>Total</span>
                                        <span class="orderDetails-total">&#8369; {{paymentDetail.orderSummary.totalAmount | number:2}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 flex-wrap">
                    <span class="order-status-display me-2">Status: <strong>{{paymentDetail.paymentOverview.paymentStatus}}</strong></span>
                    <span ng-if="selectedPayment && selectedPayment.paymentStatus === 'SUBMITTED'" class="me-2 d-flex flex-wrap align-items-start gap-2">
                        <div class="d-flex flex-column gap-1">
                            <button type="button" class="btn btn-success" ng-click="confirmVerifyPaymentFromModal()">Approve payment</button>
                            <span class="small text-muted">Resubmit option does not apply when approving.</span>
                        </div>
                        <div class="border-start ps-3" style="border-color: #dee2e6 !important;">
                            <p class="small fw-bold mb-1 text-secondary">When rejecting:</p>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Rejection reason (required)</label>
                                <textarea class="form-control form-control-sm" ng-model="paymentModalForm.rejectionReason" placeholder="Enter reason..." rows="2" style="max-width: 300px;"></textarea>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" id="allowResubmitCheckbox" ng-model="paymentModalForm.allowResubmit" />
                                <label class="form-check-label small" for="allowResubmitCheckbox">Allow buyer to resubmit payment</label>
                            </div>
                            <button type="button" class="btn btn-danger" ng-click="rejectPaymentFromModal()">Reject</button>
                        </div>
                    </span>
                    <button class="orderDetails-button px-4 py-2" data-bs-dismiss="modal" ng-click="closePaymentProofModal()">
                        <span>CLOSE</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Manage Payment Settings modal — 4 sections: GCash, Bank Transfer, Layaway, Meetup *@
    <div class="modal fade" id="paymentSettingsModal" tabindex="-1" aria-labelledby="paymentSettingsModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title fw-bold" id="paymentSettingsModalLabel">Manage Payment Settings</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">Only one active config per type. Saving replaces the active config and logs the action.</p>

                    <div class="border rounded p-3 mb-4">
                        <h6 class="fw-bold mb-3">1. GCash</h6>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Account Name</label>
                            <input type="text" class="form-control form-control-sm" ng-model="paymentSettingsForm.gcashAccountName" placeholder="Account name" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Account Number</label>
                            <input type="text" class="form-control form-control-sm" ng-model="paymentSettingsForm.gcashAccountNumber" placeholder="Account number" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">QR Image</label>
                            <div class="d-flex align-items-center gap-2">
                                <img ng-src="{{paymentSettingsForm.gcashQrImageUrl}}" class="img-thumbnail" style="max-height:80px;" ng-if="paymentSettingsForm.gcashQrImageUrl" alt="GCash QR" />
                                <input type="file" id="gcashQrUpload" accept=".jpg,.jpeg,.png" style="display:none;" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" ng-click="triggerQrUpload('gcash')">Upload QR</button>
                            </div>
                        </div>
                        <button type="button" class="btn btn-success btn-sm mt-2" ng-click="savePaymentSetting('GCASH')">Save GCash</button>
                    </div>

                    <div class="border rounded p-3 mb-4">
                        <h6 class="fw-bold mb-3">2. Bank Transfer</h6>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Bank / Account Name</label>
                            <input type="text" class="form-control form-control-sm" ng-model="paymentSettingsForm.bankAccountName" placeholder="Bank or account name" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Account Number</label>
                            <input type="text" class="form-control form-control-sm" ng-model="paymentSettingsForm.bankAccountNumber" placeholder="Account number" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">QR Image</label>
                            <div class="d-flex align-items-center gap-2">
                                <img ng-src="{{paymentSettingsForm.bankQrImageUrl}}" class="img-thumbnail" style="max-height:80px;" ng-if="paymentSettingsForm.bankQrImageUrl" alt="Bank QR" />
                                <input type="file" id="bankQrUpload" accept=".jpg,.jpeg,.png" style="display:none;" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" ng-click="triggerQrUpload('bank')">Upload QR</button>
                            </div>
                        </div>
                        <button type="button" class="btn btn-success btn-sm mt-2" ng-click="savePaymentSetting('BANK_TRANSFER')">Save Bank Transfer</button>
                    </div>

                    <div class="border rounded p-3 mb-4">
                        <h6 class="fw-bold mb-3">3. Layaway</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Downpayment %</label>
                                <input type="number" class="form-control form-control-sm" ng-model="paymentSettingsForm.downpaymentPercentage" min="1" max="100" step="0.01" placeholder="30" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-0">Months allowed</label>
                                <input type="number" class="form-control form-control-sm" ng-model="paymentSettingsForm.monthsAllowed" min="1" max="24" placeholder="3" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-success btn-sm mt-2" ng-click="saveLayawaySettings()">Save Layaway</button>
                    </div>

                    <div class="border rounded p-3 mb-2">
                        <h6 class="fw-bold mb-3">4. Meetup Location</h6>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Location Name</label>
                            <input type="text" class="form-control form-control-sm" ng-model="paymentSettingsForm.meetupLocationName" placeholder="e.g. LBC Angeles" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Address</label>
                            <textarea class="form-control form-control-sm" ng-model="paymentSettingsForm.meetupAddress" rows="2" placeholder="Full address"></textarea>
                        </div>
                        <button type="button" class="btn btn-success btn-sm mt-2" ng-click="saveMeetupSetting()">Save Meetup Location</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        function bindQrUpload(id, type) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('change', function () {
                var file = el.files[0];
                if (!file) return;
                var body = document.body;
                if (window.angular && body) {
                    var scope = window.angular.element(body).scope();
                    if (scope && scope.onQrFileSelected) scope.$apply(function () { scope.onQrFileSelected(file, type); });
                }
                el.value = '';
            });
        }
        setTimeout(function () {
            bindQrUpload('gcashQrUpload', 'gcash');
            bindQrUpload('bankQrUpload', 'bank');
        }, 800);
    })();
</script>
