@{
    Layout = "~/Views/Shared/_SABInventoryDashboardLayout.cshtml";
}
<div class="main-content">
    <div class="container-fluid payment-container px-1">
        <div class="row px-4 pb-0 mb-0">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Payment</p>
            </div>
        </div>
        <div class="row  px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="paymentTable">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Order ID</th>
                            <th>Customer Name</th>
                            <th>Payment Date</th>
                            <th>Payment Option</th>
                            <th>Payment Method</th>
                            <th>Reference Number</th>
                            <th>Proof of Payment</th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-init="orderStatus=''">
                            <td>PMT-001</td>
                            <td ng-click="orderDetails()" id="payment-orderID">ORD-001</td>
                            <td>Jerilee Rosales</td>
                            <td>12/25/2025</td>
                            <td>Full Payment</td>
                            <td>GCash</td>
                            <td id="payment-refNo">928456237189213</td>
                            <td id="paymentProof-link" 
                                data-bs-toggle="modal" 
                                data-bs-target="#paymentDetailModal"
                               >[View Proof of Payment]
                            </td>
                            @*modal view*@
                            <div class="modal fade" id="paymentDetailModal" tabindex="-1" aria-labelledby="paymentDetailModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content paymentProof-modal-content">
                                        @*close button*@
                                        <div class="modal-header border-0 pb-0">
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 pt-0">
                                            <h2 class="text-center fw-bold mb-4 paymentProof-title">Verify Payment</h2>
                                            <div class="row g-4">
                                                <div class="col-md-6 border-end paymentProof-divider">
                                                    <label class="paymentProof-label">Uploaded Proof of Payment</label>
                                                    <div class="paymentProof-image-container mt-2 text-center">
                                                        <img src="https://primaryhomes.com/uploads/media/Pay-QR4-1.jpg"
                                                             class="img-fluid rounded  paymentProof-img"
                                                             alt="Proof of Payment">
                                                    </div>
                                                </div>
                                                <div class="col-md-6 ps-md-4">
                                                    <label class="paymentProof-label mb-2">Transaction Information</label>

                                                    <div class="mb-3">
                                                        <span class="paymentProof-sublabel text-muted small">Customer Name</span>
                                                        <p class="paymentProof-value fw-bold">Jerilee Rosales</p>
                                                    </div>

                                                    <div class="mb-3">
                                                        <span class="paymentProof-sublabel text-muted small">Reference Number</span>
                                                        <p class="paymentProof-value paymentProof-ref-highlight">928456237189213</p>
                                                    </div>

                                                    <div class="mb-3">
                                                        <span class="paymentProof-sublabel text-muted small">Amount Paid</span>
                                                        <p class="paymentProof-value paymentProof-amount fw-bold text-success">P 4,500.00</p>
                                                    </div>
                                                    @*Verify if the content of pof is same with the text*@
                                                    <div class="verification-section mt-4 p-3 rounded" >
                                                        <label class="paymentProof-label mb-2 d-block" style="font-size: 0.9rem;">Verify Proof of Transaction</label>
                                                        <div class="d-grid gap-2">
                                                            <button type="button" class="btn btn-confirm-match btn-sm py-2">
                                                                <i class="bi bi-check-circle me-1"></i>Confirm
                                                            </button>
                                                            <button type="button" class="btn btn-reject-match btn-sm py-2">
                                                                <i class="bi bi-x-circle me-1"></i> Reject
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>.
        @*----------Table end----------*@
    </div>
</div>