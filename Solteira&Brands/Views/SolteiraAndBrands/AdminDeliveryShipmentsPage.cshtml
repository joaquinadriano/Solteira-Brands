@{
    Layout = "~/Views/Shared/_SABInventoryDashboardLayout.cshtml";
}
<div class="main-content">
    <div class="container-fluid delivery-container px-1">
        <div class="row px-4 pb-0 mb-0 ">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Delivery - Shipments</p>
            </div>
            <div class="col d-flex justify-content-end">
                <button type="button" class="btn-add-order px-2 py-1" data-bs-toggle="modal" data-bs-target="#deliveryAddShipmentModal">
                    <i class="bi bi-plus plus-icon"></i> Add Order
                </button>
                @*Modal - Add Order*@
                <div class="modal fade" id="deliveryAddShipmentModal" tabindex="-1" aria-labelledby="deliveryModalLabel" aria-hidden="true" data-bs-backdrop="static">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content delivery-form-box shadow-lg">

                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body p-5 pt-0">
                                <h2 class="delivery-header-text mb-5">New Delivery</h2>

                                <form>
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Order ID: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                                <input type="text" class="form-control delivery-input-field" placeholder="ORD-007">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Customer Name: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="Kim Namjuan">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Courier: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="text" class="form-control delivery-input-field" placeholder="ex. LBC">
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Tracking Number: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7 position-relative">
                                            <input type="text" class="form-control delivery-input-field" placeholder="Tracking Number">
                                            <i class="bi bi-pencil delivery-icon-inside"></i>
                                        </div>
                                    </div>

                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Dispatch Date: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control delivery-input-field">
                                        </div>
                                    </div>

                                    <div class="row mb-5 align-items-center">
                                        <div class="col-sm-5">
                                            <label class="delivery-label">Estimated Date of Arrival: <span class="delivery-required">*</span></label>
                                        </div>
                                        <div class="col-sm-7">
                                            <input type="date" class="form-control delivery-input-field">
                                        </div>
                                    </div>

                                    <div class="text-center">
                                        <button type="button" class="delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="delivery-btn-add" ng-click="addShipmentStatus()">Add</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*table*@
        <div class="row  px-4 pt-1">
            <div class="col">
                <table class="table table-striped table-responsive text-center" id="deliveryShipmentsTable">
                    <thead>
                        <tr>
                            <th>Delivery ID</th>
                            <th>Order ID</th>
                            <th>Customer Name</th>
                            <th>Address</th>
                            <th>Courier</th>
                            <th>Tracking Number</th>
                            <th>Dispatch Date</th>
                            <th>ETA</th>
                            <th>Delivery Status </th>
                            <th>Action </th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        <tr class="text-start" ng-init="deliveryShipmentStatus=''">
                            <td>DVR-001</td>
                            <td ng-click="orderDetails()" id="payment-orderID">ORD-001</td>
                            <td>Jerilee Rosales</td>
                            <td>Dapitan St., Sampaloc, Manila</td>
                            <td>LBC</td>
                            <td id="shipments-trackNo">578493562785</td>
                            <td>Nov-16-2025</td>
                            <td>Nov-16-2025</td>
                            <td>
                                <div class="dropdown">
                                    <a class="btn dropdown-toggle order-dropdown-status text-muted" href="#" role="button" data-bs-toggle="dropdown">
                                        <span ng-bind="deliveryShipmentStatus || 'Status'">Status</span>
                                    </a>

                                    <ul class="dropdown-menu order-dropdown-menu py-0">
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryShipmentStatus='Pending';shipmentsStatus()">Pending</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryShipmentStatus='In Transit'; shipmentsStatus()">In Transit</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryShipmentStatus='Delivered'; shipmentsStatus()">Delivered</a></li>
                                        <li><a class="dropdown-item order-dropdown-item" ng-click="deliveryShipmentStatus='Failed'; shipmentsStatus()">Failed</a></li>
                                    </ul>
                                </div>
                            </td>
                            <td class="">
                                <div  data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="View Shipment Details" class="d-inline-block">
                                    <a class="order-action-icon" data-bs-toggle="modal" data-bs-target="#deliveryViewShipmentModal">
                                        <img src="@Url.Content("~/Content/img/icons/view.svg")" />
                                    </a>
                                </div>
                                @*modal - view delivery*@
                                <div class="modal fade" id="deliveryViewShipmentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content view-shipment-container shadow-lg">

                                            <div class="modal-header border-0 pb-0 justify-content-end">
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body p-5 pt-0">
                                                <h2 class="view-shipment-header mb-5 text-center">Delivery Shipment Details</h2>

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-shipment-label">Order ID:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="shipment-view-orderID" id="">ORD-007</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-shipment-label">Customer Name:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-shipment-data">Kim Namjuan</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-shipment-label">Courier:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-shipment-data">LBC</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-shipment-label">Tracking Number:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-shipment-data">578493562785</div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-3 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-shipment-label">Dispatch Date:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-shipment-data">
                                                            <i class="bi bi-calendar3 me-2"></i> Nov-17-2025
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr class="mx-5" />

                                                <div class="row mb-5 justify-content-center">
                                                    <div class="col-sm-4">
                                                        <label class="view-shipment-label">Estimated Arrival:</label>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="view-shipment-data">
                                                            <i class="bi bi-clock me-2"></i> Nov-20-2025
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*end of modal*@
                                @*edit button*@
                                <div data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Edit Shipment Details" class="d-inline-block">
                                    <a class="order-action-icon" data-bs-toggle="modal" data-bs-target="#deliveryEditShipmentModal">
                                        <img src="@Url.Content("~/Content/img/icons/edit.svg")" />
                                    </a>
                                </div>
                                @*Modal - Edit Delivery*@
                                <div class="modal fade" id="deliveryEditShipmentModal" tabindex="-1" aria-labelledby="deliveryModalLabel" aria-hidden="true" data-bs-backdrop="static">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content delivery-form-box shadow-lg">

                                            <div class="modal-header border-0 pb-0">
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body p-5 pt-0">
                                                <h2 class="delivery-header-text mb-5">Edit Delivery</h2>

                                                <form>
                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-5">
                                                            <label class="delivery-label">Order ID: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="text" class="form-control delivery-input-field" placeholder="ORD-007">
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-5">
                                                            <label class="delivery-label">Customer Name: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="text" class="form-control delivery-input-field" placeholder="Kim Namjuan">
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-5">
                                                            <label class="delivery-label">Courier: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="text" class="form-control delivery-input-field" placeholder="ex. LBC">
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-5">
                                                            <label class="delivery-label">Tracking Number: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7 position-relative">
                                                            <input type="text" class="form-control delivery-input-field" placeholder="Tracking Number">
                                                            <i class="bi bi-pencil delivery-icon-inside"></i>
                                                        </div>
                                                    </div>

                                                    <div class="row mb-3 align-items-center">
                                                        <div class="col-sm-5">
                                                            <label class="delivery-label">Dispatch Date: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="date" class="form-control delivery-input-field">
                                                        </div>
                                                    </div>

                                                    <div class="row mb-5 align-items-center">
                                                        <div class="col-sm-5">
                                                            <label class="delivery-label">Estimated Date of Arrival: <span class="delivery-required">*</span></label>
                                                        </div>
                                                        <div class="col-sm-7">
                                                            <input type="date" class="form-control delivery-input-field">
                                                        </div>
                                                    </div>

                                                    <div class="text-center">
                                                        <button type="button" class="delivery-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="delivery-btn-add" ng-click="updateShipmentStatus()">Update</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*end of modal*@
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*----------Table end----------*@
    </div>
</div>