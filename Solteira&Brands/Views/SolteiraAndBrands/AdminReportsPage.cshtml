@{
    Layout = User.IsInRole("ADMIN") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_OperationsLayout.cshtml";
}

<div class="main-content" ng-init="loadSalesReport()">
    <div class="container-fluid orders-container px-1">

        <div class="row px-4 pb-3 mb-0 align-items-center border-bottom">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Sales Reports</p>
                <p class="text-muted mb-0">View and export detailed item sales.</p>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="button" class="btn btn-outline-danger shadow-sm" ng-click="exportSalesReportPdf()">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i>Export as PDF
                </button>
                <button type="button" class="btn btn-outline-success shadow-sm" ng-click="exportSalesReportCsv()">
                    <i class="bi bi-filetype-csv me-2"></i>Export as CSV
                </button>
            </div>
        </div>

        <div class="row px-4 pt-3 pb-2">
            <div class="col-md-12">
                <div class="card bg-light border-0 p-3 rounded-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Filter</label>
                            <select class="form-select" ng-model="reportRange" ng-change="onReportRangeChange()">
                                <option value="all">All</option>
                                <option value="today">Today</option>
                                <option value="lastweek">Last week</option>
                                <option value="lastmonth">Last month</option>
                                <option value="custom">Custom range</option>
                            </select>
                        </div>
                        <div ng-if="reportRange === 'custom'" class="col-md-4 d-flex align-items-end gap-2 flex-wrap">
                            <input type="date" class="form-control" style="width: auto;" ng-model="customReportStart" ng-change="loadSalesReport()" />
                            <span class="text-muted align-self-center">to</span>
                            <input type="date" class="form-control" style="width: auto;" ng-model="customReportEnd" ng-change="loadSalesReport()" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Category</label>
                            <select class="form-select" ng-model="reportCategory" ng-change="loadSalesReport()">
                                <option value="All Categories">All Categories</option>
                                <option value="Ring">Ring</option>
                                <option value="Earring">Earring</option>
                                <option value="Necklace">Necklace</option>
                                <option value="Bracelet">Bracelet</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row px-4 pt-3">
            <div class="col">
                <div class="card border-0 shadow-sm p-3 rounded-4">

                    <table class="table table-hover text-center align-middle" id="salesReportTable" style="width:100%">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="py-3">Date</th>
                                <th class="py-3">Order ID</th>
                                <th class="py-3">Item Name</th>
                                <th class="py-3">Category</th>
                                <th class="py-3">Qty</th>
                                <th class="text-end py-3">Unit Price</th>
                                <th class="text-end py-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in salesReportRows">
                                <td>{{row.date}}</td>
                                <td>{{row.orderNumber}}</td>
                                <td>{{row.itemName}}</td>
                                <td>{{row.category}}</td>
                                <td>{{row.qty}}</td>
                                <td class="text-end">{{formatReportCurrency(row.unitPrice)}}</td>
                                <td class="text-end fw-bold">{{formatReportCurrency(row.total)}}</td>
                            </tr>
                            <tr ng-if="salesReportRows.length === 0">
                                <td colspan="7" class="text-muted py-4">No sales data for the selected filter.</td>
                            </tr>
                        </tbody>
                        <tfoot class="table-light fw-bold border-top">
                            <tr>
                                <td colspan="6" class="text-end text-uppercase py-3">Grand Total:</td>
                                <td class="text-end text-success fs-5 py-3">{{formatReportCurrency(salesReportGrandTotal)}}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>