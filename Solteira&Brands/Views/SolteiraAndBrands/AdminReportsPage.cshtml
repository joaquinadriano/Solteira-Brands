@{
    Layout = "~/Views/Shared/_SABInventoryDashboardLayout.cshtml";
}

<div class="main-content">
    <div class="container-fluid orders-container px-1">

        <div class="row px-4 pb-3 mb-0 align-items-center border-bottom">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Sales Reports</p>
                <p class="text-muted mb-0">View and export detailed item sales.</p>
            </div>
            <div class="col-auto d-flex gap-2">
                <button class="btn btn-outline-danger shadow-sm">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i>Export as PDF
                </button>
                <button class="btn btn-outline-success shadow-sm">
                    <i class="bi bi-filetype-csv me-2"></i>Export as CSV
                </button>
            </div>
        </div>

        <div class="row px-4 pt-3 pb-2">
            <div class="col-md-12">
                <div class="card bg-light border-0 p-3 rounded-3">
                    <form class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">From Date</label>
                            <input type="date" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">To Date</label>
                            <input type="date" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Category</label>
                            <select class="form-select">
                                <option selected>All Categories</option>
                                <option>Rings</option>
                                <option>Necklaces</option>
                                <option>Bracelets</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-primary w-100">Generate Report</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row px-4 pt-3">
            <div class="col">
                <div class="card border-0 shadow-sm p-3 rounded-4">

                    <table class="table table-hover text-center align-middle" id="salesReportTable" style="width:100%">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="py-3">Date</th>
                                <th class="py-3">Order ID</th>
                                <th class="py-3">Item Name</th>
                                <th class="py-3">Category</th>
                                <th class="py-3">Qty</th>
                                <th class="text-end py-3">Unit Price</th>
                                <th class="text-end py-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>2025-11-04</td>
                                <td>ORD-25-001</td>
                                <td>Diamond Tennis Bracelet</td>
                                <td>Bracelet</td>
                                <td>1</td>
                                <td class="text-end">P 55,000.00</td>
                                <td class="text-end fw-bold">P 55,000.00</td>
                            </tr>
                            <tr>
                                <td>2025-11-06</td>
                                <td>ORD-25-002</td>
                                <td>Gold Band Ring</td>
                                <td>Ring</td>
                                <td>2</td>
                                <td class="text-end">P 10,000.00</td>
                                <td class="text-end fw-bold">P 20,000.00</td>
                            </tr>
                            <tr>
                                <td>2025-12-01</td>
                                <td>ORD-25-005</td>
                                <td>Pearl Earring</td>
                                <td>Earring</td>
                                <td>1</td>
                                <td class="text-end">P 5,000.00</td>
                                <td class="text-end fw-bold">P 5,000.00</td>
                            </tr>
                        </tbody>
                        <tfoot class="table-light fw-bold border-top">
                            <tr>
                                <td colspan="6" class="text-end text-uppercase py-3">Grand Total:</td>
                                <td class="text-end text-success fs-5 py-3">P 80,000.00</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>