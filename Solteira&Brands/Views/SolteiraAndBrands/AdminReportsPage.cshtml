@{
    Layout = User.IsInRole("ADMIN") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_OperationsLayout.cshtml";
}

<div class="main-content" ng-init="onReportsPageInit()">
    <div class="container-fluid orders-container px-1">

        <div class="row px-4 pb-3 mb-0 align-items-center border-bottom">
            <div class="col">
                <p class="h1 fw-bold inventory-title ps-0 ms-0">Sales Reports</p>
                <p class="text-muted mb-0">View and export detailed item sales.</p>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="button" class="btn btn-outline-danger shadow-sm" ng-click="exportSalesReportPdf()" ng-disabled="!canExportSalesReport()" title="{{canExportSalesReport() ? 'Export as PDF' : getSalesReportExportDisabledHint()}}">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i>Export as PDF
                </button>
                <button type="button" class="btn btn-outline-success shadow-sm" ng-click="exportSalesReportCsv()" ng-disabled="!canExportSalesReport()" title="{{canExportSalesReport() ? 'Export as CSV' : getSalesReportExportDisabledHint()}}">
                    <i class="bi bi-filetype-csv me-2"></i>Export as CSV
                </button>
            </div>
        </div>

        <div class="row px-4 pt-3 pb-2">
            <div class="col-md-12">
                <div class="card bg-light border-0 p-3 rounded-3">
                    @* Top row: Filter (left) + dynamic field (right) *@
                    <div class="row g-3 align-items-start">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Filter</label>
                            <select class="form-select" ng-model="reportRange" ng-change="onReportRangeChange()">
                                <option value="all">All</option>
                                <option value="daily">Daily</option>
                                <option value="monthly">Monthly</option>
                                <option value="custom">Custom range</option>
                            </select>
                        </div>

                        <div class="col-md-9">
                            @* Daily (shows beside Filter) *@
                            <div class="align-items-start gap-2 flex-wrap"
                                 ng-class="((reportRange || '').toLowerCase() === 'daily' ? 'd-flex' : 'd-none')">
                                <div style="min-width: 240px;">
                                    <label class="form-label fw-bold">Daily</label>
                                    <select class="form-select" ng-model="reportPreset" ng-change="loadSalesReport()">
                                        <option value="today">Today</option>
                                        <option value="yesterday">Yesterday</option>
                                    </select>
                                </div>
                            </div>

                            @* Monthly (shows beside Filter) *@
                            <div class="align-items-start gap-2 flex-wrap"
                                 ng-class="((reportRange || '').toLowerCase() === 'monthly' ? 'd-flex' : 'd-none')">
                                <div style="min-width: 240px;">
                                    <label class="form-label fw-bold">Monthly</label>
                                    <select class="form-select" ng-model="reportPreset" ng-change="loadSalesReport()">
                                        <option value="thismonth">This month</option>
                                        <option value="lastmonth">Last month</option>
                                    </select>
                                </div>
                            </div>

                            @* Custom range (shows beside Filter; keep in DOM for getElementById) *@
                            <div class="align-items-end gap-2 flex-wrap"
                                 ng-class="((reportRange || '').toLowerCase() === 'custom' ? 'd-flex' : 'd-none')">
                                <div>
                                    <label class="form-label small text-muted mb-0">From</label>
                                    <input id="salesReportStartDate"
                                           type="date"
                                           class="form-control"
                                           style="width: auto;"
                                           ng-model="customReportStart"
                                           ng-model-options="{ debounce: 0 }"
                                           ng-change="onCustomReportDatesChanged()" />
                                </div>
                                <span class="text-muted align-self-end pb-2">to</span>
                                <div>
                                    <label class="form-label small text-muted mb-0">To</label>
                                    <input id="salesReportEndDate"
                                           type="date"
                                           class="form-control"
                                           style="width: auto;"
                                           ng-model="customReportEnd"
                                           ng-model-options="{ debounce: 0 }"
                                           ng-change="onCustomReportDatesChanged()" />
                                </div>
                                <span class="text-muted small align-self-end pb-2">Loads when both dates are set</span>
                            </div>
                        </div>
                    </div>

                    @* Bottom row: Category under Filter *@
                    <div class="row g-3 mt-1">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Category</label>
                            <select class="form-select" ng-model="reportCategory" ng-change="loadSalesReport()">
                                <option value="All Categories">All Categories</option>
                                <option value="Ring">Ring</option>
                                <option value="Earring">Earring</option>
                                <option value="Necklace">Necklace</option>
                                <option value="Bracelet">Bracelet</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row px-4 pt-3">
            <div class="col">
                <div class="card border-0 shadow-sm p-3 rounded-4">

                    <table class="table table-hover text-center align-middle" id="salesReportTable" style="width:100%">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="py-3">Date</th>
                                <th class="py-3">Order ID</th>
                                <th class="py-3">Item Name</th>
                                <th class="py-3">Category</th>
                                <th class="py-3">Qty</th>
                                <th class="text-end py-3">Unit Price</th>
                                <th class="text-end py-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in salesReportRows">
                                <td>{{row.date}}</td>
                                <td>{{row.orderNumber}}</td>
                                <td>{{row.itemName}}</td>
                                <td>{{row.category}}</td>
                                <td>{{row.qty}}</td>
                                <td class="text-end">{{formatReportCurrency(row.unitPrice)}}</td>
                                <td class="text-end fw-bold">{{formatReportCurrency(row.total)}}</td>
                            </tr>
                            <tr ng-if="salesReportRows.length === 0">
                                <td colspan="7" class="text-muted py-4">No data available.</td>
                            </tr>
                        </tbody>
                        <tfoot class="table-light fw-bold border-top">
                            <tr>
                                <td colspan="6" class="text-end text-uppercase py-3">Grand Total:</td>
                                <td class="text-end text-success fs-5 py-3">{{formatReportCurrency(salesReportGrandTotal)}}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>