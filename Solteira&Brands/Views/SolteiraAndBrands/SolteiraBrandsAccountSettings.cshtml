@{
    Layout = "~/Views/Shared/_SolteiraBrandsLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/ordering-system/AccountSettings.css" />

<div class="acc-settings-page-wrapper" ng-controller="SolteiraBrandsController" ng-init="loadProfile()">

    <div class="acc-settings-container">

        <div class="left-as-container">

            <div class="profile">
                <img ng-src="{{profilePreviewUrl || profile.avatarUrl || defaultAvatarUrl}}" class="profile-img rounded-circle" alt="Profile" />
            </div>

            <div class="profile-name">
                <div class="profile-name-line"
                     ng-if="(((savedProfile.firstName || '') + ((savedProfile.firstName && savedProfile.lastName) ? ' ' : '') + (savedProfile.lastName || '')).trim().length > 0) && (((savedProfile.firstName || '') + ((savedProfile.firstName && savedProfile.lastName) ? ' ' : '') + (savedProfile.lastName || '')).trim().length <= 20)">
                    <span class="profile-name-text">
                        {{ ((savedProfile.firstName || '') + ((savedProfile.firstName && savedProfile.lastName) ? ' ' : '') + (savedProfile.lastName || '')).trim() }}
                    </span>
                </div>

                <div class="profile-name-line"
                     ng-if="(((savedProfile.firstName || '') + ((savedProfile.firstName && savedProfile.lastName) ? ' ' : '') + (savedProfile.lastName || '')).trim().length > 20)">
                    <span class="profile-name-text">
                        {{ (savedProfile.firstName || '') | limitTo:20 }}<span ng-if="(savedProfile.firstName || '').length > 20">...</span>
                    </span>
                </div>

                <div class="profile-name-line"
                     ng-if="(((savedProfile.firstName || '') + ((savedProfile.firstName && savedProfile.lastName) ? ' ' : '') + (savedProfile.lastName || '')).trim().length > 20)">
                    <span class="profile-name-text">
                        {{ (savedProfile.lastName || '') | limitTo:20 }}<span ng-if="(savedProfile.lastName || '').length > 20">...</span>
                    </span>
                </div>

                <div class="profile-name-line"
                     ng-if="(((savedProfile.firstName || '') + ((savedProfile.firstName && savedProfile.lastName) ? ' ' : '') + (savedProfile.lastName || '')).trim().length === 0)">
                    <span class="profile-name-text">User</span>
                </div>
            </div>

            <label for="profileImageInput" class="select-img" style="cursor:pointer;margin:0;">
                <span>Select Image</span>
                <input id="profileImageInput" type="file" accept=".jpg,.jpeg,.png" style="display:none;" onchange="angular.element(this).scope().onProfileImageSelect(event)" />
            </label>

        </div>

        <hr />

        <div class="right-as-container">

            <div class="edit-profile">
                <h3>Edit Profile</h3>
                <p>Manage your account.</p>
            </div>

            <div class="edit-field">

                <form name="editForm" class="d-flex flex-column align-items-center" ng-submit="saveProfile()">
                    
                    <div class="text-start mb-4 w-100">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text"
                               maxlength="50"
                               class="form-control custom-input"
                               ng-class="{'input-error': profileErrors.firstName}"
                               id="firstName" name="firstName"
                               ng-model="profile.firstName"
                               ng-blur="onProfileFirstNameBlur()"
                               placeholder="First name" required />
                        <small class="text-danger" ng-if="profileErrors.firstName">{{profileErrors.firstName}}</small>
                        <small class="text-muted" ng-if="!profileErrors.firstName">Letters only. Max 50 characters.</small>
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text"
                               maxlength="50"
                               class="form-control custom-input"
                               ng-class="{'input-error': profileErrors.lastName}"
                               id="lastName" name="lastName"
                               ng-model="profile.lastName"
                               ng-blur="onProfileLastNameBlur()"
                               placeholder="Last name" required />
                        <small class="text-danger" ng-if="profileErrors.lastName">{{profileErrors.lastName}}</small>
                        <small class="text-muted" ng-if="!profileErrors.lastName">Letters only. Max 50 characters.</small>
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label for="username" class="form-label">Username</label>
                        <input type="text"
                               maxlength="14" pattern="^[^\s]{1,14}$"
                               class="form-control custom-input"
                               ng-class="{'input-error': profileErrors.username}"
                               id="username" name="username"
                               ng-model="profile.username"
                               ng-blur="onProfileUsernameBlur()"
                               placeholder="Username" required />
                        <small class="text-danger" ng-if="showUsernameValidation && profileErrors.username">{{profileErrors.username}}</small>
                        <small class="text-danger" ng-if="showUsernameValidation && usernameCooldownRemainingText && !profileErrors.username">{{usernameCooldownRemainingText}}</small>
                        <small class="text-muted" ng-if="!showUsernameValidation">
                            Max 14 characters. No spaces. Must be unique.
                        </small>
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label for="email" class="form-label">Email (cannot be changed)</label>
                        <input type="email" class="form-control custom-input" id="email"
                               ng-value="profile.email" disabled />
                    </div>

                    <div class="text-start mb-4 w-100">
                        <label class="form-label">Password</label>
                        <a href="@Url.Action("SolteiraBrandsChangePassword", "SolteiraAndBrands")" class="change-password-link">
                            Change Password (Optional)
                        </a>
                    </div>

                    <button type="submit"
                            class="save-changes"
                            ng-disabled="profileErrors.username || profileErrors.firstName || profileErrors.lastName">
                        SAVE CHANGES
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>
