<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <style type="text/css">[ng\:cloak], [ng-cloak], [data-ng-cloak], .ng-cloak { display: none !important; }</style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="~/Content/css/ordering-system/SolteiraBrandsLayout.css" />
    <style type="text/css">[ng\:cloak], [ng-cloak], [data-ng-cloak], .ng-cloak { display: none !important; }</style>
</head>

<body id="sb-angular-root">

    @{
        var actionVal = ViewContext.RouteData.Values["action"];
        var currentAction = actionVal != null ? actionVal.ToString() : null;
        bool isLoggedIn = User != null && User.Identity != null && User.Identity.IsAuthenticated;
        bool isBuyer = isLoggedIn && User.IsInRole("BUYER");
        bool isInventoryRole = isLoggedIn && (User.IsInRole("ADMIN") || User.IsInRole("MANAGER") || User.IsInRole("STAFF"));
        var displayName = isLoggedIn ? User.Identity.Name : "Guest";
        var displayNameJs = System.Web.HttpUtility.JavaScriptStringEncode(displayName ?? "User");
    }

    <header class="navbar-wrapper">
        <nav class="navbar header-logo p-0">
            <div class="container-fluid justify-content-center">
                <a href="@Url.Action("SolteiraBrandsHome", "SolteiraAndBrands")" class="navbar-brand">
                    <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" class="sblogo" alt="Logo" />
                </a>
            </div>
        </nav>

        <nav class="navbar navbar-expand-lg bg-white border-bottom">
            <div class="container-fluid px-4">
                <div class="flex-grow-1 d-none d-lg-block"></div>

                <button id="sbMobileMenuButton"
                        class="sb-mobile-menu-button"
                        type="button"
                        aria-label="Open navigation menu"
                        aria-controls="sbMobileMenu"
                        aria-expanded="false">
                    <span class="sb-hamburger-lines" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </span>
                </button>

                <ul class="navbar-nav flex-row gap-3 gap-lg-5 sb-desktop-nav">
                    <li class="nav-item">
                        <a class="nav-link nav-item-align @(currentAction == "SolteiraBrandsHome" ? "active" : "")" href="@Url.Action("SolteiraBrandsHome", "SolteiraAndBrands")">HOME</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-align @(currentAction == "SolteiraBrandsJewelries" ? "active" : "")" href="@Url.Action("SolteiraBrandsJewelries", "SolteiraAndBrands")">JEWELRIES</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-align @(currentAction == "SolteiraBrandsAbout" ? "active" : "")" href="@Url.Action("SolteiraBrandsAbout", "SolteiraAndBrands")">ABOUT</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-align @(currentAction == "SolteiraBrandsFaq" ? "active" : "")" href="@Url.Action("SolteiraBrandsFaq", "SolteiraAndBrands")">FAQs</a>
                    </li>
                </ul>

                <div class="flex-grow-1 d-flex justify-content-end align-items-center gap-3 sb-desktop-actions">
                    @if (isInventoryRole)
                    {
                        <a href="@Url.Action("AdminDashboardPage", "SolteiraAndBrands")" class="btn btn-outline-dark btn-sm nav-item-align" title="Inventory System">
                            <i class="bi bi-box-seam me-1"></i>Inventory
                        </a>
                    }
                    @* Cart icon: BUYER goes to cart; anonymous goes to login; backend roles see no cart *@
                    @if (isBuyer)
                    {
                        <a href="@Url.Action("SolteiraBrandsCart", "SolteiraAndBrands")" class="icon-link nav-item-align position-relative sb-cart-link" title="Cart" aria-label="View cart">
                            <i class="bi bi-cart2"></i>
                            <span id="sbCartCountBadge" class="badge rounded-pill bg-danger sb-cart-badge" style="display: none;">0</span>
                        </a>
                    }
                    else if (!isInventoryRole)
                    {
                        <a href="@Url.Action("SolteiraBrandsLogin", "SolteiraAndBrands")" class="icon-link nav-item-align sb-cart-login-link" title="Sign in to shop" aria-label="Sign in">
                            <i class="bi bi-cart2"></i>
                        </a>
                    }

                    @* Profile / account area *@
                    @if (!isLoggedIn)
                    {
                        <div class="dropdown d-flex align-items-center">
                            <a href="#" class="icon-link nav-item-align" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-4"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow custom-account-dropdown" aria-labelledby="profileMenu">
                                <li><a class="dropdown-item" href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">Login</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("SolteiraBrandsRegister","SolteiraAndBrands")">Register</a></li>
                            </ul>
                        </div>
                    }
                    else if (isBuyer)
                    {
                        @* BUYER: full account dropdown with avatar, My Orders, Logout *@
                        <div class="dropdown d-flex align-items-center">
                            <a href="#" class="d-flex align-items-center" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <img id="layoutProfileImgTrigger" src="@Url.Content("~/Content/img/shared/default-avatar.svg")" class="rounded-circle" alt="Profile" style="width:36px;height:36px;object-fit:cover;" />
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow custom-account-dropdown" aria-labelledby="profileMenu">

                                <li class="px-3 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle me-2">
                                            <img id="sbMobileLayoutProfileImg" src="@Url.Content("~/Content/img/shared/default-avatar.svg")" class="rounded-circle" alt="" />
                                        </div>
                                        <span class="profile-name fw-bold js-layout-profile-name">@displayName</span>
                                    </div>
                                </li>

                                <li><hr class="dropdown-divider fw-bold"></li>

                                <li><a class="dropdown-item" href="@Url.Action("Settings","Account")">Account Settings</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("SolteiraBrandsMyOrders","SolteiraAndBrands")">My Orders</a></li>

                                <li><hr class="dropdown-divider"></li>

                                <li>@Html.Partial("_LogoutForm")</li>

                            </ul>
                        </div>
                    }
                    else if (isInventoryRole)
                    {
                        @* ADMIN / MANAGER / STAFF: no cart, simple account + logout *@
                        <div class="dropdown d-flex align-items-center">
                            <a href="#" class="d-flex align-items-center" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <img id="layoutProfileImgTrigger" src="@Url.Content("~/Content/img/shared/default-avatar.svg")" class="rounded-circle" alt="Profile" style="width:36px;height:36px;object-fit:cover;" />
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow custom-account-dropdown" aria-labelledby="profileMenu">
                                <li class="px-3 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle me-2">
                                            <img id="sbMobileLayoutProfileImg" src="@Url.Content("~/Content/img/shared/default-avatar.svg")" class="rounded-circle" alt="" />
                                        </div>
                                        <span class="profile-name fw-bold js-layout-profile-name">@displayName</span>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider fw-bold"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Settings","Account")">Account Settings</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>@Html.Partial("_LogoutForm")</li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>

        <!-- Mobile navigation -->
        <div id="sbMobileMenuOverlay" class="sb-mobile-menu-overlay" aria-hidden="true"></div>
        <div id="sbMobileMenu" class="sb-mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu">
            <ul class="sb-mobile-menu-list">
                <li>
                    <a class="sb-mobile-menu-link @(currentAction == "SolteiraBrandsHome" ? "active" : "")" href="@Url.Action("SolteiraBrandsHome", "SolteiraAndBrands")">HOME</a>
                </li>
                <li>
                    <a class="sb-mobile-menu-link @(currentAction == "SolteiraBrandsJewelries" ? "active" : "")" href="@Url.Action("SolteiraBrandsJewelries", "SolteiraAndBrands")">JEWELRIES</a>
                </li>
                <li>
                    <a class="sb-mobile-menu-link @(currentAction == "SolteiraBrandsAbout" ? "active" : "")" href="@Url.Action("SolteiraBrandsAbout", "SolteiraAndBrands")">ABOUT</a>
                </li>
                <li>
                    <a class="sb-mobile-menu-link @(currentAction == "SolteiraBrandsFaq" ? "active" : "")" href="@Url.Action("SolteiraBrandsFaq", "SolteiraAndBrands")">FAQs</a>
                </li>

                <li class="sb-mobile-menu-item-spacer"></li>

                <li>
                    @* Cart item: BUYER -> cart, anonymous -> login, inventory roles -> inventory dashboard *@
                    @if (isBuyer)
                    {
                        <a class="sb-mobile-menu-link" href="@Url.Action("SolteiraBrandsCart", "SolteiraAndBrands")">
                            <i class="bi bi-cart2 me-2" aria-hidden="true"></i>Cart
                        </a>
                    }
                    else if (!isInventoryRole)
                    {
                        <a class="sb-mobile-menu-link sb-cart-login-link" href="@Url.Action("SolteiraBrandsLogin", "SolteiraAndBrands")">
                            <i class="bi bi-cart2 me-2" aria-hidden="true"></i>Cart
                        </a>
                    }
                    else
                    {
                        <a class="sb-mobile-menu-link" href="@Url.Action("AdminDashboardPage", "SolteiraAndBrands")">
                            <i class="bi bi-box-seam me-2" aria-hidden="true"></i>Inventory
                        </a>
                    }
                </li>

                <li>
                    <div class="dropdown sb-mobile-profile-dropdown">
                        <a href="#"
                           class="sb-mobile-menu-link sb-mobile-dropdown-toggle"
                           id="sbMobileProfileMenu"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-person-circle me-2" aria-hidden="true"></i>Profile
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow custom-account-dropdown" aria-labelledby="sbMobileProfileMenu">
                            @if (!isLoggedIn)
                            {
                                <li><a class="dropdown-item" href="@Url.Action("SolteiraBrandsLogin","SolteiraAndBrands")">Login</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("SolteiraBrandsRegister","SolteiraAndBrands")">Register</a></li>
                            }
                            else if (isBuyer)
                            {
                                <li class="px-3 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle me-2">
                                            <img id="layoutProfileImg" src="@Url.Content("~/Content/img/shared/default-avatar.svg")" class="rounded-circle" alt="" />
                                        </div>
                                        <span class="profile-name fw-bold js-layout-profile-name">@displayName</span>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider fw-bold"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Settings","Account")">Account Settings</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("SolteiraBrandsMyOrders","SolteiraAndBrands")">My Orders</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>@Html.Partial("_LogoutForm")</li>
                            }
                            else if (isInventoryRole)
                            {
                                <li class="px-3 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle me-2">
                                            <img id="layoutProfileImg" src="@Url.Content("~/Content/img/shared/default-avatar.svg")" class="rounded-circle" alt="" />
                                        </div>
                                        <span class="profile-name fw-bold js-layout-profile-name">@displayName</span>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider fw-bold"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Settings","Account")">Account Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>@Html.Partial("_LogoutForm")</li>
                            }
                        </ul>
                    </div>
                </li>
            </ul>
        </div>
    </header>

    <main class="min-vh-100">
        @RenderBody()
    </main>

    <footer class="container-fluid border-top bg-light">

        <div class="d-flex justify-content-between align-items-center px-4">

            <div class="d-flex align-items-center">
                <img src="@Url.Content("~/Content/img/shared/Solteira&BrandsFooterLogo.png")" class="footer-logo me-2" alt="Footer Logo" />
                <span class="text-muted">&copy; 2026 Solteira & Brands</span>
            </div>

            <ul class="nav align-items-center list-unstyled d-flex mb-0">
                <li class="ms-3"><a class="text-dark fs-4" href="https://www.instagram.com/solteira.brands/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a></li>
                <li class="ms-3"><a class="btn btn-outline-dark fw-bold" href="@Url.Action("SolteiraBrandsJewelries", "SolteiraAndBrands")">Shop Now</a></li>
            </ul>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular-animate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Expose BUYER role flag to Angular so cart logic is buyer-only
        window.sbIsBuyer = @(isBuyer ? "true" : "false");
        // Used to distinguish anonymous users from authenticated non-buyers.
        window.sbIsLoggedIn = @(isLoggedIn ? "true" : "false");
        // Used to scope checkbox selection when navigating Cart -> Checkout.
        window.sbUsername = '@(isBuyer ? (User.Identity.Name ?? "") : "")';

        // Cart count badge (for BUYER): fetch from server + update from Angular via event.
        (function () {
            function setBadge(count) {
                var el = document.getElementById('sbCartCountBadge');
                if (!el) return;
                el.textContent = count > 99 ? '99+' : count;
                el.style.display = count > 0 ? 'block' : 'none';
            }

            function fetchCartCount() {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', '/SolteiraAndBrands/GetCartCount', true);
                xhr.withCredentials = true;
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4 && xhr.status === 200) {
                        try {
                            var d = JSON.parse(xhr.responseText);
                            setBadge(d && d.success ? (d.count || 0) : 0);
                        } catch (e) {
                            setBadge(0);
                        }
                    }
                };
                xhr.send();
            }

            document.addEventListener('DOMContentLoaded', function () {
                if (!window.sbIsBuyer) return;
                fetchCartCount();
            });

            window.addEventListener('sbCartUpdated', function (e) {
                var count = (e && e.detail != null) ? e.detail : 0;
                setBadge(count);
            });

            // If user is anonymous and clicks the cart icon on the top-right navbar,
            // show the same "login required" alert and then redirect to login.
            (function attachNavbarCartGuard() {
                try {
                    var loginLink = document.querySelector('.sb-cart-login-link');
                    if (!loginLink) return;
                    loginLink.addEventListener('click', function (e) {
                        if (window.sbIsLoggedIn) return; // shouldn't happen because of server-side rendering
                        e.preventDefault();
                        var href = loginLink.getAttribute('href') || '/SolteiraAndBrands/SolteiraBrandsLogin';
                        Swal.fire({
                            icon: 'info',
                            title: 'Login required',
                            text: 'Please log in first to add items to your cart.'
                        }).then(function () {
                            window.location.href = href;
                        });
                    });
                } catch (e) { }
            })();
        })();
    </script>

    <script>
        // Mobile hamburger menu toggle (minimal, accessible, no link behavior changes)
        (function () {
            var btn = document.getElementById('sbMobileMenuButton');
            var menu = document.getElementById('sbMobileMenu');
            var overlay = document.getElementById('sbMobileMenuOverlay');
            if (!btn || !menu || !overlay) return;

            var isOpen = false;

            function setOpen(next) {
                isOpen = next;
                if (isOpen) {
                    btn.setAttribute('aria-expanded', 'true');
                    overlay.setAttribute('aria-hidden', 'false');
                    overlay.classList.add('open');
                    menu.classList.add('open');
                    document.body.style.overflow = 'hidden';
                } else {
                    btn.setAttribute('aria-expanded', 'false');
                    overlay.setAttribute('aria-hidden', 'true');
                    overlay.classList.remove('open');
                    menu.classList.remove('open');
                    document.body.style.overflow = '';
                }
            }

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                setOpen(!isOpen);
            });

            overlay.addEventListener('click', function () {
                setOpen(false);
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });

            // Close menu when a real navigation link is clicked.
            menu.addEventListener('click', function (e) {
                var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
                if (!link) return;

                var href = link.getAttribute('href') || '';
                if (!href) return;

                // Dropdown toggles use href="#", do not treat them as navigation.
                if (href === '#' || href === 'javascript:void(0)') return;

                setOpen(false);
            });
        })();
    </script>
    <script src="~/Scripts/SBScripts/Module.js"></script>
    <script src="~/Scripts/SBScripts/Service.js"></script>
    <script src="~/Scripts/SBScripts/Controller.js"></script>
    <script>
        // Bootstrap Angular after our app is loaded so Cart/Checkout work on first visit
        (function () {
            var root = document.getElementById('sb-angular-root');
            if (root && window.angular && !angular.element(root).scope()) {
                angular.bootstrap(root, ['SolteiraBrandsApplication']);
            }
        })();
    </script>
    @if (isLoggedIn)
    {
        <script>
            (function () {
                function renderLayoutProfileNames(firstName, lastName, fallback) {
                    var f = (firstName || '').trim();
                    var l = (lastName || '').trim();
                    var full = (f + (f && l ? ' ' : '') + l).trim();
                    var defaultText = (fallback || 'User').trim() || 'User';

                    var nameNodes = document.querySelectorAll('.js-layout-profile-name');
                    if (!nameNodes || !nameNodes.length) return;

                    for (var i = 0; i < nameNodes.length; i++) {
                        var node = nameNodes[i];
                        if (!full) {
                            node.textContent = defaultText;
                            continue;
                        }

                        if (full.length <= 20) {
                            node.innerHTML = '<span class="name-line">' + full + '</span>';
                            continue;
                        }

                        var line1 = f ? (f.length > 20 ? (f.substring(0, 20) + '...') : f) : '';
                        var line2 = l ? (l.length > 20 ? (l.substring(0, 20) + '...') : l) : '';
                        if (!line1 && full) line1 = full.length > 20 ? (full.substring(0, 20) + '...') : full;
                        if (!line2 && full.length > 20) line2 = full.substring(20, 40);
                        if (line2 && line2.length > 20) line2 = line2.substring(0, 20) + '...';

                        node.innerHTML = '<span class="name-line">' + line1 + '</span>' + (line2 ? ('<span class="name-line">' + line2 + '</span>') : '');
                    }
                }

                window.updateLayoutProfileNameDisplay = renderLayoutProfileNames;

                var xhr = new XMLHttpRequest();
                xhr.open('GET', '/Account/GetMyProfile', true);
                xhr.withCredentials = true;
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4 && xhr.status === 200) {
                        try {
                            var d = JSON.parse(xhr.responseText);
                            if (d.success) {
                                if (d.avatarUrl) {
                                    var el = document.getElementById('layoutProfileImg');
                                    var trigger = document.getElementById('layoutProfileImgTrigger');
                                    var mobileEl = document.getElementById('sbMobileLayoutProfileImg');
                                    if (el) el.src = d.avatarUrl;
                                    if (trigger) trigger.src = d.avatarUrl;
                                    if (mobileEl) mobileEl.src = d.avatarUrl;
                                }
                                renderLayoutProfileNames(d.firstName, d.lastName, '@Html.Raw(displayNameJs)');
                            }
                        } catch (e) { }
                    }
                };
                xhr.send();
            })();
        </script>
    }

    @if (isLoggedIn)
    {
        <script>
            // 15-minute inactivity auto-logout (with 1-minute warning).
            // Uses existing POST /Account/Logout form (includes anti-forgery token).
            (function () {
                var logoutForm = document.getElementById('logoutForm');
                if (!logoutForm) return;

                var TOTAL_MS = 15 * 60 * 1000;
                var WARN_AT_MS = 14 * 60 * 1000; // 1 minute before logout

                var logoutInProgress = false;
                var warningShown = false;
                var warnTimeoutId = null;
                var logoutTimeoutId = null;
                var lastResetAt = 0;
                var RESET_THROTTLE_MS = 750; // avoid excessive scheduling on mousemove

                function schedule() {
                    warnTimeoutId = setTimeout(function () {
                        if (logoutInProgress) return;
                        warningShown = true;
                        try {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'warning',
                                title: 'Inactivity',
                                text: 'You will be logged out in 1 minute due to inactivity.',
                                showConfirmButton: false,
                                timer: 60000,
                                timerProgressBar: true
                            });
                        } catch (e) { }
                    }, WARN_AT_MS);

                    logoutTimeoutId = setTimeout(function () {
                        if (logoutInProgress) return;
                        logoutInProgress = true;
                        warningShown = false;
                        try { Swal.close(); } catch (e) { }
                        logoutForm.submit();
                    }, TOTAL_MS);
                }

                function clearScheduled() {
                    if (warnTimeoutId != null) clearTimeout(warnTimeoutId);
                    if (logoutTimeoutId != null) clearTimeout(logoutTimeoutId);
                    warnTimeoutId = null;
                    logoutTimeoutId = null;
                }

                function resetTimer() {
                    var now = Date.now();
                    if (now - lastResetAt < RESET_THROTTLE_MS) return;
                    lastResetAt = now;

                    clearScheduled();

                    if (warningShown) {
                        warningShown = false;
                        try { Swal.close(); } catch (e) { }
                    }

                    schedule();
                }

                // Activity events that reset the timer
                ['mousemove', 'keydown', 'click', 'touchstart'].forEach(function (evt) {
                    document.addEventListener(evt, resetTimer, { passive: true, capture: true });
                });

                // Start timer immediately on page load
                schedule();
            })();
        </script>
    }
</body>
</html>