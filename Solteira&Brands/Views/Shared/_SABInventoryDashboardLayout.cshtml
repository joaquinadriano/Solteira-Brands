    <!DOCTYPE html>

    <html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="~/Content/css/fonts.css" />
        <link href="~/Content/css/inventory-system/inventory-header-footer.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-dashboard.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-orders.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-orderDetails.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-payment.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-delivery.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-delivery.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-archive.css" rel="stylesheet" />
        <link href="~/Content/css/inventory-system/inventory-inventory.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.css" />

        <title>@ViewBag.Title</title>
    </head>
    <body ng-app="SolteiraAndBrands" ng-controller="SolteiraAndBrandsController">

         @*SIDEBAR*@ 
        <div class="sidebar pt-3">
            <ul class="sidebar-ul">
                <li class="option1" ng-click="inventoryDashboard()">
                    <a>
                        <img src="~/Content/img/solteira-logo.png" class="sidebar-logo" />
                    </a>
                </li>

                <li class="option" id="option-dashboard" ng-click="inventoryDashboard()">
                    <a>
                        <img src="~/Content/img/icons/dashboard.svg" id="dashboard-icon" />
                        <img src="~/Content/img/icons/dashboard-hover.svg" id="dashboard-hover-icon" />
                        <p class="sidebar-text">Dashboard</p>
                    </a>
                </li>

                <li class="option" id="option-inventory" ng-click="inventoryInventory()">
                    <a>
                        <img src="~/Content/img/icons/inventory.svg" id="inventory-icon" />
                        <img src="~/Content/img/icons/inventory-hover.svg" id="inventory-hover-icon" />
                        <p class="sidebar-text">Inventory</p>
                    </a>
                </li>

                <li class="option" id="option-orders" ng-click="inventoryOrders()">
                    <a>
                        <img src="~/Content/img/icons/orders.svg" id="orders-icon" />
                        <img src="~/Content/img/icons/orders-hover.svg" id="orders-hover-icon" />
                        <p class="sidebar-text">Orders</p>
                    </a>
                </li>

                <li class="option" id="option-payment"  ng-click="inventoryPayment()">
                    <a>
                        <img src="~/Content/img/icons/payment.svg" id="payment-icon" />
                        <img src="~/Content/img/icons/payment-hover.svg" id="payment-hover-icon" />
                        <p class="sidebar-text">Payment</p>
                    </a>
                </li>

                <li class="option dropend" id="option-delivery">
                    <a 
                       class="delivery-dropend-toggle d-flex align-items-center"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <img src="~/Content/img/icons/delivery.svg" id="delivery-icon" />
                        <img src="~/Content/img/icons/delivery-hover.svg" id="delivery-hover-icon" />
                        <p class="sidebar-text mb-0">Delivery</p>
                    </a>
                    @*dropend - delivery options*@
                    <ul class="dropdown-menu delivery-dropend-menu shadow-sm">
                        <li ng-click="deliveryShipment()" >
                            <a class="dropdown-item delivery-dropend-item" >
                                <i class="bi bi-truck me-2 h3 mb-0  "></i> 
                                <p class="mb-0">Shipments</p>
                            </a>
                        </li>
                        <li ng-click="deliveryMeetup()">
                            <a class="dropdown-item delivery-dropend-item">
                                <i class="bi bi-cash me-2 h3 mb-0"></i> 
                                <p class="mb-0">Cash through Meetup</p>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="option" id="option-reports" ng-click="inventoryReports()">
                    <a>
                        <img src="~/Content/img/icons/reports.svg" id="reports-icon" />
                        <img src="~/Content/img/icons/reports-hover.svg" id="reports-hover-icon" />
                        <p class="sidebar-text">Reports</p>
                    </a>
                </li>

                <li class="option" id="option-archive" ng-click="orderArchive()">
                    <a>
                        <img src="~/Content/img/icons/archive.svg" id="archive-icon" />
                        <img src="~/Content/img/icons/archive-hover.svg" id="archive-hover-icon" />
                        <p class="sidebar-text">Archive</p>
                    </a>
                </li>

                <li class="option" id="option-logs" ng-click="inventoryLogs()">
                    <a>
                        <img src="~/Content/img/icons/logs.svg" id="logs-icon" />
                        <img src="~/Content/img/icons/logs-hover.svg" id="logs-hover-icon" />
                        <p class="sidebar-text">Logs</p>
                    </a>
                </li>

                <li class="option" id="option-users" ng-click="inventoryUsers()">
                    <a>
                        <img src="~/Content/img/icons/users.svg" id="users-icon" />
                        <img src="~/Content/img/icons/users-hover.svg" id="users-hover-icon" />
                        <p class="sidebar-text">Users</p>
                    </a>
                </li>
            </ul>
        </div>

         @*TOP NAVBAR*@ 
        <nav class="navbar inventory-navbar">
            <div class="container-fluid d-flex justify-content-end align-items-center gap-3">

                @*<i class="bi bi-search inventory-navbar-icon"></i>*@
                <i class="bi bi-bell-fill inventory-navbar-icon"></i>

                <div class="dropdown me-3 ">
                    @*Profile Dropdown*@
                    <a class="dropdown-toggle d-flex align-items-center gap-2 "
                       data-bs-toggle="dropdown">
                        <img src="https://i.pinimg.com/736x/16/36/79/16367989d345b7570010f49fd2c86101.jpg"
                             class="inventory-profile-img" />
                        <span class="inventory-profile-name">Juan Jungkook</span>
                    </a>
                    @*Dropdown Menu *@
                    <ul class="dropdown-menu dropdown-menu-end  inventory-dropdown-menu p-0">
                        <li class="p-2 navbar-dropdown-item ps-2">
                            <img src="https://i.pinimg.com/736x/16/36/79/16367989d345b7570010f49fd2c86101.jpg" class="img-fluid inventory-profile-img" /> <span class="inventory-profile-name ms-2">Juan Jungkook</span>
                        </li>
                        <li class="p-2 navbar-dropdown-item" ng-click="logoutAlert()">
                            <span class="dropdown-logout">Logout</span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
         @*MAIN CONTENT*@ 
        <div class="">
            @RenderBody()
        </div>

         @*SCRIPTS*@ 
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/Scripts/jquery-3.7.0.min.js"></script>
        <script src="~/Scripts/angular.min.js"></script>
        <script src="~/Scripts/HolyScripts/Module.js"></script>
        <script src="~/Scripts/HolyScripts/Service.js"></script>
        <script src="~/Scripts/HolyScripts/Controller.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
        <script src="~/Scripts/Chart.min.js"></script>
        <script src="~/Scripts/angular-chart.min.js"></script>
        <script src="https://cdn.datatables.net/2.3.6/js/dataTables.js"></script>


        <script>

            //----------Dashboard Page----------
            $(document).ready(function () {
                $('#userTable').DataTable({ searching: false, paging: false, info: false });

            });

            $(document).ready(function () {
                $('#usersTable').DataTable({ searching: false, paging: false, info: false });
            });


            //----------Orders Page----------
            $(document).ready(function () {
                $('#ordersTable').DataTable();
            });

            //----------Orders Archive Page----------
            $(document).ready(function () {
                $('#orderArchiveTable').DataTable();
            });

            //----------Activity Logs Page----------
            $(document).ready(function () {
                $('#activityLogsTable').DataTable();
            });

            //---------Payment Page----------
            $(document).ready(function () {
                $('#paymentTable').DataTable();
            });

            //----------Delivery Page----------
            $(document).ready(function () {
                $('#deliveryShipmentsTable').DataTable();
            });

            $(document).ready(function () {
                $('#deliveryMeetupTable').DataTable();
            });

            //----------Reports Page----------
            $(document).ready(function () {
                $('#salesReportTable').DataTable();
            });

            //----------Inventory Page----------
            $(document).ready(function () {
                $('#inventoryTable').DataTable();
            });

        </script>
        @*tooltip*@
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
                tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                    new bootstrap.Tooltip(tooltipTriggerEl)
                })
            })
        </script>
    </body>
    </html>
