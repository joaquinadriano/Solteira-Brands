<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/css/fonts.css" />
    <link href="~/Content/css/inventory-system/inventory-header-footer.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-dashboard.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-orders.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-orderDetails.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-payment.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-delivery.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-archive.css" rel="stylesheet" />
    <link href="~/Content/css/inventory-system/inventory-inventory.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.css" />
    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/img/shared/Solteira&BrandsMainLogo.png")" />
</head>
<body ng-app="SolteiraAndBrands" ng-controller="SolteiraAndBrandsController">

    @{
        // Inventory pages: show role label instead of username.
        string roleLabel = "User";
        if (User != null && User.Identity != null)
        {
            if (User.IsInRole("ADMIN")) { roleLabel = "System Admin"; }
            else if (User.IsInRole("MANAGER")) { roleLabel = "Manager"; }
            else if (User.IsInRole("STAFF")) { roleLabel = "Staff"; }
        }
    }

    @* OPERATIONS SIDEBAR: Dashboard, Inventory, Orders, Payment, Delivery, Reports (no Archive, Logs, Users) *@
    <div id="sbAdminSidebar" class="sidebar pt-3">
        <ul class="sidebar-ul">
            <li class="option1">
                <a href="@Url.Action("AdminDashboardPage", "SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/solteira-logo.png")" class="sidebar-logo" alt="Solteira &amp; Brands" />
                </a>
            </li>
            <li class="option" id="option-dashboard">
                <a href="@Url.Action("AdminDashboardPage", "SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/icons/dashboard.svg")" id="dashboard-icon" alt="" />
                    <img src="@Url.Content("~/Content/img/icons/dashboard-hover.svg")" id="dashboard-hover-icon" alt="" />
                    <p class="sidebar-text">Dashboard</p>
                </a>
            </li>
            <li class="option" id="option-inventory">
                <a href="@Url.Action("AdminInventoryPage", "SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/icons/inventory.svg")" id="inventory-icon" alt="" />
                    <img src="@Url.Content("~/Content/img/icons/inventory-hover.svg")" id="inventory-hover-icon" alt="" />
                    <p class="sidebar-text">Inventory</p>
                </a>
            </li>
            <li class="option" id="option-orders">
                <a href="@Url.Action("AdminOrdersPage", "SolteiraAndBrands")" class="position-relative">
                    <img src="@Url.Content("~/Content/img/icons/orders.svg")" id="orders-icon" alt="" />
                    <img src="@Url.Content("~/Content/img/icons/orders-hover.svg")" id="orders-hover-icon" alt="" />
                    <p class="sidebar-text">Orders</p>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;" ng-show="pendingOrderCount > 0" ng-bind="pendingOrderCount"></span>
                </a>
            </li>
            <li class="option" id="option-payment">
                <a href="@Url.Action("AdminPaymentPage", "SolteiraAndBrands")" class="position-relative">
                    <img src="@Url.Content("~/Content/img/icons/payment.svg")" id="payment-icon" alt="" />
                    <img src="@Url.Content("~/Content/img/icons/payment-hover.svg")" id="payment-hover-icon" alt="" />
                    <p class="sidebar-text">Payment</p>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;" ng-show="pendingPaymentCount > 0" ng-bind="pendingPaymentCount"></span>
                </a>
            </li>
            <li class="option dropend" id="option-delivery">
                <a href="#" class="delivery-dropend-toggle d-flex align-items-center" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="@Url.Content("~/Content/img/icons/delivery.svg")" id="delivery-icon" alt="" />
                    <img src="@Url.Content("~/Content/img/icons/delivery-hover.svg")" id="delivery-hover-icon" alt="" />
                    <p class="sidebar-text mb-0">Delivery</p>
                </a>
                <ul class="dropdown-menu delivery-dropend-menu shadow-sm">
                    <li>
                        <a class="dropdown-item delivery-dropend-item" href="@Url.Action("AdminDeliveryShipmentsPage", "SolteiraAndBrands")">
                            <i class="bi bi-truck me-2 h3 mb-0"></i>
                            <p class="mb-0">Shipments</p>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item delivery-dropend-item" href="@Url.Action("AdminDeliveryMeetupPage", "SolteiraAndBrands")">
                            <i class="bi bi-cash me-2 h3 mb-0"></i>
                            <p class="mb-0">Cash through Meetup</p>
                        </a>
                    </li>
                </ul>
            </li>
            <li class="option" id="option-reports">
                <a href="@Url.Action("AdminReportsPage", "SolteiraAndBrands")">
                    <img src="@Url.Content("~/Content/img/icons/reports.svg")" id="reports-icon" alt="" />
                    <img src="@Url.Content("~/Content/img/icons/reports-hover.svg")" id="reports-hover-icon" alt="" />
                    <p class="sidebar-text">Reports</p>
                </a>
            </li>
        </ul>
        <span class="sidebar-version">v.4.17</span>
    </div>

    <nav class="navbar inventory-navbar">
        <div class="container-fluid d-flex justify-content-end align-items-center gap-3">
            <button type="button"
                    id="sbAdminMobileMenuButton"
                    class="sb-admin-mobile-menu-button"
                    aria-label="Open admin menu"
                    aria-controls="sbAdminSidebar"
                    aria-expanded="false">
                <span class="sb-hamburger-lines" aria-hidden="true">
                    <span></span><span></span><span></span>
                </span>
            </button>
            <a href="@Url.Action("SolteiraBrandsHome", "SolteiraAndBrands")" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1" title="Go to ordering system">
                <i class="bi bi-shop"></i> Buyer-Side
            </a>
            <div class="dropdown">
                <button type="button" class="btn btn-link p-0 border-0 d-flex align-items-center position-relative text-dark inventory-navbar-icon-link" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                    <i class="bi bi-bell-fill inventory-navbar-icon"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger inventory-notification-badge" ng-show="getNotificationCount() > 0" ng-bind="getNotificationCount()"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end inventory-notification-dropdown p-0">
                    <div class="inventory-notification-header py-2 px-3 border-bottom">Notifications</div>
                    <a ng-if="pendingOrderCount > 0" href="@Url.Action("AdminOrdersPage", "SolteiraAndBrands")" class="inventory-notification-item d-flex align-items-center gap-2 py-2 px-3 border-bottom text-decoration-none text-dark">
                        <i class="bi bi-cart-check-fill text-warning" style="font-size: 1.4rem; min-width: 32px; text-align: center;"></i>
                        <div class="inventory-notification-text flex-grow-1">
                            <span>{{pendingOrderCount}} order{{pendingOrderCount > 1 ? 's' : ''}} <span class="text-warning fw-semibold">awaiting approval</span></span>
                        </div>
                    </a>
                    <a ng-if="pendingPaymentCount > 0" href="@Url.Action("AdminPaymentPage", "SolteiraAndBrands")" class="inventory-notification-item d-flex align-items-center gap-2 py-2 px-3 border-bottom text-decoration-none text-dark">
                        <i class="bi bi-credit-card-fill text-info" style="font-size: 1.4rem; min-width: 32px; text-align: center;"></i>
                        <div class="inventory-notification-text flex-grow-1">
                            <span>{{pendingPaymentCount}} payment{{pendingPaymentCount > 1 ? 's' : ''}} <span class="text-info fw-semibold">awaiting verification</span></span>
                        </div>
                    </a>
                    <div ng-repeat="item in notificationItemsDisplay track by item.id" class="inventory-notification-item d-flex align-items-center gap-2 py-2 px-3 border-bottom">
                        <img ng-src="{{item.imageUrl || '/Content/img/shared/default-product.svg'}}" alt="" class="inventory-notification-thumb" />
                        <div class="inventory-notification-text flex-grow-1">
                            <span ng-if="isOutOfStock(item)">{{item.name}} <span class="text-out-of-stock">is out of stock</span></span>
                            <span ng-if="!isOutOfStock(item)">{{item.name}} stock level is <span class="text-low-stock">low</span></span>
                        </div>
                        <button type="button" class="btn btn-link p-0 border-0 text-secondary inventory-notification-dismiss" ng-click="dismissNotification($index); $event.stopPropagation();" title="Dismiss" aria-label="Dismiss"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div ng-if="getNotificationCount() === 0" class="py-3 px-3 text-muted small">No notifications.</div>
                </div>
            </div>
            <div class="dropdown me-3">
                <a href="#"
                   class="d-flex align-items-center"
                   id="inventoryProfileMenu"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <img id="inventoryNavProfileImg"
                         src="@Url.Content("~/Content/img/shared/default-avatar.svg")"
                         class="rounded-circle"
                         alt="Profile"
                         style="width:36px;height:36px;object-fit:cover;" />
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow custom-account-dropdown" aria-labelledby="inventoryProfileMenu">
                    <li class="px-3 py-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar-circle me-2">
                                <img id="inventoryDropProfileImg"
                                     src="@Url.Content("~/Content/img/shared/default-avatar.svg")"
                                     class="rounded-circle"
                                     alt="" />
                            </div>
                            <span class="profile-name fw-bold js-layout-profile-name">@roleLabel</span>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider fw-bold"></li>
                    <li>
                        <a href="@Url.Action("Settings","Account")" class="dropdown-item">Account Settings</a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>@Html.Partial("_LogoutForm")</li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="sbAdminMobileMenuOverlay" class="sb-admin-mobile-menu-overlay" aria-hidden="true"></div>

    <div class="">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/Chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@1"></script>
    <script>if (typeof Chart !== 'undefined' && typeof ChartDataLabels !== 'undefined') { Chart.plugins.register(ChartDataLabels); }</script>
    <script src="~/Scripts/angular-chart.min.js"></script>
    <script src="~/Scripts/HolyScripts/Module.js"></script>
    <script src="~/Scripts/HolyScripts/Service.js"></script>
    <script src="~/Scripts/HolyScripts/Controller.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.js"></script>
    <script>
        window.initializeStandardTable = function (selector, orderCol) {
            var $t = $(selector);
            if (!$t.length) return;
            try {
                if ($.fn.DataTable && $.fn.DataTable.isDataTable && $.fn.DataTable.isDataTable(selector)) {
                    $t.DataTable().destroy();
                }
            } catch (e) { }
            var col = orderCol != null ? orderCol : 0;
            $t.DataTable({
                responsive: true,
                pageLength: 10,
                lengthChange: true,
                autoWidth: false,
                order: [[col, 'desc']],
                language: {
                    search: "",
                    searchPlaceholder: "Search..."
                }
            });
        };
    </script>
    <script>
        (function () {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', '/Account/GetMyProfile', true);
            xhr.withCredentials = true;
            xhr.onreadystatechange = function () {
                if (xhr.readyState === 4 && xhr.status === 200) {
                    try {
                        var d = JSON.parse(xhr.responseText);
                        if (d.success && d.avatarUrl) {
                            var el1 = document.getElementById('inventoryNavProfileImg');
                            var el2 = document.getElementById('inventoryDropProfileImg');
                            if (el1) el1.src = d.avatarUrl;
                            if (el2) el2.src = d.avatarUrl;
                        }
                    } catch (e) { }
                }
            };
            xhr.send();
        })();
    </script>
    <script>
        $(document).ready(function () {
            if ($('#userTable').length) $('#userTable').DataTable({ searching: false, paging: false, info: false });
            // usersTable: Angular-driven (ng-repeat), do not init DataTables or rows won't show after load
            if ($('#ordersTable').length) $('#ordersTable').DataTable({ order: [[0, 'desc']] });
            // adminOrdersTable, orderArchiveTable, paymentTable, deliveryShipmentsTable, deliveryMeetupTable, inventoryTable: initialized by Angular controller via initializeStandardTable() after data loads
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) { new bootstrap.Tooltip(tooltipTriggerEl); });
        });
    </script>

    <script>
        // 15-minute inactivity auto-logout (with 1-minute warning).
        // Uses existing POST /Account/Logout form (includes anti-forgery token).
        (function () {
            var logoutForm = document.getElementById('logoutForm');
            if (!logoutForm) return;

            var TOTAL_MS = 15 * 60 * 1000;
            var WARN_AT_MS = 14 * 60 * 1000; // 1 minute before logout

            var logoutInProgress = false;
            var warningShown = false;
            var warnTimeoutId = null;
            var logoutTimeoutId = null;
            var lastResetAt = 0;
            var RESET_THROTTLE_MS = 750; // avoid excessive scheduling on mousemove

            function schedule() {
                warnTimeoutId = setTimeout(function () {
                    if (logoutInProgress) return;
                    warningShown = true;
                    try {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'warning',
                            title: 'Inactivity',
                            text: 'You will be logged out in 1 minute due to inactivity.',
                            showConfirmButton: false,
                            timer: 60000,
                            timerProgressBar: true
                        });
                    } catch (e) { }
                }, WARN_AT_MS);

                logoutTimeoutId = setTimeout(function () {
                    if (logoutInProgress) return;
                    logoutInProgress = true;
                    warningShown = false;
                    try { Swal.close(); } catch (e) { }
                    logoutForm.submit();
                }, TOTAL_MS);
            }

            function clearScheduled() {
                if (warnTimeoutId != null) clearTimeout(warnTimeoutId);
                if (logoutTimeoutId != null) clearTimeout(logoutTimeoutId);
                warnTimeoutId = null;
                logoutTimeoutId = null;
            }

            function resetTimer() {
                var now = Date.now();
                if (now - lastResetAt < RESET_THROTTLE_MS) return;
                lastResetAt = now;

                clearScheduled();

                if (warningShown) {
                    warningShown = false;
                    try { Swal.close(); } catch (e) { }
                }

                schedule();
            }

            ['mousemove', 'keydown', 'click', 'touchstart'].forEach(function (evt) {
                document.addEventListener(evt, resetTimer, { passive: true, capture: true });
            });

            schedule();
        })();
    </script>
    <script>
        // Mobile off-canvas admin sidebar toggle
        (function () {
            var btn = document.getElementById('sbAdminMobileMenuButton');
            var overlay = document.getElementById('sbAdminMobileMenuOverlay');
            if (!btn || !overlay) return;

            var isOpen = false;
            var sidebar = document.querySelector('.sidebar');

            function setOpen(next) {
                isOpen = next;
                btn.setAttribute('aria-expanded', String(isOpen));
                overlay.classList.toggle('open', isOpen);
                overlay.setAttribute('aria-hidden', String(!isOpen));
                if (isOpen) document.body.classList.add('sb-admin-sidebar-open');
                else document.body.classList.remove('sb-admin-sidebar-open');
                document.body.style.overflow = isOpen ? 'hidden' : '';
            }

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                setOpen(!isOpen);
            });

            overlay.addEventListener('click', function () {
                setOpen(false);
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });

            if (sidebar) {
                sidebar.addEventListener('click', function (e) {
                    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
                    if (!a) return;
                    var href = a.getAttribute('href') || '';
                    var hasDropdown = a.getAttribute('data-bs-toggle') === 'dropdown' || a.classList.contains('delivery-dropend-toggle');
                    if (href === '#' || hasDropdown) return;
                    setOpen(false);
                });
            }
        })();
    </script>
</body>
</html>
